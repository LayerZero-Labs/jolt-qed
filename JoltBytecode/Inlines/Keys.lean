import JoltBytecode.Inlines.Generated.Sha256
import JoltBytecode.Inlines.Generated.Sha256Init
import JoltBytecode.Inlines.Generated.Keccak256
import JoltBytecode.Inlines.Generated.Keccak256AbsorbPermute
import JoltBytecode.Inlines.Generated.Blake2

/-!
# Supported registered inlines

Generated by `scripts/expansion-parity/gen_inline_keys.py` from the expansion-parity
driver's output at a16z/jolt commit `580084fcfad4788ebf48413a92dd640ca090c45f`; do not edit by hand.

`InlineKey` lists the registered inlines that jolt-qed supports. Each key has Jolt's
encoding `(opcode, funct3, funct7)`, the generated rows of its two allocation cases
(`rd ≠ x0` and `rd = x0`), and its row count. An inline's encoded `rd` field is the
rows' `rs3`: Jolt's decoder keeps it as the normalized `rd`
(jolt/crates/jolt-program/src/image/decode.rs, `format_inline_operands`), and the expander
reads that `rd` as `rs3` (jolt/crates/jolt-program/src/expand/inline.rs,
`InlineOperands::from_source_row`), both at the pin.
`readsRd` records whether the rows read `rs3`; the generator computes it from the
generated rows.
-/

open Sail Sail.ConcurrencyInterfaceV1 Sail.ConcurrencyInterfaceV1.PreSail LeanRV64D
  LeanRV64D.Functions

set_option autoImplicit false

namespace JoltISA.Inlines

/-- A registered inline that jolt-qed supports.
Example: `InlineKey.keccak256AbsorbPermute` is Jolt's
`KECCAK256_ABSORB_PERMUTE_INLINE`, encoded with opcode `0x0B`, funct3 1, funct7 1. -/
inductive InlineKey where
  /-- `SHA256_INLINE`: funct3 0, funct7 0. -/
  | sha256
  /-- `SHA256_INIT_INLINE`: funct3 1, funct7 0. -/
  | sha256Init
  /-- `KECCAK256_INLINE`: funct3 0, funct7 1. -/
  | keccak256
  /-- `KECCAK256_ABSORB_PERMUTE_INLINE`: funct3 1, funct7 1. -/
  | keccak256AbsorbPermute
  /-- `BLAKE2_INLINE`: funct3 0, funct7 2. -/
  | blake2
  deriving DecidableEq, Repr

namespace InlineKey

/-- Every supported key, in constructor order.
Example: the first is `sha256`. -/
def all : List InlineKey :=
  [.sha256, .sha256Init, .keccak256, .keccak256AbsorbPermute, .blake2]

/-- Jolt's name for the inline.
Example: `sha256.name = "SHA256_INLINE"`. -/
def name : InlineKey → String
  | .sha256 => "SHA256_INLINE"
  | .sha256Init => "SHA256_INIT_INLINE"
  | .keccak256 => "KECCAK256_INLINE"
  | .keccak256AbsorbPermute => "KECCAK256_ABSORB_PERMUTE_INLINE"
  | .blake2 => "BLAKE2_INLINE"

/-- The major opcode; every registered inline uses `0x0B`.
Example: `blake2.opcode = 0x0B`. -/
def opcode : InlineKey → BitVec 7
  | .sha256 => 0x0b
  | .sha256Init => 0x0b
  | .keccak256 => 0x0b
  | .keccak256AbsorbPermute => 0x0b
  | .blake2 => 0x0b

/-- The `funct3` field of the encoding.
Example: `sha256Init.funct3 = 1`. -/
def funct3 : InlineKey → BitVec 3
  | .sha256 => 0
  | .sha256Init => 1
  | .keccak256 => 0
  | .keccak256AbsorbPermute => 1
  | .blake2 => 0

/-- The `funct7` field of the encoding.
Example: `keccak256.funct7 = 1`. -/
def funct7 : InlineKey → BitVec 7
  | .sha256 => 0
  | .sha256Init => 0
  | .keccak256 => 1
  | .keccak256AbsorbPermute => 1
  | .blake2 => 2

/-- Whether the key's rows read the source `rd` (the `rs3` operand).
Example: no hash inline reads it, so `sha256.readsRd = false`. -/
def readsRd : InlineKey → Bool
  | .sha256 => false
  | .sha256Init => false
  | .keccak256 => false
  | .keccak256AbsorbPermute => false
  | .blake2 => false

/-- The number of final rows of the key's expansion, in both allocation cases.
Example: `keccak256AbsorbPermute.rowCount = 3121`. -/
def rowCount : InlineKey → Nat
  | .sha256 => 1900
  | .sha256Init => 1864
  | .keccak256 => 3087
  | .keccak256AbsorbPermute => 3121
  | .blake2 => 1067

/-- The supported key with this encoding, if any.
Jolt's decoder accepts any `funct3` and `funct7` under opcodes `0x0B` and `0x2B`;
the registry lookup then rejects encodings no inline registered.
Example: `ofEncoding 0x0B 1 1 = some keccak256AbsorbPermute`, and
`ofEncoding 0x2B 1 1 = none`. -/
def ofEncoding (opcode : BitVec 7) (funct3 : BitVec 3) (funct7 : BitVec 7) :
    Option InlineKey :=
  all.find? fun key => key.opcode == opcode && key.funct3 == funct3 && key.funct7 == funct7

/-- The rows of the `rd ≠ x0` case: the generated `<name>RowsAutoList`.
`rs3` is the source `rd`.
Example: the first row of `keccak256AbsorbPermute.rows x10 x11 x12` loads `vr48` from `x10`. -/
def rows : InlineKey → regidx → regidx → regidx → List JoltISA.Instr
  | .sha256, rs1, rs2, rs3 =>
    Generated.sha256RowsAutoList rs1 rs2 rs3
  | .sha256Init, rs1, rs2, rs3 =>
    Generated.sha256InitRowsAutoList rs1 rs2 rs3
  | .keccak256, rs1, rs2, rs3 =>
    Generated.keccak256RowsAutoList rs1 rs2 rs3
  | .keccak256AbsorbPermute, rs1, rs2, rs3 =>
    Generated.keccak256AbsorbPermuteRowsAutoList rs1 rs2 rs3
  | .blake2, rs1, rs2, rs3 =>
    Generated.blake2RowsAutoList rs1 rs2 rs3

/-- The rows of the `rd = x0` case, after Rust substitutes the instruction temporary
`vr40` for `rd`: the generated `<name>RowsAutoRdZeroList`.
Example: `sha256.rowsRdZero x10 x11` has 1900 rows. -/
def rowsRdZero : InlineKey → regidx → regidx → List JoltISA.Instr
  | .sha256, rs1, rs2 => Generated.sha256RowsAutoRdZeroList rs1 rs2
  | .sha256Init, rs1, rs2 => Generated.sha256InitRowsAutoRdZeroList rs1 rs2
  | .keccak256, rs1, rs2 => Generated.keccak256RowsAutoRdZeroList rs1 rs2
  | .keccak256AbsorbPermute, rs1, rs2 => Generated.keccak256AbsorbPermuteRowsAutoRdZeroList rs1 rs2
  | .blake2, rs1, rs2 => Generated.blake2RowsAutoRdZeroList rs1 rs2

/-- The rows Jolt's expander emits for the inline call `rd, rs1, rs2` with this key.
With `rd = x0`, Rust allocates an instruction temporary and passes it as `rd`
(jolt/crates/jolt-program/src/expand/mod.rs, `expand_source_instruction_with_provider`).
The allocator is in its initial state between source instructions, so that temporary
is always `vr40`, and the `rd = x0` rows are the generated `rowsRdZero`.
Example: `sha256.expandRows x10 x11 x0 = sha256.rowsRdZero x10 x11`. -/
def expandRows (key : InlineKey) (rs1 rs2 rd : regidx) : List JoltISA.Instr :=
  if JoltISA.isX0 rd then key.rowsRdZero rs1 rs2 else key.rows rs1 rs2 rd

end InlineKey

end JoltISA.Inlines
