    keccak256_chunk20_eq, keccak256_chunk21_eq, keccak256_chunk22_eq, keccak256_chunk23_eq,
    keccak256_chunk24_eq, keccak256_chunk25_eq, keccak256_chunk26_eq, keccak256_chunk27_eq,
    keccak256_chunk28_eq, keccak256_chunk29_eq, keccak256_chunk30_eq,
    roundsRows_split]
  -- Cut the rounds on the right as the chunks cut them. `roundRows` is generalized first, so
  -- that `rw` does not unfold one round to compare it with another.
  generalize roundRows = R
  conv_rhs => rw [split2 (R 0) 75,
    split2 (R 1) 50,
    split2 (R 2) 25,
    split2 (R 3) 100,
    split2 (R 4) 75,
    split2 (R 5) 50,
    split2 (R 6) 25,
    split2 (R 7) 100,
    split2 (R 8) 75,
    split2 (R 9) 50,
    split2 (R 10) 25,
    split2 (R 11) 100,
    split2 (R 12) 75,
    split2 (R 13) 50,
    split2 (R 14) 25,
    split2 (R 15) 100,
    split2 (R 16) 75,
    split2 (R 17) 50,
    split2 (R 18) 25,
    split2 (R 19) 100,
    split2 (R 20) 75,
    split2 (R 21) 50,
    split2 (R 22) 25,
    split2 (R 23) 100]
  simp only [List.append_assoc]

