theorem keccak256RowsAutoList_eq (rs1 rs2 rs3 : regidx) :
    keccak256RowsAutoList rs1 rs2 rs3 =
      loadRows rs1 ++ roundsRows ++ storeRows rs1 ++ resetRows := by
  unfold keccak256RowsAutoList
  rw [keccak256_chunk0_eq, keccak256_chunk1_eq, keccak256_chunk2_eq, keccak256_chunk3_eq,
    keccak256_chunk4_eq, keccak256_chunk5_eq, keccak256_chunk6_eq, keccak256_chunk7_eq,
    keccak256_chunk8_eq, keccak256_chunk9_eq, keccak256_chunk10_eq, keccak256_chunk11_eq,
