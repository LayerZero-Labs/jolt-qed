import JoltBytecode.InstructionEquivalence.Instructions.LoadFamily.LB_main

set_option linter.unusedVariables false
set_option mvcgen.warning false

open Sail PreSail LeanRV64D.Functions
open Std.Do
open virtaddr MemoryAccessType mem_payload

set_option autoImplicit true

noncomputable section

namespace LBU_main

abbrev Vreg x := LB_main.Vreg x

/-- **Main program theorem for LBU.** The structured Jolt-ISA expansion
matches Sail after materializing Jolt's persistent CSR virtual registers. -/
def lbuProgramEqSailStatement (imm : BitVec 12) (rs1 rd : regidx)
    (js : SailJoltState)
    (_h : LoadProgramEqSailAssumptions imm rs1 js) : Prop :=
    System.systemProjectResult
      ((JoltISA.execProgram (JoltISA.lbuProgramAuto rd rs1 imm)).run js) =
    (execute_LOAD imm rs1 rd true 1).run js.sail

-- The address calculation, aligned dword load, and mask calculation are the
-- same as LB. Only the final extraction is unsigned: VirtualPext produces the
-- selected byte zero-extended to 64 bits.

/-- Unsigned PEXT with the generated byte-window mask extracts the selected
byte and zero-extends it to 64 bits. -/
theorem pext_byte_window
    (dval : BitVec 64) (base : BitVec 64) (imm : BitVec 12) :
    jolt_virtual_pext_value dval
        (jolt_virtual_window_mask_b_value base imm) =
      zero_extend (m := 64)
        (byte_of_dword dval
          (load_effective_address base imm &&& (7 : BitVec 64)).toNat) := by
  exact window_mask_b_pext
    (d := dval)
    (base := base)
    (imm := imm)

/-- The final instruction of the non-`x0` LBU expansion writes the unsigned
parallel-extract result to the architectural destination register. -/
theorem lbu_virtual_pext_rd_run
    (imm : BitVec 12) (rs1 rd : regidx) (js : SailJoltState)
    (h : LoadProgramEqSailAssumptions imm rs1 js) :
    let facts := h.dwordWindowFacts
    let daddr := compute_aligned_dword_base_address h.rs1_val imm
    let dval :=
      loaded_dword_at js.sail daddr facts.bytes facts.aligned.no_ovf
    let jsLoad := stateAfterVRegWrite js (Vreg 40) dval
    let maskValue := jolt_virtual_window_mask_b_value h.rs1_val imm
    let jsMask := stateAfterVRegWrite jsLoad (Vreg 41) maskValue
    let pextValue := jolt_virtual_pext_value dval maskValue
    (JoltISA.execInstr
      (.VirtualPext
        (.xreg rd) (.vreg (Vreg 40)) (.vreg (Vreg 41)))).run jsMask =
      .ok RETIRE_SUCCESS
        { jsMask with
          sail := stateAfterWrite jsMask.sail rd pextValue } := by
  apply JoltISA.virtual_pext_run_xreg_vreg_vreg
  simpa only [stateAfterVRegWrite, Vreg, LB_main.Vreg, BitVec.reduceEq,
    ↓reduceIte] using
    wX_bits_stateAfterWrite
      (rd := rd)
      (v := _)
      (s := js.sail)

/-- The final instruction of the `x0` LBU expansion writes the unsigned
parallel-extract result to virtual register 40. -/
theorem lbu_virtual_pext_v40_run
    (imm : BitVec 12) (rs1 : regidx) (js : SailJoltState)
    (h : LoadProgramEqSailAssumptions imm rs1 js) :
    let facts := h.dwordWindowFacts
    let daddr := compute_aligned_dword_base_address h.rs1_val imm
    let dval :=
      loaded_dword_at js.sail daddr facts.bytes facts.aligned.no_ovf
    let jsLoad := stateAfterVRegWrite js (Vreg 41) dval
    let maskValue := jolt_virtual_window_mask_b_value h.rs1_val imm
    let jsMask := stateAfterVRegWrite jsLoad (Vreg 42) maskValue
    let pextValue := jolt_virtual_pext_value dval maskValue
    (JoltISA.execInstr
      (.VirtualPext
        (.vreg (Vreg 40)) (.vreg (Vreg 41)) (.vreg (Vreg 42)))).run jsMask =
      .ok RETIRE_SUCCESS
        (stateAfterVRegWrite jsMask (Vreg 40) pextValue) := by
  apply JoltISA.virtual_pext_run_vreg_vreg_vreg
  simp only [WritableVReg, Vreg, LB_main.Vreg, BitVec.toNat_ofNat]
  norm_num

/-- The generated `LBU` expansion writes only instruction-local scratch
vregs. -/
theorem lbuProgramAuto_preserves_projected_vregs
    (imm : BitVec 12) (rs1 rd : regidx)
    {js js' : SailJoltState} {result : ExecutionResult}
    (hrun : (JoltISA.execProgram (JoltISA.lbuProgramAuto rd rs1 imm)).run js =
      .ok result js') :
    Projection.ProjectedVRegsPreserved js js' := by
  have hsafe : JoltISA.ProgramWritesNoProtectedVReg
      (JoltISA.lbuProgramAuto rd rs1 imm) := by
    unfold JoltISA.lbuProgramAuto
    split <;>
      simp only [JoltISA.ProgramWritesNoProtectedVReg,
        JoltISA.InstrWritesNoProtectedVReg, JoltISA.DstWritesNoProtectedVReg,
        and_true] <;>
      norm_num [JoltISA.IsProtectedJoltRegister, JoltISA.joltRegisterSlot,
        JoltISA.JoltRegisterSlot.isProtected]
  exact Projection.execProgram_preserves_projected_vregs_of_no_protected_writes
    hsafe hrun

/-- After either generated `LBU` branch runs, `systemProject` agrees with the
embedded Sail state. -/
theorem lbuProgramAuto_systemProject_eq_sail
    (imm : BitVec 12) (rs1 rd : regidx)
    (js js' : SailJoltState) (value : BitVec 64)
    (hlinked : LinkedCSRs js)
    (hrun : (JoltISA.execProgram (JoltISA.lbuProgramAuto rd rs1 imm)).run js =
      .ok RETIRE_SUCCESS js')
    (hsail : js'.sail = stateAfterWrite js.sail rd value) :
    System.systemProject js' = js'.sail := by
  have hprojected : Projection.ProjectedVRegsPreserved js js' :=
    lbuProgramAuto_preserves_projected_vregs
      (imm := imm)
      (rs1 := rs1)
      (rd := rd)
      (hrun := hrun)
  rw [Projection.systemProject_stateAfterWrite_of_projected_vregs_preserved
    (before := js)
    (after := js')
    (rd := rd)
    (value := value)
    (hsail := hsail)
    (hprojected := hprojected)]
  rw [Projection.systemProject_eq_sail_of_compatible
    (js := js)
    (h := hlinked)]
  rw [← hsail]

/-- The non-`x0` generated LBU expansion runs through its three instructions to
the explicit final state. The first three instruction facts come from LB. -/
theorem lbuProgramAuto_nonzero_run
    (imm : BitVec 12) (rs1 rd : regidx) (js : SailJoltState)
    (h : LoadProgramEqSailAssumptions imm rs1 js)
    (hx0 : JoltISA.isX0 rd ≠ true) :
    let facts := h.dwordWindowFacts
    let daddr := compute_aligned_dword_base_address h.rs1_val imm
    let dval :=
      loaded_dword_at js.sail daddr facts.bytes facts.aligned.no_ovf
    let jsLoad := stateAfterVRegWrite js (Vreg 40) dval
    let maskValue := jolt_virtual_window_mask_b_value h.rs1_val imm
    let jsMask := stateAfterVRegWrite jsLoad (Vreg 41) maskValue
    let pextValue := jolt_virtual_pext_value dval maskValue
    let jsPext :=
      { jsMask with sail := stateAfterWrite jsMask.sail rd pextValue }
    (JoltISA.execProgram (JoltISA.lbuProgramAuto rd rs1 imm)).run js =
      .ok RETIRE_SUCCESS jsPext := by
  simp only [JoltISA.lbuProgramAuto, if_neg hx0]
  change JoltISA.Program.Run
    (JoltISA.laneWindowOpen .byte (.vreg (Vreg 40)) (.vreg (Vreg 41))
      (.xreg rs1) (sign_extend (m := 64) imm) .normal (ExceptionType.E_Load_Addr_Align ())
      (JoltISA.laneWindowExtract (.vreg (Vreg 40)) (.vreg (Vreg 41)) (.xreg rd) false
        (.done RETIRE_SUCCESS))) js _
  exact LoadFamily.threeRows_run
    (LoadFamily.floorLoad_of_assumptions .byte (Vreg 40) (by unfold WritableVReg; decide) imm rs1 js h
      (by simp [LoadFamily.alignmentMask]))
    (LB_main.lb_virtual_window_mask_b_run (Vreg 40) (Vreg 41) (by unfold WritableVReg; decide) imm rs1 js h)
    (lbu_virtual_pext_rd_run imm rs1 rd js h)

/-- The non-`x0` branch of the main LBU program theorem. -/
theorem lbuProgram_eq_sail_nonzero
    (imm : BitVec 12) (rs1 rd : regidx) (js : SailJoltState)
    (h : LoadProgramEqSailAssumptions imm rs1 js)
    (hx0 : JoltISA.isX0 rd ≠ true) :
    lbuProgramEqSailStatement imm rs1 rd js h := by
  unfold lbuProgramEqSailStatement
  let facts := h.dwordWindowFacts
  let daddr := compute_aligned_dword_base_address h.rs1_val imm
  let dval := loaded_dword_at js.sail daddr facts.bytes facts.aligned.no_ovf
  let jsLoad := stateAfterVRegWrite js (Vreg 40) dval
  let maskValue := jolt_virtual_window_mask_b_value h.rs1_val imm
  let jsMask := stateAfterVRegWrite jsLoad (Vreg 41) maskValue
  let pextValue := jolt_virtual_pext_value dval maskValue
  let jsPext :=
    { jsMask with sail := stateAfterWrite jsMask.sail rd pextValue }
  have hjolt :
      (JoltISA.execProgram (JoltISA.lbuProgramAuto rd rs1 imm)).run js =
        .ok RETIRE_SUCCESS jsPext := by
    exact lbuProgramAuto_nonzero_run
      (imm := imm)
      (rs1 := rs1)
      (rd := rd)
      (js := js)
      (h := h)
      (hx0 := hx0)
  have hFinalSail :
      jsPext.sail = stateAfterWrite js.sail rd pextValue := by
    rfl
  have hProject : System.systemProject jsPext = jsPext.sail :=
    lbuProgramAuto_systemProject_eq_sail
      (imm := imm)
      (rs1 := rs1)
      (rd := rd)
      (js := js)
      (js' := jsPext)
      (value := pextValue)
      (hlinked := h.linkedCSRs)
      (hrun := hjolt)
      (hsail := hFinalSail)

  rw [hjolt]
  rw [LB_SailSide.execute_LBU_reduces
    (imm := imm)
    (rs1 := rs1)
    (rd := rd)
    (js := js)
    (h := h)]
  rw [LB_SailSide.stateAfterWrite_writeValueUnsigned_eq_dword_byte
    (imm := imm)
    (rs1 := rs1)
    (rd := rd)
    (js := js)
    (h := h)]

  -- NOTE: Math lemma
  rw [← pext_byte_window
    (dval := dval)
    (base := h.rs1_val)
    (imm := imm)]
  simp only [System.systemProjectResult]
  rw [hProject, hFinalSail]

/-- The `x0` generated LBU expansion runs through its three instructions to the
explicit final state. The first three instruction facts come from LB. -/
theorem lbuProgramAuto_x0_run
    (imm : BitVec 12) (rs1 rd : regidx) (js : SailJoltState)
    (h : LoadProgramEqSailAssumptions imm rs1 js)
    (hx0 : JoltISA.isX0 rd = true) :
    let facts := h.dwordWindowFacts
    let daddr := compute_aligned_dword_base_address h.rs1_val imm
    let dval :=
      loaded_dword_at js.sail daddr facts.bytes facts.aligned.no_ovf
    let jsLoad := stateAfterVRegWrite js (Vreg 41) dval
    let maskValue := jolt_virtual_window_mask_b_value h.rs1_val imm
    let jsMask := stateAfterVRegWrite jsLoad (Vreg 42) maskValue
    let pextValue := jolt_virtual_pext_value dval maskValue
    let jsPext := stateAfterVRegWrite jsMask (Vreg 40) pextValue
    (JoltISA.execProgram (JoltISA.lbuProgramAuto rd rs1 imm)).run js =
      .ok RETIRE_SUCCESS jsPext := by
  simp only [JoltISA.lbuProgramAuto, hx0, if_true]
  change JoltISA.Program.Run
    (JoltISA.laneWindowOpen .byte (.vreg (Vreg 41)) (.vreg (Vreg 42))
      (.xreg rs1) (sign_extend (m := 64) imm) .normal (ExceptionType.E_Load_Addr_Align ())
      (JoltISA.laneWindowExtract (.vreg (Vreg 41)) (.vreg (Vreg 42)) (.vreg (Vreg 40)) false
        (.done RETIRE_SUCCESS))) js _
  exact LoadFamily.threeRows_run
    (LoadFamily.floorLoad_of_assumptions .byte (Vreg 41) (by unfold WritableVReg; decide) imm rs1 js h
      (by simp [LoadFamily.alignmentMask]))
    (LB_main.lb_virtual_window_mask_b_run (Vreg 41) (Vreg 42) (by unfold WritableVReg; decide) imm rs1 js h)
    (lbu_virtual_pext_v40_run imm rs1 js h)

/-- The `x0` branch of the main LBU program theorem. -/
theorem lbuProgram_eq_sail_x0
    (imm : BitVec 12) (rs1 rd : regidx) (js : SailJoltState)
    (h : LoadProgramEqSailAssumptions imm rs1 js)
    (hx0 : JoltISA.isX0 rd = true) :
    lbuProgramEqSailStatement imm rs1 rd js h := by
  unfold lbuProgramEqSailStatement
  let facts := h.dwordWindowFacts
  let daddr := compute_aligned_dword_base_address h.rs1_val imm
  let dval := loaded_dword_at js.sail daddr facts.bytes facts.aligned.no_ovf
  let jsLoad := stateAfterVRegWrite js (Vreg 41) dval
  let maskValue := jolt_virtual_window_mask_b_value h.rs1_val imm
  let jsMask := stateAfterVRegWrite jsLoad (Vreg 42) maskValue
  let pextValue := jolt_virtual_pext_value dval maskValue
  let jsPext := stateAfterVRegWrite jsMask (Vreg 40) pextValue
  have hjolt :
      (JoltISA.execProgram (JoltISA.lbuProgramAuto rd rs1 imm)).run js =
        .ok RETIRE_SUCCESS jsPext := by
    exact lbuProgramAuto_x0_run
      (imm := imm)
      (rs1 := rs1)
      (rd := rd)
      (js := js)
      (h := h)
      (hx0 := hx0)
  have hFinalSail :
      jsPext.sail = stateAfterWrite js.sail rd pextValue := by
    rw [JoltISA.stateAfterWrite_of_isX0_eq_true
      (rd := rd)
      (h := hx0)
      (s := js.sail)
      (val := pextValue)]
    rfl
  have hProject : System.systemProject jsPext = jsPext.sail :=
    lbuProgramAuto_systemProject_eq_sail
      (imm := imm)
      (rs1 := rs1)
      (rd := rd)
      (js := js)
      (js' := jsPext)
      (value := pextValue)
      (hlinked := h.linkedCSRs)
      (hrun := hjolt)
      (hsail := hFinalSail)

  rw [hjolt]
  rw [LB_SailSide.execute_LBU_reduces
    (imm := imm)
    (rs1 := rs1)
    (rd := rd)
    (js := js)
    (h := h)]
  rw [LB_SailSide.stateAfterWrite_writeValueUnsigned_eq_dword_byte
    (imm := imm)
    (rs1 := rs1)
    (rd := rd)
    (js := js)
    (h := h)]

  -- NOTE: Math lemma
  rw [← pext_byte_window
    (dval := dval)
    (base := h.rs1_val)
    (imm := imm)]
  simp only [System.systemProjectResult]
  rw [hProject, hFinalSail]

/-- **Main program theorem for LBU.** The structured Jolt-ISA expansion
matches Sail after materializing Jolt's persistent CSR virtual registers. -/
theorem lbuProgram_eq_sail
    (imm : BitVec 12) (rs1 rd : regidx) (js : SailJoltState)
    (h : LoadProgramEqSailAssumptions imm rs1 js) :
    lbuProgramEqSailStatement imm rs1 rd js h := by
  by_cases hx0 : JoltISA.isX0 rd = true
  · exact lbuProgram_eq_sail_x0
      (imm := imm)
      (rs1 := rs1)
      (rd := rd)
      (js := js)
      (h := h)
      (hx0 := hx0)
  · exact lbuProgram_eq_sail_nonzero
      (imm := imm)
      (rs1 := rs1)
      (rd := rd)
      (js := js)
      (h := h)
      (hx0 := hx0)

end LBU_main
