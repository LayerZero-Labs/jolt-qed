import JoltConstraints.Soundness.Layer5.TapeTrace
import JoltConstraints.Soundness.Layer5.AdviceExpansion
import JoltConstraints.Soundness.Layer5.RuntimeAdvice
import JoltConstraints.advice_inputs
import JoltConstraints.ProgramLayout
import JoltConstraints.nextpc_frame
import JoltConstraints.expansion_facts
import JoltConstraints.Soundness.Layer7.AdjacentRows

/-! The generated bytecode has only four advice-load expansions. AdviceLB,
AdviceLH and AdviceLW run `VirtualAdviceLoad`, `VirtualMULI`, `VirtualSRAI`;
the multiply discards high answer bits before the arithmetic shift. AdviceLD
reads all eight bytes. Both destination branches, including the x0 rewrite,
have no store, branch, comparison, assert, host call or VirtualAdvice between
the load and masking rows. There is no unsigned advice-load instruction or
inline containing a VirtualAdviceLoad in `SourceInstruction.expand`.

Replay changes `adviceTape.bytes`; state agreement ignores exactly that field.
Host writes append after the rebuilt tape, and every read stays in its prefix. -/

set_option autoImplicit false

namespace JoltConstraints.Soundness

open Sail PreSail LeanRV64D.Functions JoltISA

/-- Between two non-read states, the tape cursor is fixed and bytes may only be
appended. For a tape `[0x2C]`, a host write of `0x01` gives `[0x2C, 0x01]`.
See `jolt/tracer/src/emulator/cpu.rs:24-60` at 8bbb2357. -/
private def TapeGrowth (a b : SailJoltState) : Prop :=
  a.adviceTape.readPosition = b.adviceTape.readPosition ∧
    ∃ suffix, b.adviceTape.bytes = a.adviceTape.bytes ++ suffix

private theorem tapeGrowth_refl (s : SailJoltState) : TapeGrowth s s := by
  exact ⟨rfl, #[], by simp⟩

private theorem tapeGrowth_trans (a b c : SailJoltState)
    (ab : TapeGrowth a b) (bc : TapeGrowth b c) : TapeGrowth a c := by
  obtain ⟨cursorAB, suffixAB, bytesAB⟩ := ab
  obtain ⟨cursorBC, suffixBC, bytesBC⟩ := bc
  refine ⟨cursorAB.trans cursorBC, suffixAB ++ suffixBC, ?_⟩
  rw [bytesBC, bytesAB, Array.append_assoc]

private theorem execInstr_tapeGrowth (instr : Instr)
    (notLoad : ∀ dst width, instr ≠ .VirtualAdviceLoad dst width) :
    StatePreservation.Preserves TapeGrowth (execInstr instr) := by
  apply InstructionFrame.execInstr_rule
    { refl := tapeGrowth_refl
      trans := tapeGrowth_trans
      sail := fun _ _ => ⟨rfl, #[], by simp⟩
      vreg := fun _ _ _ => ⟨rfl, #[], by simp⟩
      store := fun _ _ _ _ _ => ⟨rfl, #[], by simp⟩
      append := fun _ bytes => ⟨rfl, bytes, rfl⟩ }
  intro dst width isLoad
  exact False.elim (notLoad dst width isLoad)

/-- `width` little-endian bytes from an answer. For answer 300 and width 1,
this is `[0x2C]`: the high byte of 300 is dropped. -/
def lowAnswerBytes (answer : BitVec 64) (width : Nat) : List (BitVec 8) :=
  (List.range width).map fun offset => BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * offset))

/-- The word formed by zero-extending `lowAnswerBytes`; 300 at width 1 becomes 44. -/
def lowAnswer (answer : BitVec 64) (width : Nat) : BitVec 64 :=
  BitVec.ofNat 64 (answer.toNat % 2 ^ (8 * width))

/-- The bytes contributed by one executed row, empty unless it is a tape read.
A one-byte advice-load row answered with 300 contributes `[0x2C]`. -/
def answerBytesAt {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) : List (BitVec 8) :=
  match run.bytecode[run.rows[step].rowIndex].instruction with
  | .VirtualAdviceLoad _ width => lowAnswerBytes (run.answers step) width.toNat
  | _ => []

/-- The low 1, 2, 4 or 8 bytes of every answer, in read order. -/
def rebuiltTape {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) : Array (BitVec 8) :=
  ((List.finRange run.rows.size).flatMap (answerBytesAt run)).toArray

/-- Keep the prover's non-tape private input and replace only its tape. -/
def rebuiltInputs {joltInstance : JoltInstance SourceInstruction}
    (privateInputs : JoltPrivateInputs)
    (run : UntrustedAnswerRun joltInstance privateInputs) : JoltPrivateInputs :=
  { privateInputs with advice_tape := rebuiltTape run }

/-- Number of rebuilt tape bytes before a row. If the first read answered 300
at width 1, its offset is zero and the next read starts at offset one. -/
def rebuiltTapeOffset {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) : Nat :=
  (((List.finRange run.rows.size).take step.val).flatMap
    (answerBytesAt run)).length

private theorem withRuntimeAdvice_eq_adviceLoad_iff (instruction : Instr)
    (advice : instruction.RuntimeAdvice) (dst : Dst) (width : BitVec 64) :
    instruction.withRuntimeAdvice advice = .VirtualAdviceLoad dst width ↔
      instruction = .VirtualAdviceLoad dst width := by
  unfold Instr.withRuntimeAdvice
  split <;> simp_all

private theorem execWithTapeAnswer_load_width (dst : Dst) (width answer : BitVec 64)
    (pre post : SailJoltState)
    (runs : execWithTapeAnswer (.VirtualAdviceLoad dst width) answer pre =
      .ok (.Retire_Success ()) post) :
    width.toNat = 1 ∨ width.toNat = 2 ∨ width.toNat = 4 ∨ width.toNat = 8 := by
  by_contra invalid
  simp only [execWithTapeAnswer, if_neg invalid] at runs
  contradiction

private theorem UntrustedAnswerRun.load_width
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (step : Fin run.rows.size)
    (dst : Dst) (width : BitVec 64)
    (load : run.bytecode[run.rows[step].rowIndex].instruction = .VirtualAdviceLoad dst width) :
    width.toNat = 1 ∨ width.toNat = 2 ∨ width.toNat = 4 ∨ width.toNat = 8 := by
  have runs := run.executes step
  rw [(withRuntimeAdvice_eq_adviceLoad_iff _ _ dst width).mpr load] at runs
  exact execWithTapeAnswer_load_width dst width _ _ _ runs

private theorem UntrustedAnswerRun.postCursor_step
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) :
    run.rows[step].postState.adviceTape.readPosition =
      run.rows[step].preState.adviceTape.readPosition +
        (answerBytesAt run step).length := by
  let instruction := run.bytecode[run.rows[step].rowIndex].instruction
  let advice := run.rows[step].runtimeAdvice
  have runs := run.executes step
  by_cases isLoad : ∃ dst width, instruction = .VirtualAdviceLoad dst width
  · obtain ⟨dst, width, load⟩ := isLoad
    have patched : instruction.withRuntimeAdvice advice =
        .VirtualAdviceLoad dst width :=
      (withRuntimeAdvice_eq_adviceLoad_iff instruction advice dst width).2 load
    have valid := run.load_width step dst width load
    let moved : SailJoltState :=
      { run.rows[step].preState with adviceTape :=
        { run.rows[step].preState.adviceTape with
          readPosition := run.rows[step].preState.adviceTape.readPosition + width.toNat } }
    have virtualRun : execInstr (.VirtualAdvice dst (run.answers step)) moved =
        .ok (.Retire_Success ()) run.rows[step].postState := by
      rw [patched] at runs
      simpa only [execWithTapeAnswer, valid, ↓reduceIte, execInstr, moved] using runs
    have growth := execInstr_tapeGrowth (.VirtualAdvice dst (run.answers step))
      (by simp) moved run.rows[step].postState _ virtualRun
    have bytesLength : (answerBytesAt run step).length = width.toNat := by
      change (match instruction with
        | .VirtualAdviceLoad _ width => lowAnswerBytes (run.answers step) width.toNat
        | _ => []).length = width.toNat
      rw [load]
      simp [lowAnswerBytes]
    simpa only [TapeGrowth, moved, bytesLength] using growth.1.symm
  · have notPatched : ∀ dst width,
        instruction.withRuntimeAdvice advice ≠ .VirtualAdviceLoad dst width := by
      intro dst width h
      exact isLoad ⟨dst, width,
        (withRuntimeAdvice_eq_adviceLoad_iff instruction advice dst width).1 h⟩
    have oldRun : execInstr (instruction.withRuntimeAdvice advice)
        run.rows[step].preState = .ok (.Retire_Success ()) run.rows[step].postState := by
      simpa only [execWithTapeAnswer, instruction, advice] using runs
    have growth := execInstr_tapeGrowth (instruction.withRuntimeAdvice advice)
      notPatched run.rows[step].preState run.rows[step].postState _ oldRun
    have noBytes : answerBytesAt run step = [] := by
      unfold answerBytesAt
      split
      · rename_i dst width h
        exact False.elim (isLoad ⟨dst, width, h⟩)
      · rfl
    simpa [noBytes] using growth.1.symm

private theorem execWithTapeAnswer_bytes_extend
    (instruction : Instr) (answer : BitVec 64)
    (pre post : SailJoltState)
    (runs : execWithTapeAnswer instruction answer pre =
      .ok (.Retire_Success ()) post) :
    ∃ suffix, post.adviceTape.bytes = pre.adviceTape.bytes ++ suffix := by
  by_cases load : ∃ dst width, instruction = .VirtualAdviceLoad dst width
  · obtain ⟨dst, width, h⟩ := load
    subst instruction
    simp only [execWithTapeAnswer] at runs
    split at runs
    · have growth := execInstr_tapeGrowth (.VirtualAdvice dst answer)
        (by simp) _ _ _ runs
      exact growth.2
    · cases runs
  · have growth := execInstr_tapeGrowth instruction
      (by intro dst width h; exact load ⟨dst, width, h⟩)
        pre post _ (by
          simp only [execWithTapeAnswer] at runs
          split at runs
          · exact False.elim (load ⟨_, _, rfl⟩)
          · exact runs)
    exact growth.2

private theorem UntrustedAnswerRun.initial_bytes_prefix
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) :
    ∃ suffix,
      run.rows[step].preState.adviceTape.bytes =
        run.initialState.adviceTape.bytes ++ suffix := by
  have all : ∀ i (bound : i < run.rows.size),
      ∃ suffix, (run.rows[i]'bound).preState.adviceTape.bytes =
        run.initialState.adviceTape.bytes ++ suffix := by
    intro i
    induction i with
    | zero =>
      intro bound
      let first := run.rows[0]'bound
      have firstAt : run.rows[0]? = some first := by simp [first, bound]
      have starts := (run.starts first firstAt).2.2
      refine ⟨#[], ?_⟩
      change first.preState.adviceTape.bytes = _
      rw [starts]
      simp [advance_pc]
    | succ i ih =>
      intro bound
      have previousBound : i < run.rows.size := by omega
      let previous := run.rows[i]'previousBound
      let current := run.rows[i + 1]'bound
      have previousAt : run.rows[i]? = some previous := by
        simp [previous, previousBound]
      have currentAt : run.rows[i + 1]? = some current := by
        simp [current, bound]
      obtain ⟨earlier, preBytes⟩ := ih previousBound
      obtain ⟨added, postBytes⟩ := execWithTapeAnswer_bytes_extend
        _ (run.answers ⟨i, previousBound⟩) _ _
        (run.executes ⟨i, previousBound⟩)
      change previous.postState.adviceTape.bytes =
        previous.preState.adviceTape.bytes ++ added at postBytes
      change previous.preState.adviceTape.bytes =
        run.initialState.adviceTape.bytes ++ earlier at preBytes
      have linkedBytes : current.preState.adviceTape.bytes =
          previous.postState.adviceTape.bytes := by
        have link := run.linked i previous current previousAt currentAt
        split at link
        · simpa using congrArg (fun s : SailJoltState =>
            s.adviceTape.bytes) link.2
        · obtain ⟨address, _, _, _, nextPre⟩ := link
          rw [nextPre]
          rfl
      refine ⟨earlier ++ added, ?_⟩
      rw [linkedBytes, postBytes, preBytes, Array.append_assoc]
  exact all step.val step.isLt

private theorem rebuiltTapeOffset_succ
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (i : Nat) (bound : i + 1 < run.rows.size) :
    rebuiltTapeOffset run ⟨i + 1, bound⟩ =
      rebuiltTapeOffset run ⟨i, by omega⟩ +
        (answerBytesAt run ⟨i, by omega⟩).length := by
  unfold rebuiltTapeOffset
  have iBound : i < (List.finRange run.rows.size).length := by simp; omega
  rw [← List.take_concat_get' (List.finRange run.rows.size) i iBound]
  simp only [List.flatMap_append, List.flatMap_cons, List.flatMap_nil,
    List.length_append, List.length_nil, Nat.add_zero]
  simp

/-- The relaxed run's tape cursor counts the byte widths of preceding loads.
Host advice writes append bytes and leave the cursor unchanged. -/
private theorem UntrustedAnswerRun.preCursor_eq_rebuiltTapeOffset
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) :
    run.rows[step].preState.adviceTape.readPosition =
      rebuiltTapeOffset run step := by
  have all : ∀ i (bound : i < run.rows.size),
      (run.rows[i]'bound).preState.adviceTape.readPosition =
        rebuiltTapeOffset run ⟨i, bound⟩ := by
    intro i
    induction i with
    | zero =>
      intro bound
      let first := run.rows[0]'bound
      have firstAt : run.rows[0]? = some first := by simp [first, bound]
      obtain ⟨_, _, starts⟩ := run.starts first firstAt
      have zero := joltInstance.initial_state_adviceTape_readPosition_zero
        privateInputs run.initialState run.initialized
      change first.preState.adviceTape.readPosition = _
      rw [starts]
      simp [advance_pc, rebuiltTapeOffset, zero]
    | succ i ih =>
      intro bound
      have previousBound : i < run.rows.size := by omega
      let previous := run.rows[i]'previousBound
      let current := run.rows[i + 1]'bound
      have previousAt : run.rows[i]? = some previous := by simp [previous, previousBound]
      have currentAt : run.rows[i + 1]? = some current := by simp [current, bound]
      have link := run.linked i previous current previousAt currentAt
      have carry : current.preState.adviceTape.readPosition =
          previous.postState.adviceTape.readPosition := by
        split at link
        · simpa using congrArg (fun s : SailJoltState =>
            s.adviceTape.readPosition) link.2
        · obtain ⟨address, _, _, _, nextPre⟩ := link
          rw [nextPre]
          rfl
      calc
        current.preState.adviceTape.readPosition =
            previous.postState.adviceTape.readPosition := carry
        _ = previous.preState.adviceTape.readPosition +
              (answerBytesAt run ⟨i, previousBound⟩).length := by
            exact run.postCursor_step ⟨i, previousBound⟩
        _ = rebuiltTapeOffset run ⟨i, previousBound⟩ +
              (answerBytesAt run ⟨i, previousBound⟩).length := by rw [ih previousBound]
        _ = rebuiltTapeOffset run ⟨i + 1, bound⟩ :=
              (rebuiltTapeOffset_succ run i bound).symm
  exact all step.val step.isLt

private theorem rebuiltTape_split
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) :
    (rebuiltTape run).toList =
      ((List.finRange run.rows.size).take step.val).flatMap (answerBytesAt run) ++
      answerBytesAt run step ++
      ((List.finRange run.rows.size).drop (step.val + 1)).flatMap (answerBytesAt run) := by
  have split := List.take_append_drop step.val (List.finRange run.rows.size)
  rw [List.drop_eq_getElem_cons (by simpa using step.isLt)] at split
  have atStep : (List.finRange run.rows.size)[step.val] = step := by simp
  rw [atStep] at split
  change ((List.finRange run.rows.size).flatMap (answerBytesAt run)).toArray.toList = _
  conv_lhs => rw [← split]
  simp only [List.flatMap_append, List.flatMap_cons, List.append_assoc]

private theorem lowAnswerByte_as_shift (answer : BitVec 64) (i : Nat) :
    BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * i)) =
      (answer >>> (8 * i)).setWidth 8 := by
  apply BitVec.eq_of_toNat_eq
  simp [BitVec.toNat_setWidth, BitVec.toNat_ushiftRight,
    Nat.shiftRight_eq_div_pow]

/-- Folding at most eight little-endian answer bytes reconstructs precisely
those low bytes of the original 64-bit answer. -/
private theorem lowAnswerBytes_range_value (answer : BitVec 64) (width : Nat)
    (valid : width ≤ 8) :
    (List.range width).foldl (fun value i =>
      value ||| ((BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * i))).zeroExtend 64 <<<
        (8 * i))) (0#64) = lowAnswer answer width := by
  have core : ∀ n : Nat, n ≤ 8 →
      (List.range n).foldl (fun value i =>
        value ||| ((BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * i))).zeroExtend 64 <<<
          (8 * i))) (0#64) = (answer.setWidth (8 * n)).zeroExtend 64 := by
    intro n hn
    induction n with
    | zero =>
      apply BitVec.eq_of_toNat_eq
      norm_num [BitVec.toNat_setWidth, Nat.mod_one]
    | succ n ih =>
      rw [List.range_succ, List.foldl_append]
      simp only [List.foldl_cons, List.foldl_nil]
      rw [ih (by omega), lowAnswerByte_as_shift]
      ext i hi
      simp only [BitVec.getElem_or, BitVec.zeroExtend,
        BitVec.getElem_shiftLeft, BitVec.getElem_setWidth,
        BitVec.getLsbD_setWidth, BitVec.getLsbD_ushiftRight]
      by_cases before : i < 8 * n
      · have within : i < 8 * (n + 1) := by omega
        simp [before, within]
      · by_cases within : i < 8 * (n + 1)
        · have byte : i - 8 * n < 8 := by omega
          have idx : 8 * n + (i - 8 * n) = i := by omega
          simp [before, within, byte, idx]
        · have byte : ¬ i - 8 * n < 8 := by omega
          simp [before, within, byte]
  rw [core width valid]
  apply BitVec.eq_of_toNat_eq
  simp [lowAnswer, BitVec.toNat_setWidth]

private theorem lowAnswerBytes_fold_value (answer : BitVec 64) (width : Nat)
    (valid : width = 1 ∨ width = 2 ∨ width = 4 ∨ width = 8) :
    (List.finRange width).foldl (fun value offset =>
      value ||| ((BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * offset.val))).zeroExtend 64 <<<
        (8 * offset.val))) (0#64) = lowAnswer answer width := by
  have mapped : (List.finRange width).foldl (fun value offset =>
      value ||| ((BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * offset.val))).zeroExtend 64 <<<
        (8 * offset.val))) (0#64) =
      (List.range width).foldl (fun value i =>
        value ||| ((BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * i))).zeroExtend 64 <<<
          (8 * i))) (0#64) := by
    rw [← List.map_coe_finRange_eq_range]
    simp only [List.foldl_map]
  rw [mapped]
  exact lowAnswerBytes_range_value answer width (by rcases valid with h | h | h | h <;> omega)

/-- A read uses its own answer bytes and cannot reach host advice appended
after the rebuilt prefix. -/
theorem rebuiltTape_read_exact
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) (dst : Dst) (width : BitVec 64)
    (load : run.bytecode[run.rows[step].rowIndex].instruction =
      .VirtualAdviceLoad dst width) (hostSuffix : Array (BitVec 8)) :
    rebuiltTapeOffset run step + width.toNat ≤ (rebuiltTape run).size ∧
    readAdviceTape
      { bytes := rebuiltTape run ++ hostSuffix
        readPosition := rebuiltTapeOffset run step } width =
      some (lowAnswer (run.answers step) width.toNat,
        { bytes := rebuiltTape run ++ hostSuffix
          readPosition := rebuiltTapeOffset run step + width.toNat }) := by
  have answerEq : answerBytesAt run step =
      lowAnswerBytes (run.answers step) width.toNat := by
    have loadNat : run.bytecode[run.rows[step.val].rowIndex.val].instruction =
        .VirtualAdviceLoad dst width := by
      simpa only [Fin.getElem_fin] using load
    simp [answerBytesAt, loadNat]
  have splitLength := congrArg List.length (rebuiltTape_split run step)
  have bound : rebuiltTapeOffset run step + width.toNat ≤ (rebuiltTape run).size := by
    simp only [rebuiltTapeOffset, answerEq, lowAnswerBytes, List.length_map,
      List.length_range, List.length_append, Array.length_toList] at splitLength ⊢
    omega
  have widthValid := run.load_width step dst width load
  have byteAt (offset : Fin width.toNat) :
      (rebuiltTape run ++ hostSuffix)[rebuiltTapeOffset run step + offset.val]'(by
        have sizeLe : (rebuiltTape run).size ≤ (rebuiltTape run ++ hostSuffix).size := by simp
        omega) =
      BitVec.ofNat 8 ((run.answers step).toNat / 2 ^ (8 * offset.val)) := by
    have within : rebuiltTapeOffset run step + offset.val <
        (rebuiltTape run).size := by omega
    rw [Array.getElem_append_left within]
    change (rebuiltTape run).toList[rebuiltTapeOffset run step + offset.val] = _
    have getByte : (rebuiltTape run).toList[rebuiltTapeOffset run step + offset.val]? =
        some (BitVec.ofNat 8 ((run.answers step).toNat / 2 ^ (8 * offset.val))) := by
      rw [rebuiltTape_split run step]
      simp only [rebuiltTapeOffset, answerEq]
      rw [List.append_assoc]
      rw [List.getElem?_append_right (by omega)]
      rw [List.getElem?_append_left (by simp [lowAnswerBytes])]
      simp [lowAnswerBytes]
    rw [List.getElem?_eq_getElem within] at getByte
    exact Option.some.inj getByte
  refine ⟨bound, ?_⟩
  have boundAppend : rebuiltTapeOffset run step + width.toNat ≤
      (rebuiltTape run ++ hostSuffix).size := by
    have sizeLe : (rebuiltTape run).size ≤ (rebuiltTape run ++ hostSuffix).size := by simp
    omega
  unfold readAdviceTape
  simp only [widthValid, ↓reduceIte, boundAppend, dif_pos]
  congr 1
  · have byteFn : (fun value (offset : Fin width.toNat) =>
        value ||| (((rebuiltTape run ++ hostSuffix)[rebuiltTapeOffset run step + offset.val]'(by
          omega)).zeroExtend 64 <<< (8 * offset.val))) =
        (fun value (offset : Fin width.toNat) =>
          value ||| ((BitVec.ofNat 8 ((run.answers step).toNat /
            2 ^ (8 * offset.val))).zeroExtend 64 <<< (8 * offset.val))) := by
      funext value offset
      rw [byteAt offset]
    rw [byteFn]
    congr 1
    exact lowAnswerBytes_fold_value (run.answers step) width.toNat widthValid

/-- Shifting a 64-bit value left by the complement of its low byte width
forgets precisely the high bytes. The width must be below eight. -/
private theorem lowAnswer_shift_width (answer : BitVec 64) (width : Nat)
    (valid : width < 8) :
    answer <<< (64 - 8 * width) =
      lowAnswer answer width <<< (64 - 8 * width) := by
  have loweq : lowAnswer answer width =
      (answer.setWidth (8 * width)).zeroExtend 64 := by
    apply BitVec.eq_of_toNat_eq
    simp [lowAnswer, BitVec.toNat_setWidth]
  rw [loweq]
  ext i hi
  simp only [BitVec.getElem_shiftLeft, BitVec.zeroExtend]
  by_cases before : i < 64 - 8 * width
  · simp [before]
  · have low : i - (64 - 8 * width) < 8 * width := by omega
    simp [BitVec.getElem_setWidth, before, low]
    exact (BitVec.getLsbD_eq_getElem (x := answer)
      (i := i - (64 - 8 * width)) (by omega)).symm

/-- The states agree on cursor, registers, RAM, device and host mode; only the
tape byte array may differ (for example original `[0x2C,0x01]` versus replay
`[0x2C]` after a one-byte read answered with 300). -/
def SameExceptTapeBytes (original replay : SailJoltState) : Prop :=
  { original with adviceTape :=
    { original.adviceTape with bytes := replay.adviceTape.bytes } } = replay

/-- Write one architectural or virtual destination in a state. This lets the
replay relation account for the transient register value 300 versus 44 after
a one-byte load, while leaving all other fields fixed. -/
noncomputable def replaceDst (dst : Dst) (state : SailJoltState)
    (value : BitVec 64) : SailJoltState :=
  match dst with
  | .xreg rd => NativeDispatch.afterDst state rd value
  | .vreg vr =>
      { state with vregs := fun r => if r = vr then value else state.vregs r }

/-- Agreement modulo the tape bytes and one destination register. For the
one-byte answer 300, the unmasked original destination may be 300 while the
fixed-tape replay destination is 44. -/
def SameExceptTapeBytesAndDst (dst : Dst)
    (original replay : SailJoltState) : Prop :=
  ∃ value : BitVec 64,
    SameExceptTapeBytes (replaceDst dst original value) replay

/-- The destination can differ only after the narrow advice load, which is
also the pre-state of the immediately following multiply. The multiply itself
discards all high answer bits, so its post-state already agrees exactly. -/
def NarrowAdvicePending (bytecode : Array JoltInstructionRow)
    (rowIndex : Nat) (preState : Bool) (dst : Dst) : Prop :=
  ∃ (start : Fin bytecode.size) (width : BitVec 64),
    bytecode[start].instruction = .VirtualAdviceLoad dst width ∧
    width.toNat < 8 ∧
    (if preState then
      rowIndex = start.val + 1 ∧
        ∃ src multiplier,
          (bytecode[rowIndex]?.map (·.instruction)) =
            some (.VirtualMULI dst src multiplier)
    else
      rowIndex = start.val)

/-- At a pre-state or post-state, agreement permits only tape-byte differences
and the destination identified by `NarrowAdvicePending`. For example, the
post-state of a one-byte load may hold 300 in the relaxed run and 44 in replay. -/
def ReplayStateAgreement (bytecode : Array JoltInstructionRow)
    (rowIndex : Nat) (preState : Bool)
    (original replay : SailJoltState) : Prop :=
  (∀ dst, NarrowAdvicePending bytecode rowIndex preState dst →
    SameExceptTapeBytesAndDst dst original replay) ∧
  ((¬ ∃ dst, NarrowAdvicePending bytecode rowIndex preState dst) →
    SameExceptTapeBytes original replay)

private theorem SameExceptTapeBytes.device_eq
    {original replay : SailJoltState}
    (same : SameExceptTapeBytes original replay) :
    original.jolt_device = replay.jolt_device := by
  change { original with adviceTape :=
    { original.adviceTape with bytes := replay.adviceTape.bytes } } = replay at same
  have h := congrArg SailJoltState.jolt_device same
  exact h

private theorem SameExceptTapeBytes.sourceValue_eq
    {original replay : SailJoltState}
    (same : SameExceptTapeBytes original replay) (src : Src) :
    sourceValue src original = sourceValue src replay := by
  change { original with adviceTape :=
    { original.adviceTape with bytes := replay.adviceTape.bytes } } = replay at same
  have h := congrArg (sourceValue src) same
  exact h

/-- Replace the tape bytes and preserve every other state component.
For example, swapping `[1, 2]` for `[44]` leaves the read cursor unchanged. -/
private def swapBytes (s : SailJoltState) (b : Array (BitVec 8)) : SailJoltState :=
  {s with adviceTape := {s.adviceTape with bytes := b}}

/-- Replace the tape bytes in either an execution success or an error.
For example, an error retains its message and cursor while its tape becomes `[44]`. -/
private def swapResult {α : Type} (b : Array (BitVec 8)) :
    EStateM.Result (Error exception) SailJoltState α →
      EStateM.Result (Error exception) SailJoltState α
  | .ok a s => .ok a (swapBytes s b)
  | .error e s => .error e (swapBytes s b)

/-- An action commutes with replacing its state's tape bytes.
For example, reading a register gives the same value with tape `[44]` or `[1, 2]`. -/
private def SwapInvariant {α : Type} (m : JoltMonad α) : Prop :=
  ∀ s b, m (swapBytes s b) = swapResult b (m s)

private theorem swap_bind {α β : Type} {m : JoltMonad α} {f : α → JoltMonad β}
    (hm : SwapInvariant m) (hf : ∀ x, SwapInvariant (f x)) :
    SwapInvariant (m >>= f) := by
  intro s b
  have hm' := hm s b
  cases h : m s with
  | error e t =>
    rw [h] at hm'
    simp only [bind, EStateM.bind, hm', h, swapResult]
  | ok x t =>
    rw [h] at hm'
    simp only [bind, EStateM.bind, hm', h, swapResult]
    exact hf x t b

private theorem swap_pure {α : Type} (x : α) :
    SwapInvariant (pure x : JoltMonad α) := by
  intro s b
  rfl

private theorem swap_throw {α : Type} (e : Error exception) :
    SwapInvariant (throw e : JoltMonad α) := by
  intro s b
  rfl

private theorem swap_lift {α : Type} (m : SailM α) :
    SwapInvariant (liftSail m) := by
  intro s b
  unfold liftSail
  cases h : m s.sail <;> simp [swapResult, swapBytes, h]

private theorem swap_read (src : Src) : SwapInvariant (readSrc src) := by
  cases src with
  | xreg rs => exact swap_lift _
  | vreg vr =>
    intro s b
    rfl

private theorem swap_write (dst : Dst) (value : BitVec 64) :
    SwapInvariant (writeDst dst value) := by
  cases dst with
  | xreg rd => exact swap_lift _
  | vreg vr =>
    intro s b
    simp only [writeDst, writeVReg]
    split <;> rfl

private theorem swap_load (address : BitVec 64) :
    SwapInvariant (Mmu.load address) := by
  intro s b
  unfold Mmu.load
  simp only [Mmu.load?, Mmu.load_raw?, swapBytes, swapResult]
  split <;> rfl

private theorem swap_load_doubleword (address : BitVec 64) :
    SwapInvariant (Mmu.load_doubleword address) := by
  intro s b
  have raw : Mmu.load_raw? (swapBytes s b) = Mmu.load_raw? s := rfl
  have dev : (swapBytes s b).jolt_device = s.jolt_device := rfl
  unfold Mmu.load_doubleword
  simp only [raw, dev]
  split_ifs <;> simp [swapResult, swapBytes]
  cases read_doubleword? (Mmu.load_raw? s) address.toNat <;> rfl

private theorem swap_store_raw (s : SailJoltState) (b : Array (BitVec 8))
    (ea : Nat) (v : BitVec 8) :
    Mmu.store_raw? (swapBytes s b) ea v =
      (Mmu.store_raw? s ea v).map (swapBytes · b) := by
  simp [Mmu.store_raw?, swapBytes]
  split_ifs <;> simp
  congr 1

private theorem swap_store_fold (b : Array (BitVec 8)) (ea : Nat)
    (value : BitVec 64) (l : List Nat) (start : Option SailJoltState) :
    l.foldl (fun current k => current.bind fun s =>
      Mmu.store_raw? s (ea + k) (value.extractLsb' (8 * k) 8))
        (start.map (swapBytes · b)) =
    (l.foldl (fun current k => current.bind fun s =>
      Mmu.store_raw? s (ea + k) (value.extractLsb' (8 * k) 8)) start).map
        (swapBytes · b) := by
  induction l generalizing start with
  | nil => rfl
  | cons k rest ih =>
    simp only [List.foldl_cons]
    cases start with
    | none => simpa using ih none
    | some s =>
      simp only [Option.map_some, Option.bind_some]
      rw [swap_store_raw]
      simpa only [Option.map_eq_map] using ih (Mmu.store_raw? s (ea + k)
        (value.extractLsb' (8 * k) 8))

private theorem swap_store_doubleword (address value : BitVec 64) :
    SwapInvariant (Mmu.store_doubleword address value) := by
  intro s b
  have dev : (swapBytes s b).jolt_device = s.jolt_device := rfl
  have stored :
      (List.range 8).foldl (fun current k => current.bind fun state =>
        Mmu.store_raw? state (address.toNat + k) (value.extractLsb' (8 * k) 8))
        (some (swapBytes s b)) =
      ((List.range 8).foldl (fun current k => current.bind fun state =>
        Mmu.store_raw? state (address.toNat + k) (value.extractLsb' (8 * k) 8))
        (some s)).map (swapBytes · b) := by
    simpa using swap_store_fold b address.toNat value (List.range 8) (some s)
  unfold Mmu.store_doubleword
  simp only [dev, stored]
  split_ifs <;> simp [swapBytes, swapResult]
  cases (List.range 8).foldl (fun current k => current.bind fun state =>
    Mmu.store_raw? state (address.toNat + k) (value.extractLsb' (8 * k) 8))
    (some s) <;> rfl

private theorem swap_execInstr_nonhost (instr : Instr)
    (notLoad : ∀ dst width, instr ≠ .VirtualAdviceLoad dst width)
    (notHost : ∀ dst src imm, instr ≠ .VirtualHostIO dst src imm) :
    SwapInvariant (execInstr instr) := by
  cases instr
  case VirtualAdviceLoad dst width => exact False.elim (notLoad dst width rfl)
  case VirtualHostIO dst src imm => exact False.elim (notHost dst src imm rfl)
  all_goals simp only [execInstr]
  all_goals preservation_auto [swap_read _, swap_write _ _, swap_pure _,
    swap_throw _, swap_lift _, swap_load_doubleword _, swap_store_doubleword _ _]
    using swap_bind

private theorem swap_readHostBytes
    (overflow increment : Bool) {width : Nat}
    (pointer : BitVec width) (count : Nat) (bytes : Array (BitVec 8)) :
    SwapInvariant (readHostBytes Mmu.load overflow increment pointer count bytes) := by
  induction count generalizing pointer bytes with
  | zero => exact swap_pure _
  | succ count ih =>
    dsimp only [readHostBytes]
    refine swap_bind (swap_load _) (fun result => ?_)
    cases result with
    | Err e => exact swap_pure _
    | Ok byte =>
      split_ifs
      · exact swap_bind (swap_throw _) (fun _ => ih _ _)
      · exact swap_bind (swap_pure _) (fun _ => ih _ _)

/-- A successful action appends the same suffix after any replacement tape.
For example, a host write of `[1]` extends replacement `[44]` to `[44, 1]`. -/
private def SwapAppend {α : Type} (m : JoltMonad α) : Prop :=
  ∀ s b v t, m s = .ok v t →
    ∃ suffix,
      m (swapBytes s b) = .ok v (swapBytes t (b ++ suffix)) ∧
      t.adviceTape.bytes = s.adviceTape.bytes ++ suffix

private theorem swapInvariant_to_append {α : Type} {m : JoltMonad α}
    (inv : SwapInvariant m) : SwapAppend m := by
  intro s b v t runs
  have self : swapBytes s s.adviceTape.bytes = s := by
    cases s
    rfl
  have hself := inv s s.adviceTape.bytes
  rw [self, runs] at hself
  have bytes : t.adviceTape.bytes = s.adviceTape.bytes := by
    have stateEq : t = swapBytes t s.adviceTape.bytes := by
      exact (EStateM.Result.ok.inj hself).2
    simpa [swapBytes] using
      congrArg (fun state : SailJoltState => state.adviceTape.bytes) stateEq
  refine ⟨#[], ?_, by simpa using bytes⟩
  simpa [runs] using inv s b

private theorem swapAppend_bind {α β : Type} {m : JoltMonad α}
    {f : α → JoltMonad β} (hm : SwapAppend m)
    (hf : ∀ x, SwapAppend (f x)) : SwapAppend (m >>= f) := by
  intro s b v t runs
  cases first : m s with
  | error e middle =>
    simp only [bind, EStateM.bind, first] at runs
    cases runs
  | ok x middle =>
    have next : f x middle = .ok v t := by
      simpa only [bind, EStateM.bind, first] using runs
    obtain ⟨suffixFirst, replayFirst, bytesFirst⟩ := hm s b x middle first
    obtain ⟨suffixNext, replayNext, bytesNext⟩ :=
      hf x middle (b ++ suffixFirst) v t next
    refine ⟨suffixFirst ++ suffixNext, ?_, ?_⟩
    · simp only [bind, EStateM.bind, replayFirst, replayNext,
        Array.append_assoc]
    · rw [bytesNext, bytesFirst, Array.append_assoc]

private theorem swapAppend_append (bytes : Array (BitVec 8)) :
    SwapAppend (modify fun state =>
      { state with adviceTape :=
        { state.adviceTape with bytes := state.adviceTape.bytes ++ bytes } }) := by
  intro s b v t runs
  cases runs
  refine ⟨bytes, ?_, rfl⟩
  simp [modify, modifyGet, MonadStateOf.modifyGet, EStateM.modifyGet,
    swapBytes]

private theorem swapAppend_getHostIO {α : Type} (next : SailJoltState → JoltMonad α)
    (same : ∀ s b, next (swapBytes s b) = next s)
    (hnext : ∀ s, SwapAppend (next s)) :
    SwapAppend (get >>= next) := by
  intro s b v t runs
  simpa [bind, EStateM.bind, get, getThe, MonadStateOf.get,
    EStateM.get, same s b] using hnext s s b v t runs

private theorem swap_execHostIO : SwapAppend execHostIO := by
  unfold execHostIO execHostIOWith
  refine swapAppend_getHostIO _ (by intro s b; rfl) (fun config => ?_)
  dsimp only
  split
  · exact swapInvariant_to_append (swap_pure _)
  · refine swapAppend_bind (swapInvariant_to_append (swap_pure _)) (fun _ => ?_)
    refine swapAppend_bind (swapInvariant_to_append (swap_read _)) (fun callId => ?_)
    preservation_auto [swapInvariant_to_append (swap_read _),
      swapInvariant_to_append (swap_readHostBytes _ _ _ _ _),
      swapInvariant_to_append (swap_pure _), swapInvariant_to_append (swap_throw _),
      swapAppend_append _] using swapAppend_bind

private theorem swap_execInstr_nonload (instruction : Instr)
    (notLoad : ∀ dst width, instruction ≠ .VirtualAdviceLoad dst width) :
    SwapAppend (execInstr instruction) := by
  by_cases host : ∃ dst src imm, instruction = .VirtualHostIO dst src imm
  · obtain ⟨dst, src, imm, h⟩ := host
    subst instruction
    simpa only [execInstr] using swap_execHostIO
  · exact swapInvariant_to_append (swap_execInstr_nonhost instruction notLoad
      (by intro dst src imm h; exact host ⟨dst, src, imm, h⟩))

private theorem replaceDst_device_eq (dst : Dst) (state : SailJoltState)
    (value : BitVec 64) :
    (replaceDst dst state value).jolt_device = state.jolt_device := by
  cases dst with
  | vreg vr => rfl
  | xreg rd =>
      simp only [replaceDst, NativeDispatch.afterDst]
      split <;> rfl

private theorem ReplayStateAgreement.device_eq
    {bytecode : Array JoltInstructionRow} {rowIndex : Nat}
    {preState : Bool} {original replay : SailJoltState}
    (same : ReplayStateAgreement bytecode rowIndex preState original replay) :
    original.jolt_device = replay.jolt_device := by
  by_cases pending : ∃ dst, NarrowAdvicePending bytecode rowIndex preState dst
  · obtain ⟨dst, occurs⟩ := pending
    obtain ⟨value, sameDst⟩ := same.1 dst occurs
    calc
      original.jolt_device = (replaceDst dst original value).jolt_device :=
        (replaceDst_device_eq dst original value).symm
      _ = replay.jolt_device := sameDst.device_eq
  · exact (same.2 pending).device_eq

private theorem ReplayStateAgreement.pre_same_of_ne_muli
    {bytecode : Array JoltInstructionRow} {rowIndex : Nat}
    {original replay : SailJoltState}
    (same : ReplayStateAgreement bytecode rowIndex true original replay)
    (instruction : Instr)
    (slot : (bytecode[rowIndex]?.map (·.instruction)) = some instruction)
    (notMuli : ∀ dst src multiplier,
      instruction ≠ .VirtualMULI dst src multiplier) :
    SameExceptTapeBytes original replay := by
  apply same.2
  rintro ⟨dst, start, width, _, _, pending⟩
  obtain ⟨_, src, multiplier, isMuli⟩ := pending
  rw [slot] at isMuli
  have : instruction = .VirtualMULI dst src multiplier := Option.some.inj isMuli
  exact notMuli dst src multiplier this

/-- Row indices, recorded runtime advice and nextPC are identical. Registers,
RAM and device agree at every row except the pending narrow-load destination.
For example, a one-byte answer of 300 may replay as 44 until the multiply. -/
structure RebuildAgreement
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerRun joltInstance privateInputs)
    (replay : ValidRun joltInstance (rebuiltInputs privateInputs original)) : Prop where
  bytecode : replay.bytecode = original.bytecode
  length : replay.rows.size = original.rows.size
  initial : SameExceptTapeBytes original.initialState replay.initialState
  rows : ∀ (i : Nat) (old : TraceRow original.bytecode)
      (new : TraceRow replay.bytecode),
    original.rows[i]? = some old → replay.rows[i]? = some new →
      old.rowIndex.val = new.rowIndex.val ∧
      old.someTracerAdvice? = new.someTracerAdvice? ∧
      old.postState.sail.regs.get? Register.nextPC =
        new.postState.sail.regs.get? Register.nextPC ∧
      ReplayStateAgreement original.bytecode old.rowIndex.val true
        old.preState new.preState ∧
      ReplayStateAgreement original.bytecode old.rowIndex.val false
        old.postState new.postState
  sourceStartPre : ∀ (i : Nat) (old : TraceRow original.bytecode)
      (new : TraceRow replay.bytecode),
    original.rows[i]? = some old → replay.rows[i]? = some new →
    original.bytecode[old.rowIndex].starts_source →
    SameExceptTapeBytes old.preState new.preState

private theorem stableStall_iff_of_slot_nextPC
    {oldBytecode newBytecode : Array JoltInstructionRow}
    (old : TraceRow oldBytecode) (new : TraceRow newBytecode)
    (slot : oldBytecode[old.rowIndex] = newBytecode[new.rowIndex])
    (nextPC : old.postState.sail.regs.get? Register.nextPC =
      new.postState.sail.regs.get? Register.nextPC) :
    old.StableStall ↔ new.StableStall := by
  simp only [TraceRow.StableStall, slot, nextPC]

private theorem RebuildAgreement.slot_eq
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay)
    (old : TraceRow original.bytecode) (new : TraceRow replay.bytecode)
    (sameIndex : old.rowIndex.val = new.rowIndex.val) :
    original.bytecode[old.rowIndex] = replay.bytecode[new.rowIndex] := by
  have slots := congrArg
    (fun bc : Array JoltInstructionRow => bc[old.rowIndex.val]?)
    agreement.bytecode.symm
  change original.bytecode[old.rowIndex.val]? =
    replay.bytecode[old.rowIndex.val]? at slots
  have oldSlot : original.bytecode[old.rowIndex.val]? =
      some original.bytecode[old.rowIndex] := by simp
  have newSlot : replay.bytecode[old.rowIndex.val]? =
      some replay.bytecode[new.rowIndex] := by
    rw [sameIndex]
    simp
  rw [oldSlot, newSlot] at slots
  exact Option.some.inj slots

/-- The bytes appended after the initial private tape.
For example, initial `[2, 3]` and current `[2, 3, 9]` give host suffix `[9]`. -/
private def tapeHostSuffix (baseBytes : Array (BitVec 8))
    (state : SailJoltState) : Array (BitVec 8) :=
  (state.adviceTape.bytes.toList.drop baseBytes.size).toArray

/-- Replace the initial private tape while retaining the appended host suffix.
For example, replacing initial `[2, 3]` with `[44]` sends `[2, 3, 9]` to `[44, 9]`. -/
private def rebaseTapeState (baseBytes replacement : Array (BitVec 8))
    (state : SailJoltState) : SailJoltState :=
  swapBytes state (replacement ++ tapeHostSuffix baseBytes state)

private theorem tapeHostSuffix_of_append (baseBytes suffix : Array (BitVec 8))
    (state : SailJoltState)
    (bytes : state.adviceTape.bytes = baseBytes ++ suffix) :
    tapeHostSuffix baseBytes state = suffix := by
  simp [tapeHostSuffix, bytes, Array.toList_append]

private theorem rebaseTapeState_same (baseBytes replacement : Array (BitVec 8))
    (state : SailJoltState) :
    SameExceptTapeBytes state (rebaseTapeState baseBytes replacement state) := by
  rfl

private theorem rebaseTapeState_advance_pc (baseBytes replacement : Array (BitVec 8))
    (address : BitVec 64) (compressed : Bool) (state : SailJoltState) :
    rebaseTapeState baseBytes replacement (advance_pc address compressed state) =
      advance_pc address compressed (rebaseTapeState baseBytes replacement state) := by
  rfl

/-- The destination and byte width of a narrow load at bytecode index `k`.
For example, AdviceLB's load returns `some (dst, 1)`; AdviceLD's returns `none`. -/
private def narrowLoadAt? (bytecode : Array JoltInstructionRow) (k : Nat) : Option (Dst × Nat) :=
  match (bytecode[k]?).map (fun row : JoltInstructionRow => row.instruction) with
  | some (.VirtualAdviceLoad dst width) => if width.toNat < 8 then some (dst, width.toNat) else none
  | _ => none

/-- The preceding narrow load, whose destination still needs masking at row `k`.
For example, the multiply after AdviceLB has a pending one-byte load. -/
private def pendingBefore? (bytecode : Array JoltInstructionRow) (k : Nat) : Option (Dst × Nat) :=
  if k = 0 then none else narrowLoadAt? bytecode (k - 1)

/-- Read the register named by a destination; for example, `.vreg 40` reads temporary 40. -/
private def dstSource : Dst → Src
  | .xreg r => .xreg r
  | .vreg v => .vreg v

/-- Rebase a relaxed state onto the rebuilt tape and truncate a pending read's
destination. A pending one-byte answer of 300 becomes 44 in the replay state. -/
private noncomputable def replayState
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (pending : Option (Dst × Nat)) (state : SailJoltState) : SailJoltState :=
  let rebased := rebaseTapeState run.initialState.adviceTape.bytes (rebuiltTape run) state
  match pending with
  | none => rebased
  | some (dst, width) =>
      replaceDst dst rebased (lowAnswer (sourceValue (dstSource dst) state) width)

/-- Replay one row with the same bytecode index and recorded advice.
After a one-byte load answered with 300, its replay post-state contains 44. -/
private noncomputable def replayRow
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) : TraceRow run.bytecode :=
  { run.rows[step] with
    preState := replayState run (pendingBefore? run.bytecode run.rows[step].rowIndex.val)
      run.rows[step].preState
    postState := replayState run (narrowLoadAt? run.bytecode run.rows[step].rowIndex.val)
      run.rows[step].postState }

section AdvicePairs

open ExpansionFacts

private theorem regidx_eq_of_beq (first second : regidx) (same : (first == second) = true) :
    first = second := by
  cases first
  cases second
  simpa only [BEq.beq, instBEqRegidx.beq, decide_eq_true_eq, regidx.Regidx.injEq] using same

private theorem advicePairsOk_head (dst : Dst) (width : BitVec 64)
    (rest : List Instr) (ok : advicePairsOk (.VirtualAdviceLoad dst width :: rest) = true)
    (narrow : width.toNat < 8) :
    ∃ rd tail, dst = sideEffectingRdZeroDst rd ∧
      rest = .VirtualMULI (sideEffectingRdZeroDst rd) (adviceReadSource rd)
        (slliMultiplier (BitVec.ofNat 6 (64 - 8 * width.toNat))) :: tail := by
  simp only [advicePairsOk, if_pos narrow, Bool.and_eq_true] at ok
  have checked := ok.1
  split at checked
  · rename_i nextDst src multiplier tail
    simp only [Bool.and_eq_true] at checked
    obtain ⟨registers, multiplierEq⟩ := checked
    simp only [beq_iff_eq] at multiplierEq
    subst multiplier
    split at registers
    · rename_i rd nextRd rs
      simp only [Bool.and_eq_true, Bool.not_eq_eq_eq_not, Bool.not_true]
        at registers
      obtain ⟨⟨notZero, nextEq⟩, sourceEq⟩ := registers
      have nextEq := regidx_eq_of_beq nextRd rd nextEq
      have sourceEq := regidx_eq_of_beq rs rd sourceEq
      subst nextRd rs
      exact ⟨rd, tail, by simp [sideEffectingRdZeroDst, notZero],
        by simp [sideEffectingRdZeroDst, adviceReadSource, notZero]⟩
    · rename_i rd nextRd rs
      simp only [Bool.and_eq_true, beq_iff_eq] at registers
      obtain ⟨⟨registerEq, nextEq⟩, sourceEq⟩ := registers
      subst rd nextRd rs
      exact ⟨.Regidx 0, tail, rfl, rfl⟩
    · cases registers
  · cases checked

private theorem advicePairsOk_narrow (instructions : List Instr)
    (ok : advicePairsOk instructions = true) (k : Nat) (bound : k < instructions.length)
    (dst : Dst) (width : BitVec 64) (load : instructions[k] = .VirtualAdviceLoad dst width)
    (narrow : width.toNat < 8) :
    ∃ next : k + 1 < instructions.length, ∃ rd, dst = sideEffectingRdZeroDst rd ∧
      instructions[k + 1] = .VirtualMULI (sideEffectingRdZeroDst rd) (adviceReadSource rd)
        (slliMultiplier (BitVec.ofNat 6 (64 - 8 * width.toNat))) := by
  induction instructions generalizing k with
  | nil => simp at bound
  | cons first rest ih =>
    cases k with
    | zero =>
      simp only [List.getElem_cons_zero] at load
      subst first
      obtain ⟨rd, tail, destination, rfl⟩ := advicePairsOk_head dst width rest ok narrow
      exact ⟨by simp, rd, destination, rfl⟩
    | succ k =>
      simp only [advicePairsOk, Bool.and_eq_true] at ok
      obtain ⟨next, rd, destination, multiply⟩ := ih ok.2 k
        (by simpa only [List.length_cons, Nat.succ_lt_succ_iff] using bound) load
      exact ⟨by simpa only [List.length_cons, Nat.succ_lt_succ_iff] using next,
        rd, destination, multiply⟩

/-- A narrow tape load continues its source expansion and is followed by the
multiply discarding its high bytes. AdviceLB uses `VirtualMULI rd rd 2^56`.
See `jolt/crates/jolt-program/src/expand/memory/advice_lb.rs:3-11` at 8bbb2357. -/
private theorem narrow_load_shape (image : Rv64ProgramImage SourceInstruction)
    (bytecode : Array JoltInstructionRow) (expanded : expand_program image = some bytecode)
    (k : Nat) (inRange : k < bytecode.size) (dst : Dst) (width : BitVec 64)
    (load : bytecode[k].instruction = .VirtualAdviceLoad dst width) (narrow : width.toNat < 8) :
    ∃ rd, dst = sideEffectingRdZeroDst rd ∧ bytecode[k].continues = true ∧
      ∃ next : k + 1 < bytecode.size,
        bytecode[k + 1].instruction = .VirtualMULI (sideEffectingRdZeroDst rd)
          (adviceReadSource rd) (slliMultiplier (BitVec.ofNat 6 (64 - 8 * width.toNat))) := by
  have pairs := AdjacentRows.expand_program_pairs
    (fun instructions => advicePairsOk instructions = true)
    (fun instruction => instruction = .VirtualAdviceLoad dst width)
    (fun _ next => ∃ rd, dst = sideEffectingRdZeroDst rd ∧
      next = .VirtualMULI (sideEffectingRdZeroDst rd) (adviceReadSource rd)
        (slliMultiplier (BitVec.ofNat 6 (64 - 8 * width.toNat)))) 0
    (by
      intro instructions ok j bound load
      obtain ⟨next, rd, destination, multiply⟩ :=
        advicePairsOk_narrow instructions ok j bound dst width load narrow
      exact ⟨j, next, rfl, rd, destination, multiply⟩)
    (expand_instruction_property _ nativeRowOk_advicePairsOk sequenceOk_advicePairsOk)
    image bytecode expanded
  obtain ⟨j, next, position, ⟨rd, destination, multiply⟩, continues, _⟩ :=
    pairs k (by simpa using inRange) (by simpa using load)
  have index : k = j := by simpa using position
  subst j
  exact ⟨rd, destination, by simpa using continues, by simpa using next,
    by simpa using multiply⟩

end AdvicePairs

private theorem narrowLoadAt?_eq_some (bytecode : Array JoltInstructionRow)
    (k : Nat) (dst : Dst) (w : Nat) :
    narrowLoadAt? bytecode k = some (dst, w) ↔
      ∃ (inRange : k < bytecode.size) (width : BitVec 64),
        bytecode[k].instruction = .VirtualAdviceLoad dst width ∧
        width.toNat < 8 ∧ w = width.toNat := by
  by_cases bound : k < bytecode.size
  · simp only [narrowLoadAt?, Array.getElem?_eq_getElem bound, Option.map_some]
    split
    · rename_i destination width load
      have loadEq := Option.some.inj load
      by_cases narrow : width.toNat < 8
      · simp only [if_pos narrow, Option.some.injEq, Prod.mk.injEq]
        constructor
        · rintro ⟨rfl, rfl⟩
          exact ⟨bound, width, loadEq, narrow, rfl⟩
        · rintro ⟨_, width', load', _, rfl⟩
          rw [loadEq] at load'
          cases load'
          exact ⟨rfl, rfl⟩
      · simp only [if_neg narrow, reduceCtorEq, false_iff]
        rintro ⟨_, width', load', narrow', _⟩
        rw [loadEq] at load'
        cases load'
        exact narrow narrow'
    · rename_i noLoad
      simp only [reduceCtorEq, false_iff]
      rintro ⟨_, width, load, _, _⟩
      exact noLoad dst width (congrArg some load)
  · simp [narrowLoadAt?, bound]

private theorem narrow_load_next_not_start (image : Rv64ProgramImage SourceInstruction)
    (bytecode : Array JoltInstructionRow) (expanded : expand_program image = some bytecode)
    (k : Nat) (bound : k < bytecode.size) (dst : Dst) (width : BitVec 64)
    (load : bytecode[k].instruction = .VirtualAdviceLoad dst width) (narrow : width.toNat < 8) :
    ∃ next : k + 1 < bytecode.size, bytecode[k + 1].starts_source = false := by
  obtain ⟨rd, _, continues, next, _⟩ :=
    narrow_load_shape image bytecode expanded k bound dst width load narrow
  obtain ⟨_, remaining, notFirst, _⟩ :=
    (expand_program_layout image bytecode expanded).next ⟨k, bound⟩ ⟨k + 1, next⟩ rfl continues
  simp only [Fin.getElem_fin] at remaining notFirst
  exact ⟨next, by simp only [JoltInstructionRow.starts_source, remaining, notFirst]; rfl⟩

private theorem pendingBefore?_shape (image : Rv64ProgramImage SourceInstruction)
    (bytecode : Array JoltInstructionRow) (expanded : expand_program image = some bytecode)
    (k : Nat) (bound : k < bytecode.size) (dst : Dst) (w : Nat)
    (pending : pendingBefore? bytecode k = some (dst, w)) :
    ∃ rd, dst = sideEffectingRdZeroDst rd ∧ w < 8 ∧ bytecode[k].starts_source = false ∧
      bytecode[k].instruction = .VirtualMULI (sideEffectingRdZeroDst rd)
        (adviceReadSource rd) (slliMultiplier (BitVec.ofNat 6 (64 - 8 * w))) := by
  have nonzero : k ≠ 0 := by intro zero; simp [pendingBefore?, zero] at pending
  rw [pendingBefore?, if_neg nonzero] at pending
  obtain ⟨previous, width, load, narrow, equalWidth⟩ := (narrowLoadAt?_eq_some _ _ _ _).mp pending
  obtain ⟨rd, dstEq, _, _, multiply⟩ :=
    narrow_load_shape image bytecode expanded (k - 1) previous dst width load narrow
  have next : k - 1 + 1 = k := by omega
  obtain ⟨_, notStart⟩ :=
    narrow_load_next_not_start image bytecode expanded (k - 1) previous dst width load narrow
  refine ⟨rd, dstEq, by omega, ?_, ?_⟩
  · simpa only [next] using notStart
  · simpa only [next, equalWidth] using multiply

private theorem pendingBefore?_none_of_start (image : Rv64ProgramImage SourceInstruction)
    (bytecode : Array JoltInstructionRow) (expanded : expand_program image = some bytecode)
    (k : Nat) (bound : k < bytecode.size) (starts : bytecode[k].starts_source) :
    pendingBefore? bytecode k = none := by
  cases pending : pendingBefore? bytecode k with
  | none => rfl
  | some pair =>
    obtain ⟨_, _, _, notStart, _⟩ := pendingBefore?_shape image bytecode expanded k bound pair.1 pair.2 pending
    simp only [starts] at notStart
    contradiction

private theorem pendingBefore?_none_of_load (image : Rv64ProgramImage SourceInstruction)
    (bytecode : Array JoltInstructionRow) (expanded : expand_program image = some bytecode)
    (k : Nat) (bound : k < bytecode.size) (dst : Dst) (width : BitVec 64)
    (load : bytecode[k].instruction = .VirtualAdviceLoad dst width) :
    pendingBefore? bytecode k = none := by
  cases pending : pendingBefore? bytecode k with
  | none => rfl
  | some pair =>
    obtain ⟨_, _, _, _, multiply⟩ := pendingBefore?_shape image bytecode expanded k bound pair.1 pair.2 pending
    rw [load] at multiply
    contradiction

private theorem narrowAdvicePending_post_iff (bytecode : Array JoltInstructionRow)
    (k : Nat) (dst : Dst) :
    NarrowAdvicePending bytecode k false dst ↔ ∃ w, narrowLoadAt? bytecode k = some (dst, w) := by
  constructor
  · rintro ⟨start, width, load, narrow, same⟩
    simp only [Bool.false_eq_true, ↓reduceIte] at same
    subst k
    exact ⟨width.toNat, (narrowLoadAt?_eq_some _ _ _ _).mpr
      ⟨start.isLt, width, load, narrow, rfl⟩⟩
  · rintro ⟨w, pending⟩
    obtain ⟨bound, width, load, narrow, _⟩ := (narrowLoadAt?_eq_some _ _ _ _).mp pending
    exact ⟨⟨k, bound⟩, width, load, narrow, rfl⟩

private theorem narrowAdvicePending_pre_iff (image : Rv64ProgramImage SourceInstruction)
    (bytecode : Array JoltInstructionRow) (expanded : expand_program image = some bytecode)
    (k : Nat) (dst : Dst) :
    NarrowAdvicePending bytecode k true dst ↔ ∃ w, pendingBefore? bytecode k = some (dst, w) := by
  constructor
  · rintro ⟨start, width, load, narrow, next, _⟩
    subst k
    refine ⟨width.toNat, ?_⟩
    simp only [pendingBefore?, Nat.add_eq_zero_iff, Nat.one_ne_zero, and_false, ↓reduceIte,
      Nat.add_sub_cancel]
    exact (narrowLoadAt?_eq_some _ _ _ _).mpr ⟨start.isLt, width, load, narrow, rfl⟩
  · rintro ⟨w, pending⟩
    have nonzero : k ≠ 0 := by intro zero; simp [pendingBefore?, zero] at pending
    rw [pendingBefore?, if_neg nonzero] at pending
    obtain ⟨bound, width, load, narrow, _⟩ := (narrowLoadAt?_eq_some _ _ _ _).mp pending
    obtain ⟨rd, dstEq, _, next, multiply⟩ :=
      narrow_load_shape image bytecode expanded (k - 1) bound dst width load narrow
    have index : k = k - 1 + 1 := by omega
    refine ⟨⟨k - 1, bound⟩, width, load, narrow, index, adviceReadSource rd,
      slliMultiplier (BitVec.ofNat 6 (64 - 8 * width.toNat)), ?_⟩
    subst dst
    rw [index, Array.getElem?_eq_getElem next, Option.map_some, multiply]

private theorem replaceDst_sideEffecting (rd : regidx) (state : SailJoltState) (value : BitVec 64) :
    replaceDst (sideEffectingRdZeroDst rd) state value = NativeDispatch.afterDst state rd value := by
  unfold sideEffectingRdZeroDst
  split <;> simp_all only [replaceDst, NativeDispatch.afterDst, ↓reduceIte]

private theorem dstSource_sideEffecting (rd : regidx) :
    dstSource (sideEffectingRdZeroDst rd) = adviceReadSource rd := by
  unfold sideEffectingRdZeroDst adviceReadSource
  split <;> rfl

private theorem rebaseTapeState_replaceDst (baseBytes replacement : Array (BitVec 8))
    (dst : Dst) (state : SailJoltState) (value : BitVec 64) :
    rebaseTapeState baseBytes replacement (replaceDst dst state value) =
      replaceDst dst (rebaseTapeState baseBytes replacement state) value := by
  cases dst with
  | vreg vr => rfl
  | xreg rd =>
    simp only [replaceDst]
    unfold NativeDispatch.afterDst
    split <;> rfl

private theorem rebaseTapeState_afterDst (baseBytes replacement : Array (BitVec 8))
    (rd : regidx) (state : SailJoltState) (value : BitVec 64) :
    rebaseTapeState baseBytes replacement (NativeDispatch.afterDst state rd value) =
      NativeDispatch.afterDst (rebaseTapeState baseBytes replacement state) rd value := by
  simpa only [replaceDst_sideEffecting] using
    rebaseTapeState_replaceDst baseBytes replacement (sideEffectingRdZeroDst rd) state value

private theorem replaceDst_nextPC (dst : Dst) (state : SailJoltState) (value : BitVec 64) :
    (replaceDst dst state value).sail.regs.get? Register.nextPC =
      state.sail.regs.get? Register.nextPC := by
  cases dst with
  | vreg vr => rfl
  | xreg rd =>
    exact JoltNextPCFrame.write_rule (sideEffectingRdZeroDst rd) value state _ ()
      (NativeDispatch.writeDst_run state rd value)

private theorem replayState_nextPC
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (pending : Option (Dst × Nat)) (state : SailJoltState) :
    (replayState run pending state).sail.regs.get? Register.nextPC =
      state.sail.regs.get? Register.nextPC := by
  cases pending with
  | none => rfl
  | some pair => exact replaceDst_nextPC pair.1 _ _

private theorem replayState_agreement
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (k : Nat) (pre : Bool) (pending : Option (Dst × Nat))
    (occurs : ∀ dst, NarrowAdvicePending run.bytecode k pre dst ↔
      ∃ w, pending = some (dst, w)) (state : SailJoltState) :
    ReplayStateAgreement run.bytecode k pre state (replayState run pending state) := by
  cases pending with
  | none =>
    refine ⟨?_, fun _ => rebaseTapeState_same _ _ _⟩
    intro dst occursDst
    obtain ⟨w, impossible⟩ := (occurs dst).mp occursDst
    contradiction
  | some pair =>
    obtain ⟨dst, w⟩ := pair
    constructor
    · intro other occursOther
      obtain ⟨width, same⟩ := (occurs other).mp occursOther
      cases Option.some.inj same
      refine ⟨lowAnswer (sourceValue (dstSource dst) state) w, ?_⟩
      change SameExceptTapeBytes _ (replaceDst _ (rebaseTapeState _ _ state) _)
      rw [← rebaseTapeState_replaceDst]
      exact rebaseTapeState_same _ _ _
    · intro absent
      exact False.elim (absent ⟨dst, (occurs dst).mpr ⟨w, rfl⟩⟩)

private theorem narrowLoadAt?_none_of_ends (image : Rv64ProgramImage SourceInstruction)
    (bytecode : Array JoltInstructionRow) (expanded : expand_program image = some bytecode)
    (k : Nat) (bound : k < bytecode.size)
    (ends : bytecode[k].virtual_sequence_remaining.getD 0 = 0) :
    narrowLoadAt? bytecode k = none := by
  cases pending : narrowLoadAt? bytecode k with
  | none => rfl
  | some pair =>
    obtain ⟨dst, w⟩ := pair
    obtain ⟨_, width, load, narrow, _⟩ := (narrowLoadAt?_eq_some _ _ _ _).mp pending
    obtain ⟨_, _, continues, _⟩ := narrow_load_shape image bytecode expanded k bound dst width load narrow
    have notEnds : bytecode[k].virtual_sequence_remaining.getD 0 ≠ 0 := by
      simpa only [JoltInstructionRow.continues, bne_iff_ne, ne_eq] using continues
    exact False.elim (notEnds ends)

private theorem replayRow_agrees
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (step : Fin run.rows.size) :
    let old := run.rows[step]
    let new := replayRow run step
    old.rowIndex.val = new.rowIndex.val ∧ old.someTracerAdvice? = new.someTracerAdvice? ∧
      old.postState.sail.regs.get? Register.nextPC = new.postState.sail.regs.get? Register.nextPC ∧
      ReplayStateAgreement run.bytecode old.rowIndex.val true old.preState new.preState ∧
      ReplayStateAgreement run.bytecode old.rowIndex.val false old.postState new.postState := by
  refine ⟨rfl, rfl, (replayState_nextPC _ _ _).symm, ?_, ?_⟩
  · exact replayState_agreement run _ true _
      (narrowAdvicePending_pre_iff _ _ run.expands _) _
  · exact replayState_agreement run _ false _ (narrowAdvicePending_post_iff _ _) _

private theorem replayRow_sourceStartPre
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (step : Fin run.rows.size)
    (starts : run.bytecode[run.rows[step].rowIndex].starts_source) :
    SameExceptTapeBytes run.rows[step].preState (replayRow run step).preState := by
  have noPending := pendingBefore?_none_of_start _ _ run.expands _ run.rows[step].rowIndex.isLt starts
  simp only [replayRow, noPending, replayState]
  exact rebaseTapeState_same _ _ _

private theorem replayState_initial
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) :
    replayState run none run.initialState =
      { run.initialState with adviceTape := { bytes := rebuiltTape run, readPosition := 0 } } := by
  have zero := joltInstance.initial_state_adviceTape_readPosition_zero _ _ run.initialized
  have suffix : tapeHostSuffix run.initialState.adviceTape.bytes run.initialState = #[] :=
    tapeHostSuffix_of_append _ #[] _ (by simp)
  simp only [replayState, rebaseTapeState, suffix, Array.append_empty, swapBytes, zero]

private theorem UntrustedAnswerRun.pendingBefore_width
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (step : Fin run.rows.size)
    (dst : Dst) (w : Nat)
    (pending : pendingBefore? run.bytecode run.rows[step].rowIndex.val = some (dst, w)) :
    0 < w := by
  have atStep : run.rows[step.val]? = some run.rows[step] := by simp
  have notStart : ¬run.bytecode[run.rows[step].rowIndex].starts_source := by
    intro starts
    rw [pendingBefore?_none_of_start _ _ run.expands _ run.rows[step].rowIndex.isLt starts] at pending
    contradiction
  have positive : 0 < step.val := by
    by_contra zero
    have index : step.val = 0 := by omega
    have atZero : run.rows[0]? = some run.rows[step] := by simpa only [index] using atStep
    exact notStart (run.starts _ atZero).2.1
  let previous : Fin run.rows.size := ⟨step.val - 1, by omega⟩
  have next : previous.val + 1 = step.val := by dsimp [previous]; omega
  have atPrevious : run.rows[previous.val]? = some run.rows[previous] := by simp
  have atNext : run.rows[previous.val + 1]? = some run.rows[step] := by
    simpa only [next] using atStep
  have link := run.linked previous.val run.rows[previous] run.rows[step] atPrevious atNext
  split at link
  · rw [link.1] at pending
    simp only [pendingBefore?, Nat.add_eq_zero_iff, Nat.one_ne_zero, and_false, ↓reduceIte,
      Nat.add_sub_cancel] at pending
    obtain ⟨_, width, load, _, equalWidth⟩ := (narrowLoadAt?_eq_some _ _ _ _).mp pending
    have valid := run.load_width previous dst width load
    omega
  · obtain ⟨_, _, _, starts, _⟩ := link
    exact False.elim (notStart starts)

private theorem lowAnswer_muli (answer : BitVec 64) (width : Nat)
    (positive : 0 < width) (narrow : width < 8) :
    jolt_virtual_muli_value answer (slliMultiplier (BitVec.ofNat 6 (64 - 8 * width))) =
      jolt_virtual_muli_value (lowAnswer answer width)
        (slliMultiplier (BitVec.ofNat 6 (64 - 8 * width))) := by
  have small : 64 - 8 * width < 2 ^ 6 := by omega
  simp only [jolt_virtual_muli_value, mulWide_low, slliMultiplier, BitVec.toNat_ofNat,
    Nat.mod_eq_of_lt small]
  have multiplier : BitVec.ofNat 64 (2 ^ (64 - 8 * width)) =
      BitVec.twoPow 64 (64 - 8 * width) := by
    apply BitVec.eq_of_toNat_eq
    simp [BitVec.toNat_twoPow]
  rw [multiplier]
  simp only [BitVec.mul_twoPow_eq_shiftLeft]
  exact lowAnswer_shift_width answer width narrow

private theorem sourceValue_afterDst (rd : regidx) (state : SailJoltState) (value : BitVec 64) :
    sourceValue (adviceReadSource rd) (NativeDispatch.afterDst state rd value) = value := by
  exact (lookup_readSrc_value _ _ _ _ (read_afterDst rd value state)).2.symm

private theorem exec_muli_truncated (rd : regidx) (width : Nat) (pre post : SailJoltState)
    (positive : 0 < width) (narrow : width < 8)
    (runs : execInstr (.VirtualMULI (sideEffectingRdZeroDst rd) (adviceReadSource rd)
      (slliMultiplier (BitVec.ofNat 6 (64 - 8 * width)))) pre =
        .ok (.Retire_Success ()) post) :
    execInstr (.VirtualMULI (sideEffectingRdZeroDst rd) (adviceReadSource rd)
      (slliMultiplier (BitVec.ofNat 6 (64 - 8 * width))))
      (NativeDispatch.afterDst pre rd (lowAnswer (sourceValue (adviceReadSource rd) pre) width)) =
        .ok (.Retire_Success ()) post := by
  have written := lookup_read_bind (adviceReadSource rd) _ pre post _ runs
  simp only [NativeDispatch.writeDst_run, bind, EStateM.bind, pure, EStateM.pure] at written
  have postEq := (EStateM.Result.ok.inj written).2
  simp only [execInstr, bind, EStateM.bind, read_afterDst, NativeDispatch.writeDst_run,
    pure, EStateM.pure, afterDst_afterDst]
  rw [← lowAnswer_muli _ width positive narrow, postEq]
  rfl

private theorem exec_rebased {α : Type} (step : JoltMonad α) (swaps : SwapAppend step)
    (baseBytes replacement : Array (BitVec 8))
    (pre post : SailJoltState)
    (prefixBytes : ∃ suffix, pre.adviceTape.bytes = baseBytes ++ suffix)
    (value : α) (runs : step pre = .ok value post) :
    step (rebaseTapeState baseBytes replacement pre) =
      .ok value (rebaseTapeState baseBytes replacement post) := by
  obtain ⟨suffix, preBytes⟩ := prefixBytes
  obtain ⟨added, executes, postBytes⟩ := swaps pre (replacement ++ suffix) value post runs
  have allBytes : post.adviceTape.bytes = baseBytes ++ (suffix ++ added) := by
    rw [postBytes, preBytes, Array.append_assoc]
  simpa only [rebaseTapeState, tapeHostSuffix_of_append _ _ _ preBytes,
    tapeHostSuffix_of_append _ _ _ allBytes, Array.append_assoc] using executes

private theorem swap_answer_load (dst : Dst) (width answer : BitVec 64) :
    SwapInvariant (execWithTapeAnswer (.VirtualAdviceLoad dst width) answer) := by
  intro state bytes
  simp only [execWithTapeAnswer]
  split
  · exact swap_bind (swap_write dst answer) (fun _ => swap_pure RETIRE_SUCCESS)
      { state with adviceTape := { state.adviceTape with
        readPosition := state.adviceTape.readPosition + width.toNat } } bytes
  · rfl

private theorem replay_load_eq_answer
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (step : Fin run.rows.size)
    (dst : Dst) (width : BitVec 64)
    (load : run.bytecode[run.rows[step].rowIndex].instruction = .VirtualAdviceLoad dst width) :
    execInstr (.VirtualAdviceLoad dst width) (replayState run none run.rows[step].preState) =
      execWithTapeAnswer (.VirtualAdviceLoad dst width) (lowAnswer (run.answers step) width.toNat)
        (replayState run none run.rows[step].preState) := by
  have read := (rebuiltTape_read_exact run step dst width load
    (tapeHostSuffix run.initialState.adviceTape.bytes run.rows[step].preState)).2
  have cursor := run.preCursor_eq_rebuiltTapeOffset step
  have valid := run.load_width step dst width load
  simp only [replayState, rebaseTapeState, swapBytes, execInstr, cursor, read,
    execWithTapeAnswer, if_pos valid]

private theorem replayRow_executes_load
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (step : Fin run.rows.size)
    (dst : Dst) (width : BitVec 64)
    (load : run.bytecode[run.rows[step].rowIndex].instruction = .VirtualAdviceLoad dst width) :
    execInstr (.VirtualAdviceLoad dst width) (replayRow run step).preState =
      .ok (.Retire_Success ()) (replayRow run step).postState := by
  have noPending := pendingBefore?_none_of_load _ _ run.expands _ run.rows[step].rowIndex.isLt dst width load
  have runs := run.executes step
  rw [(withRuntimeAdvice_eq_adviceLoad_iff _ _ dst width).mpr load] at runs
  have valid := run.load_width step dst width load
  have narrowAt : narrowLoadAt? run.bytecode run.rows[step].rowIndex.val =
      if width.toNat < 8 then some (dst, width.toNat) else none := by
    have loadNat : run.bytecode[run.rows[step].rowIndex.val].instruction =
        .VirtualAdviceLoad dst width := load
    simp only [narrowLoadAt?, Array.getElem?_eq_getElem run.rows[step].rowIndex.isLt,
      Option.map_some, loadNat]
  simp only [replayRow, noPending, narrowAt]
  rw [replay_load_eq_answer run step dst width load]
  by_cases narrow : width.toNat < 8
  · obtain ⟨rd, dstEq, _, _⟩ := narrow_load_shape _ _ run.expands _ run.rows[step].rowIndex.isLt dst width load narrow
    subst dst
    simp only [execWithTapeAnswer, if_pos valid, bind, EStateM.bind,
      NativeDispatch.writeDst_run, pure, EStateM.pure] at runs
    have postEq := (EStateM.Result.ok.inj runs).2
    simp only [if_pos narrow, replayState, execWithTapeAnswer, if_pos valid,
      bind, EStateM.bind, NativeDispatch.writeDst_run, pure, EStateM.pure,
      ← postEq, dstSource_sideEffecting, sourceValue_afterDst, replaceDst_sideEffecting,
      rebaseTapeState_afterDst, afterDst_afterDst]
    rfl
  · have wide : width.toNat = 8 := by omega
    have fullAnswer : lowAnswer (run.answers step) width.toNat = run.answers step := by
      apply BitVec.eq_of_toNat_eq
      simp [lowAnswer, wide, Nat.mod_eq_of_lt (BitVec.isLt _)]
    simp only [if_neg narrow, fullAnswer, replayState]
    exact exec_rebased _ (swapInvariant_to_append (swap_answer_load dst width (run.answers step)))
      _ _ _ _ (run.initial_bytes_prefix step) _ runs

private theorem replayRow_executes_nonload
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (step : Fin run.rows.size)
    (notLoad : ∀ dst width, run.bytecode[run.rows[step].rowIndex].instruction ≠
      .VirtualAdviceLoad dst width) :
    execInstr (run.bytecode[run.rows[step].rowIndex].instruction.withRuntimeAdvice run.rows[step].runtimeAdvice)
      (replayRow run step).preState = .ok (.Retire_Success ()) (replayRow run step).postState := by
  let instruction := run.bytecode[run.rows[step].rowIndex].instruction.withRuntimeAdvice run.rows[step].runtimeAdvice
  have patchedNotLoad : ∀ dst width, instruction ≠ .VirtualAdviceLoad dst width := by
    intro dst width isLoad
    exact notLoad dst width ((withRuntimeAdvice_eq_adviceLoad_iff _ _ _ _).mp isLoad)
  have runs : execInstr instruction run.rows[step].preState =
      .ok (.Retire_Success ()) run.rows[step].postState := by
    have executes := run.executes step
    change execWithTapeAnswer instruction _ _ = _ at executes
    simp only [execWithTapeAnswer] at executes
    exact executes
  have rebased := exec_rebased _ (swap_execInstr_nonload instruction patchedNotLoad)
    _ (rebuiltTape run) _ _ (run.initial_bytes_prefix step) _ runs
  have noPost : narrowLoadAt? run.bytecode run.rows[step].rowIndex.val = none := by
    cases pending : narrowLoadAt? run.bytecode run.rows[step].rowIndex.val with
    | none => rfl
    | some pair =>
      obtain ⟨_, width, load, _, _⟩ := (narrowLoadAt?_eq_some _ _ pair.1 pair.2).mp pending
      exact False.elim (notLoad pair.1 width load)
  cases pending : pendingBefore? run.bytecode run.rows[step].rowIndex.val with
  | none => simpa only [replayRow, pending, noPost, replayState] using rebased
  | some pair =>
    obtain ⟨dst, w⟩ := pair
    obtain ⟨rd, dstEq, narrow, _, multiply⟩ := pendingBefore?_shape _ _ run.expands
      _ run.rows[step].rowIndex.isLt dst w pending
    have positive := run.pendingBefore_width step dst w pending
    have patched : instruction = .VirtualMULI (sideEffectingRdZeroDst rd)
        (adviceReadSource rd) (slliMultiplier (BitVec.ofNat 6 (64 - 8 * w))) := by
      have multiplyFin : run.bytecode[run.rows[step].rowIndex].instruction =
          .VirtualMULI (sideEffectingRdZeroDst rd) (adviceReadSource rd)
            (slliMultiplier (BitVec.ofNat 6 (64 - 8 * w))) := multiply
      change run.bytecode[run.rows[step].rowIndex].instruction.withRuntimeAdvice
        run.rows[step].runtimeAdvice = _
      rw [withRuntimeAdvice_eq_of_noAdvice _ _ (by rw [multiplyFin]; rfl)]
      exact multiplyFin
    change execInstr instruction _ = _
    rw [patched] at rebased ⊢
    simp only [replayRow, pending, noPost, replayState, dstEq,
      replaceDst_sideEffecting, dstSource_sideEffecting]
    have values := (rebaseTapeState_same run.initialState.adviceTape.bytes
      (rebuiltTape run) run.rows[step].preState).sourceValue_eq (adviceReadSource rd)
    rw [values]
    exact exec_muli_truncated rd w _ _ positive narrow rebased

private theorem replayRow_executes
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (step : Fin run.rows.size) :
    execInstr (run.bytecode[(replayRow run step).rowIndex].instruction.withRuntimeAdvice
      (replayRow run step).runtimeAdvice) (replayRow run step).preState =
      .ok (.Retire_Success ()) (replayRow run step).postState := by
  rcases Classical.em (∃ dst width,
    run.bytecode[run.rows[step].rowIndex].instruction = .VirtualAdviceLoad dst width) with isLoad | isLoad
  · obtain ⟨dst, width, load⟩ := isLoad
    change execInstr (run.bytecode[run.rows[step].rowIndex].instruction.withRuntimeAdvice
      run.rows[step].runtimeAdvice) _ = _
    rw [(withRuntimeAdvice_eq_adviceLoad_iff _ _ dst width).mpr load]
    exact replayRow_executes_load run step dst width load
  · exact replayRow_executes_nonload run step (by intro dst width load; exact isLoad ⟨dst, width, load⟩)

private theorem replayRow_starts
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (step : Fin run.rows.size)
    (atZero : run.rows[0]? = some run.rows[step]) :
    run.bytecode[(replayRow run step).rowIndex].address = joltInstance.program.entry_address ∧
    run.bytecode[(replayRow run step).rowIndex].starts_source ∧
    (replayRow run step).preState = advance_pc joltInstance.program.entry_address
      (source_is_compressed run.bytecode (replayRow run step).rowIndex)
      { run.initialState with adviceTape := { bytes := rebuiltTape run, readPosition := 0 } } := by
  obtain ⟨address, starts, state⟩ := run.starts _ atZero
  refine ⟨address, starts, ?_⟩
  have noPending := pendingBefore?_none_of_start _ _ run.expands _ run.rows[step].rowIndex.isLt starts
  simp only [replayRow, noPending, replayState]
  rw [state, rebaseTapeState_advance_pc]
  rw [show rebaseTapeState run.initialState.adviceTape.bytes (rebuiltTape run) run.initialState =
    { run.initialState with adviceTape := { bytes := rebuiltTape run, readPosition := 0 } }
    from replayState_initial run]

private theorem replayRow_linked
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (i j : Fin run.rows.size)
    (next : j.val = i.val + 1) :
    let current := replayRow run i
    let following := replayRow run j
    if run.bytecode[current.rowIndex].virtual_sequence_remaining.getD 0 ≠ 0 then
      following.rowIndex.val = current.rowIndex.val + 1 ∧ following.preState = current.postState
    else
      ∃ address, current.postState.sail.regs.get? Register.nextPC = some address ∧
        run.bytecode[following.rowIndex].address = address ∧
        run.bytecode[following.rowIndex].starts_source ∧
        following.preState = advance_pc address (source_is_compressed run.bytecode following.rowIndex) current.postState := by
  have atNext : run.rows[i.val + 1]? = some run.rows[j] := by simp only [← next]; simp
  have link := run.linked i.val run.rows[i] run.rows[j] (by simp) atNext
  simp only [replayRow]
  by_cases continues : run.bytecode[run.rows[i].rowIndex].virtual_sequence_remaining.getD 0 ≠ 0
  · simp only [if_pos continues] at link ⊢
    refine ⟨link.1, ?_⟩
    change replayState run (pendingBefore? run.bytecode run.rows[j].rowIndex.val) run.rows[j].preState = _
    rw [link.1, link.2]
    simp only [pendingBefore?, Nat.add_eq_zero_iff, Nat.one_ne_zero, and_false, ↓reduceIte,
      Nat.add_sub_cancel]
  · simp only [if_neg continues] at link ⊢
    obtain ⟨address, nextPC, target, starts, preState⟩ := link
    have noPost := narrowLoadAt?_none_of_ends _ _ run.expands _ run.rows[i].rowIndex.isLt
      (by simpa only [not_not] using continues)
    have noPre := pendingBefore?_none_of_start _ _ run.expands _ run.rows[j].rowIndex.isLt starts
    refine ⟨address, (replayState_nextPC _ _ _).trans nextPC, target, starts, ?_⟩
    simp only [noPre, noPost, replayState]
    rw [preState, rebaseTapeState_advance_pc]

private theorem replayRows_at
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (i : Nat) (row : TraceRow run.bytecode)
    (atRow : (Array.ofFn (replayRow run))[i]? = some row) :
    ∃ step : Fin run.rows.size, step.val = i ∧ row = replayRow run step := by
  rw [Array.getElem?_ofFn] at atRow
  split at atRow
  · exact ⟨⟨i, by assumption⟩, rfl, (Option.some.inj atRow).symm⟩
  · contradiction

private theorem replayRows_pair
    {joltInstance : JoltInstance SourceInstruction} {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) (i : Nat) (old new : TraceRow run.bytecode)
    (oldAt : run.rows[i]? = some old) (newAt : (Array.ofFn (replayRow run))[i]? = some new) :
    ∃ step : Fin run.rows.size, old = run.rows[step] ∧ new = replayRow run step := by
  obtain ⟨step, index, newEq⟩ := replayRows_at run i new newAt
  refine ⟨step, ?_, newEq⟩
  have atStep : run.rows[step.val]? = some run.rows[step] := by simp
  have same := atStep.symm.trans (index.symm ▸ oldAt)
  exact (Option.some.inj same).symm

/-- The rowwise replay certificate. Each new row
executes against the fixed tape, follows its predecessor, and agrees with the
untrusted row except for tape bytes and the narrow load's transient destination.
The final field records exact agreement at the start of each source expansion,
which the honest internal-advice computation reads. -/
private structure RebuiltRows
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerRun joltInstance privateInputs)
    (initial : SailJoltState) where
  rows : Array (TraceRow original.bytecode)
  length : rows.size = original.rows.size
  executes : ∀ row ∈ rows,
    execInstr (original.bytecode[row.rowIndex].instruction.withRuntimeAdvice
      row.runtimeAdvice) row.preState = .ok (.Retire_Success ()) row.postState
  starts : ∀ first ∈ rows[0]?,
    original.bytecode[first.rowIndex].address = joltInstance.program.entry_address ∧
    original.bytecode[first.rowIndex].starts_source ∧
    first.preState = advance_pc joltInstance.program.entry_address
      (source_is_compressed original.bytecode first.rowIndex) initial
  linked : ∀ (i : Nat) (current next : TraceRow original.bytecode),
    rows[i]? = some current → rows[i + 1]? = some next →
    if original.bytecode[current.rowIndex].virtual_sequence_remaining.getD 0 ≠ 0 then
      next.rowIndex.val = current.rowIndex.val + 1 ∧
      next.preState = current.postState
    else
      ∃ address, current.postState.sail.regs.get? Register.nextPC = some address ∧
        original.bytecode[next.rowIndex].address = address ∧
        original.bytecode[next.rowIndex].starts_source ∧
        next.preState = advance_pc address
          (source_is_compressed original.bytecode next.rowIndex) current.postState
  agrees : ∀ (i : Nat) (old new : TraceRow original.bytecode),
    original.rows[i]? = some old → rows[i]? = some new →
      old.rowIndex.val = new.rowIndex.val ∧
      old.someTracerAdvice? = new.someTracerAdvice? ∧
      old.postState.sail.regs.get? Register.nextPC =
        new.postState.sail.regs.get? Register.nextPC ∧
      ReplayStateAgreement original.bytecode old.rowIndex.val true
        old.preState new.preState ∧
      ReplayStateAgreement original.bytecode old.rowIndex.val false
        old.postState new.postState
  sourceStartPre : ∀ (i : Nat) (old new : TraceRow original.bytecode),
    original.rows[i]? = some old → rows[i]? = some new →
    original.bytecode[old.rowIndex].starts_source →
    SameExceptTapeBytes old.preState new.preState

/-- Map the relaxed rows to fixed-tape rows with the same indices and recorded
advice. A one-byte answer of 300 becomes 44 until the following multiply;
host writes append only after the rebuilt tape. -/
private noncomputable def rebuild_rows
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerRun joltInstance privateInputs) :
    RebuiltRows original
      { original.initialState with adviceTape :=
        { bytes := rebuiltTape original, readPosition := 0 } } := by
  refine
    { rows := Array.ofFn (replayRow original)
      length := by simp
      executes := ?_
      starts := ?_
      linked := ?_
      agrees := ?_
      sourceStartPre := ?_ }
  · intro row member
    obtain ⟨step, rfl⟩ := Array.mem_ofFn.mp member
    exact replayRow_executes original step
  · intro first atFirst
    obtain ⟨step, index, rfl⟩ := replayRows_at original 0 first atFirst
    apply replayRow_starts original step
    have atStep : original.rows[step.val]? = some original.rows[step] := by simp
    simpa only [index] using atStep
  · intro i current next atCurrent atNext
    obtain ⟨first, firstIndex, rfl⟩ := replayRows_at original i current atCurrent
    obtain ⟨second, secondIndex, rfl⟩ := replayRows_at original (i + 1) next atNext
    exact replayRow_linked original first second (by omega)
  · intro i old new oldAt newAt
    obtain ⟨step, rfl, rfl⟩ := replayRows_pair original i old new oldAt newAt
    exact replayRow_agrees original step
  · intro i old new oldAt newAt starts
    obtain ⟨step, rfl, rfl⟩ := replayRows_pair original i old new oldAt newAt
    exact replayRow_sourceStartPre original step starts

/-- Replay an accepted relaxed trace over the fixed low-byte tape, preserving
row indices, advice observations and architectural state modulo tape bytes. -/
theorem rebuild_valid_run
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs) :
    ∃ replay : ValidRun joltInstance
        (rebuiltInputs privateInputs original.toUntrustedAnswerRun),
      RebuildAgreement original.toUntrustedAnswerRun replay := by
  let initial : SailJoltState :=
    { original.initialState with adviceTape :=
      { bytes := rebuiltTape original.toUntrustedAnswerRun, readPosition := 0 } }
  have initialized : joltInstance.initial_state
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun) = some initial := by
    rw [rebuiltInputs, JoltInstance.initial_state_with_advice_tape,
      original.initialized]
    rfl
  have zeroCursor : original.initialState.adviceTape.readPosition = 0 := by
    exact joltInstance.initial_state_adviceTape_readPosition_zero
      privateInputs original.initialState original.initialized
  have sameInitial : SameExceptTapeBytes original.initialState initial := by
    simp [SameExceptTapeBytes, initial, zeroCursor]
  let replayRows := rebuild_rows original.toUntrustedAnswerRun
  let replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun) :=
    { toTrace :=
        { bytecode := original.bytecode
          rows := replayRows.rows
          initialState := initial }
      expands := original.expands
      executes := replayRows.executes
      initialized := initialized
      starts := replayRows.starts
      linked := replayRows.linked }
  refine ⟨replay, ?_⟩
  exact
    { bytecode := rfl
      length := replayRows.length
      initial := sameInitial
      rows := replayRows.agrees
      sourceStartPre := replayRows.sourceStartPre }

/-- Final device agreement transfers the public output and panic claim. -/
theorem rebuild_matches_outputs
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay)
    (outputs : original.matches_outputs joltInstance) :
    replay.matches_outputs joltInstance := by
  have nonempty : 0 < replay.rows.size := by
    simpa [agreement.length] using original.nonempty
  let index := replay.rows.size - 1
  have oldBound : index < original.rows.size := by
    have length := agreement.length
    dsimp [index]
    omega
  have newBound : index < replay.rows.size := by
    dsimp [index]
    omega
  let old := original.rows[index]'oldBound
  let new := replay.rows[index]'newBound
  have oldAt : original.rows[index]? = some old := by simp [old, oldBound]
  have newAt : replay.rows[index]? = some new := by simp [new, newBound]
  have deviceEq : old.postState.jolt_device = new.postState.jolt_device :=
    ((agreement.rows index old new oldAt newAt).2.2.2.2).device_eq
  have oldBack : original.rows.back? = some old := by
    rw [Array.back?_eq_getElem?]
    simpa [index, agreement.length] using oldAt
  have newBack : replay.rows.back? = some new := by
    rw [Array.back?_eq_getElem?]
    simpa [index] using newAt
  unfold Trace.matches_outputs at outputs ⊢
  simp only [oldBack, newBack, Option.map_some, Option.getD_some] at outputs ⊢
  simpa only [deviceEq] using outputs

/-- The row slot and the base-register value agree, so RAM accesses use the
same address in the original run and the replay. For example, an LD with
base value 24 and immediate 8 accesses address 32 in both runs. -/
private theorem RebuildAgreement.ram_address_eq
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay)
    (i : Nat) (old : TraceRow original.bytecode)
    (new : TraceRow replay.bytecode)
    (oldAt : original.rows[i]? = some old)
    (newAt : replay.rows[i]? = some new) :
    old.ram_address = new.ram_address := by
  obtain ⟨sameIndex, _, _, samePre, _⟩ := agreement.rows i old new oldAt newAt
  have sameSlot := agreement.slot_eq old new sameIndex
  unfold TraceRow.ram_address
  rw [sameSlot]
  split <;> try rfl
  · rename_i instr faultClass dst base imm heq
    have oldInstr : original.bytecode[old.rowIndex].instruction =
        .LD faultClass dst base imm := by
      rw [sameSlot]
      exact heq
    have slotInstruction :
        (original.bytecode[old.rowIndex.val]?.map (·.instruction)) =
          some (.LD faultClass dst base imm) := by
      simpa only [Array.getElem?_eq_getElem old.rowIndex.isLt,
        Option.map_some, Fin.getElem_fin, Option.some.injEq] using oldInstr
    have sameState := samePre.pre_same_of_ne_muli
      (.LD faultClass dst base imm) slotInstruction (by intros; simp)
    rw [heq]
    simp [sameState.sourceValue_eq base]
  · rename_i instr base value imm heq
    have oldInstr : original.bytecode[old.rowIndex].instruction =
        .SD base value imm := by
      rw [sameSlot]
      exact heq
    have slotInstruction :
        (original.bytecode[old.rowIndex.val]?.map (·.instruction)) =
          some (.SD base value imm) := by
      simpa only [Array.getElem?_eq_getElem old.rowIndex.isLt,
        Option.map_some, Fin.getElem_fin, Option.some.injEq] using oldInstr
    have sameState := samePre.pre_same_of_ne_muli
      (.SD base value imm) slotInstruction (by intros; simp)
    rw [heq]
    simp [sameState.sourceValue_eq base]

/-- Replay preserves row count, the final jump flag and observed RAM bounds. -/
theorem RebuildAgreement.execution_dimensions_eq
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay) :
    original.execution_dimensions = replay.execution_dimensions := by
  unfold Trace.execution_dimensions
  congr 1
  · exact agreement.length.symm
  · by_cases nonempty : 0 < replay.rows.size
    · let index := replay.rows.size - 1
      have oldBound : index < original.rows.size := by
        have length := agreement.length
        dsimp [index]
        omega
      have newBound : index < replay.rows.size := by
        dsimp [index]
        omega
      let old := original.rows[index]'oldBound
      let new := replay.rows[index]'newBound
      have oldAt : original.rows[index]? = some old := by simp [old, oldBound]
      have newAt : replay.rows[index]? = some new := by simp [new, newBound]
      have oldBack : original.rows.back? = some old := by
        rw [Array.back?_eq_getElem?]
        simpa [index, agreement.length] using oldAt
      have newBack : replay.rows.back? = some new := by
        rw [Array.back?_eq_getElem?]
        simpa [index] using newAt
      obtain ⟨sameIndex, _, _, _, _⟩ := agreement.rows index old new oldAt newAt
      have sameSlot := agreement.slot_eq old new sameIndex
      simp only [oldBack, newBack, Option.any_some]
      exact congrArg (fun slot : JoltInstructionRow => slot.instruction.is_jump) sameSlot
    · have zero : replay.rows.size = 0 := by omega
      have oldZero : original.rows.size = 0 := by rw [← agreement.length]; exact zero
      simp [Array.back?_eq_getElem?, zero, oldZero]
  · have addressListEq : original.rows.toList.map (·.ram_address) =
        replay.rows.toList.map (·.ram_address) := by
      apply List.ext_getElem
      · simpa [agreement.length]
      · intro i oldIn newIn
        have oldBound : i < original.rows.size := by simpa using oldIn
        have newBound : i < replay.rows.size := by simpa using newIn
        let old := original.rows[i]'oldBound
        let new := replay.rows[i]'newBound
        have oldAt : original.rows[i]? = some old := by simp [old, oldBound]
        have newAt : replay.rows[i]? = some new := by simp [new, newBound]
        simpa [old, new] using agreement.ram_address_eq i old new oldAt newAt
    have filtered := congrArg (fun xs : List (Option Nat) => xs.filterMap id)
      addressListEq
    simpa [List.filterMap_map] using congrArg
      (List.foldl ExecutionDimensions.observe none) filtered

/-- Equal row count, final jump and RAM-address observations give equal checked
prover dimensions. -/
theorem rebuild_prover_config
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay)
    (accepts : (original.prover_config joltInstance).isSome) :
    (replay.prover_config joltInstance).isSome := by
  have dimensions := agreement.execution_dimensions_eq
  have layout := agreement.initial.device_eq
  unfold Trace.prover_config at accepts ⊢
  simp only [← dimensions, ← layout]
  exact accepts

/-- A spoil-assert row is outside the one-register transient interval. -/
private theorem RebuildAgreement.assert_pre_same
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay)
    (i : Nat) (old : TraceRow original.bytecode)
    (new : TraceRow replay.bytecode)
    (oldAt : original.rows[i]? = some old)
    (newAt : replay.rows[i]? = some new)
    (lhs rhs : Src) (imm : BitVec 128)
    (isAssert : replay.bytecode[new.rowIndex].instruction =
      .VirtualAssertEQ lhs rhs imm) :
    SameExceptTapeBytes old.preState new.preState := by
  obtain ⟨sameIndex, _, _, samePre, _⟩ := agreement.rows i old new oldAt newAt
  have sameSlot := agreement.slot_eq old new sameIndex
  have oldAssert : original.bytecode[old.rowIndex].instruction =
      .VirtualAssertEQ lhs rhs imm := by
    rw [sameSlot]
    exact isAssert
  apply samePre.2
  rintro ⟨dst, start, width, _, _, pending⟩
  obtain ⟨_, src, multiplier, mul⟩ := pending
  have rowInstruction :
      (original.bytecode[old.rowIndex.val]?.map (·.instruction)) =
        some (original.bytecode[old.rowIndex].instruction) := by simp
  rw [rowInstruction, oldAssert] at mul
  cases mul

/-- Every spoil assert has the same source operands in both runs. -/
theorem rebuild_spoil_asserts
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay)
    (passes : original.SpoilAssertsPass) :
    replay.SpoilAssertsPass := by
  intro row rowMem lhs rhs imm isAssert nonzero
  obtain ⟨i, newAt⟩ := Array.mem_iff_getElem?.mp rowMem
  have oldBound : i < original.rows.size := by
    have replayBound := (getElem?_eq_some_iff.mp newAt).1
    have length := agreement.length
    omega
  let old := original.rows[i]'oldBound
  have oldAt : original.rows[i]? = some old := by simp [old, oldBound]
  have oldMem : old ∈ original.rows :=
    Array.mem_iff_getElem?.mpr ⟨i, oldAt⟩
  obtain ⟨sameIndex, _, _, _, _⟩ := agreement.rows i old row oldAt newAt
  have sameSlot := agreement.slot_eq old row sameIndex
  have oldAssert : original.bytecode[old.rowIndex].instruction =
      .VirtualAssertEQ lhs rhs imm := by
    rw [sameSlot]
    exact isAssert
  have samePre := agreement.assert_pre_same i old row oldAt newAt
    lhs rhs imm isAssert
  calc
    sourceValue lhs row.preState = sourceValue lhs old.preState :=
      (samePre.sourceValue_eq lhs).symm
    _ = sourceValue rhs old.preState := passes old oldMem lhs rhs imm oldAssert nonzero
    _ = sourceValue rhs row.preState := samePre.sourceValue_eq rhs

/-- The honest advice calculator reads registers, not tape bytes: replacing
`[0x2C, 0x01]` with `[0x2C]` leaves its result unchanged.
See `jolt/tracer/src/instruction/mod.rs:207-233` at 8bbb2357. -/
private theorem honestTracerAdvice_ignores_tape
    (source : SourceInstruction) (old replay : SailJoltState)
    (same : SameExceptTapeBytes old replay) :
    source.honestTracerAdvice old = source.honestTracerAdvice replay := by
  have ignored : source.honestTracerAdvice old =
      source.honestTracerAdvice
        { old with adviceTape :=
          { old.adviceTape with bytes := replay.adviceTape.bytes } } := rfl
  exact ignored.trans (congrArg source.honestTracerAdvice same)

private theorem RebuildAgreement.observedSlotAt
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay) (i : Nat) :
    (original.rows[i]?.map fun row => original.bytecode[row.rowIndex]) =
      (replay.rows[i]?.map fun row => replay.bytecode[row.rowIndex]) := by
  by_cases oldBound : i < original.rows.size
  · have newBound : i < replay.rows.size := by rw [agreement.length]; exact oldBound
    let old := original.rows[i]'oldBound
    let new := replay.rows[i]'newBound
    have oldAt : original.rows[i]? = some old := by simp [old, oldBound]
    have newAt : replay.rows[i]? = some new := by simp [new, newBound]
    obtain ⟨sameIndex, _, _, _, _⟩ := agreement.rows i old new oldAt newAt
    simpa only [oldAt, newAt, Option.map_some] using
      congrArg some (agreement.slot_eq old new sameIndex)
  · have newBound : ¬ i < replay.rows.size := by
      rw [agreement.length]
      exact oldBound
    simp [show original.rows[i]? = none from by simp [oldBound],
      show replay.rows[i]? = none from by simp [newBound]]

private theorem RebuildAgreement.startFlagAt_eq
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay) (i : Nat) :
    stepNOfTraceIsStartOfNewExpansion original.rows i =
      stepNOfTraceIsStartOfNewExpansion replay.rows i := by
  simp only [stepNOfTraceIsStartOfNewExpansion]
  simpa only [Option.map_map] using congrArg
    (fun slot : Option JoltInstructionRow =>
      (slot.map JoltInstructionRow.starts_source).getD false)
    (agreement.observedSlotAt i)

private theorem RebuildAgreement.adviceFlagAt_eq
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay) (i : Nat) :
    stepNOfTraceIsAdvice original.rows i = stepNOfTraceIsAdvice replay.rows i := by
  simp only [stepNOfTraceIsAdvice]
  simpa only [Option.bind_map] using congrArg
    (fun slot : Option JoltInstructionRow =>
      (slot.bind fun row => row.instruction.adviceValue?).isSome)
    (agreement.observedSlotAt i)

private theorem RebuildAgreement.startOfExpansion_eq
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay) (n : Nat) :
    startOfExpansionContainingStepN original.rows n =
      startOfExpansionContainingStepN replay.rows n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    simp only [startOfExpansionContainingStepN,
      agreement.startFlagAt_eq (n + 1), ih]

private theorem RebuildAgreement.adviceCount_eq
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay) (n : Nat) :
    adviceStepsBeforeStepN original.rows n =
      adviceStepsBeforeStepN replay.rows n := by
  have flags : stepNOfTraceIsAdvice original.rows =
      stepNOfTraceIsAdvice replay.rows := funext agreement.adviceFlagAt_eq
  simp only [adviceStepsBeforeStepN, agreement.startOfExpansion_eq n, flags]

private theorem startOfExpansion_is_start_or_zero
    {bytecode : Array JoltInstructionRow}
    (rows : Array (TraceRow bytecode)) (n : Nat) :
    startOfExpansionContainingStepN rows n = 0 ∨
      stepNOfTraceIsStartOfNewExpansion rows
        (startOfExpansionContainingStepN rows n) = true := by
  induction n with
  | zero => exact Or.inl rfl
  | succ n ih =>
    by_cases h : stepNOfTraceIsStartOfNewExpansion rows (n + 1) = true
    · simp only [startOfExpansionContainingStepN, if_pos h]
      exact Or.inr h
    · simp only [startOfExpansionContainingStepN, if_neg h]
      exact ih

private theorem UntrustedAnswerRun.expansionStart_starts_source
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (n : Nat) (first : TraceRow run.bytecode)
    (firstAt : run.rows[startOfExpansionContainingStepN run.rows n]? = some first) :
    run.bytecode[first.rowIndex].starts_source := by
  rcases startOfExpansion_is_start_or_zero run.rows n with zero | marked
  · rw [zero] at firstAt
    exact (run.starts first (by simpa using firstAt)).2.1
  · simp only [stepNOfTraceIsStartOfNewExpansion, firstAt,
      Option.map_some, Option.getD_some] at marked
    exact marked

private theorem RebuildAgreement.honestAdviceAt_eq
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay)
    (n : Nat) (old : TraceRow original.bytecode)
    (new : TraceRow replay.bytecode)
    (oldAt : original.rows[n]? = some old)
    (newAt : replay.rows[n]? = some new) :
    honestTracerAdviceAtStepN joltInstance.program original.rows n =
      honestTracerAdviceAtStepN joltInstance.program replay.rows n := by
  obtain ⟨sameIndex, _, _, _, _⟩ := agreement.rows n old new oldAt newAt
  have sameSlot := agreement.slot_eq old new sameIndex
  have sameCurrentAdvice :
      original.bytecode[old.rowIndex.val].instruction.adviceValue? =
        replay.bytecode[new.rowIndex.val].instruction.adviceValue? := by
    simpa using congrArg (fun slot : JoltInstructionRow =>
      slot.instruction.adviceValue?) sameSlot
  let firstIndex := startOfExpansionContainingStepN original.rows n
  have sameStart : firstIndex = startOfExpansionContainingStepN replay.rows n :=
    agreement.startOfExpansion_eq n
  have sameCount := agreement.adviceCount_eq n
  by_cases firstBound : firstIndex < original.rows.size
  · have replayBound : firstIndex < replay.rows.size := by
      rw [agreement.length]
      exact firstBound
    let oldFirst := original.rows[firstIndex]'firstBound
    let newFirst := replay.rows[firstIndex]'replayBound
    have oldFirstAt : original.rows[firstIndex]? = some oldFirst := by
      simp [oldFirst, firstBound]
    have newFirstAt : replay.rows[firstIndex]? = some newFirst := by
      simp [newFirst, replayBound]
    obtain ⟨firstSameIndex, _, _, _, _⟩ :=
      agreement.rows firstIndex oldFirst newFirst oldFirstAt newFirstAt
    have sameFirstSlot := agreement.slot_eq oldFirst newFirst firstSameIndex
    have firstIsStart : original.bytecode[oldFirst.rowIndex].starts_source := by
      exact original.expansionStart_starts_source n oldFirst oldFirstAt
    have samePre := agreement.sourceStartPre firstIndex oldFirst newFirst
      oldFirstAt newFirstAt firstIsStart
    have sameAddress : original.bytecode[oldFirst.rowIndex].address =
        replay.bytecode[newFirst.rowIndex].address :=
      congrArg JoltInstructionRow.address sameFirstSlot
    have sameSourceAddress : original.bytecode[oldFirst.rowIndex.val].address =
        replay.bytecode[newFirst.rowIndex.val].address := by
      simpa using sameAddress
    dsimp only [firstIndex] at oldFirstAt
    simp [honestTracerAdviceAtStepN, oldAt, newAt, sameCurrentAdvice,
      ← sameStart, oldFirstAt, newFirstAt, sameSourceAddress, ← sameCount,
      honestTracerAdvice_ignores_tape _ _ _ samePre]
  · have replayBound : ¬ firstIndex < replay.rows.size := by
      rw [agreement.length]
      exact firstBound
    have oldFirstAt : original.rows[firstIndex]? = none := by simp [firstBound]
    have newFirstAt : replay.rows[firstIndex]? = none := by simp [replayBound]
    dsimp only [firstIndex] at oldFirstAt
    simp [honestTracerAdviceAtStepN, oldAt, newAt,
      ← sameStart, oldFirstAt, newFirstAt]

/-- Honest internal advice uses the state at the start of its source expansion;
the rebuilt run has that state, apart from tape bytes. -/
theorem rebuild_honest_advice
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    ∀ n : Fin replay.rows.size,
      replay.rows[n].someTracerAdvice? =
        honestTracerAdviceAtStepN joltInstance.program replay.rows n := by
  intro n
  have oldBound : n.val < original.rows.size := by
    rw [← agreement.length]
    exact n.isLt
  let old := original.rows[n.val]'oldBound
  let new := replay.rows[n]
  have oldAt : original.rows[n.val]? = some old := by simp [old, oldBound]
  have newAt : replay.rows[n.val]? = some new := by simp [new]
  have observed := (agreement.rows n.val old new oldAt newAt).2.1
  have originalAdvice := original.advice_from_honest_tracer ⟨n.val, oldBound⟩
  simpa only [old, new] using
    observed.symm.trans (originalAdvice.trans
      (agreement.honestAdviceAt_eq n.val old new oldAt newAt))

/-- PR #2109's stable-stall predicate depends on bytecode, row index and nextPC,
all preserved by replay. Pinned to a16z/jolt PR #2109 head d2995380. -/
theorem rebuild_stops
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    ∀ last ∈ replay.rows.back?, last.StableStall := by
  intro last lastMem
  have nonempty : 0 < replay.rows.size := by
    simpa [agreement.length] using original.nonempty
  let index := replay.rows.size - 1
  have oldBound : index < original.rows.size := by
    have length := agreement.length
    dsimp [index]
    omega
  let old := original.rows[index]'oldBound
  have oldAt : original.rows[index]? = some old := by
    simp [old, oldBound]
  have newAt : replay.rows[index]? = some last := by
    simpa [index, Array.back?_eq_getElem?] using lastMem
  have oldLast : old ∈ original.rows.back? := by
    simpa [Array.back?_eq_getElem?, index, agreement.length] using oldAt
  have oldStable := original.stops old oldLast
  obtain ⟨sameIndex, _, sameNextPC, _, _⟩ := agreement.rows index old last oldAt newAt
  have sameSlot := agreement.slot_eq old last sameIndex
  exact (stableStall_iff_of_slot_nextPC old last sameSlot sameNextPC).mp oldStable

/-- The replay has no stable stall before its final row, as in the original. -/
theorem rebuild_runs_until_stop
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    ∀ (i : Nat) (current next : TraceRow replay.bytecode),
      replay.rows[i]? = some current → replay.rows[i + 1]? = some next →
      ¬ current.StableStall := by
  intro i current next currentAt nextAt stable
  have length := agreement.length
  have oldCurrentBound : i < original.rows.size := by
    have replayBound := (getElem?_eq_some_iff.mp currentAt).1
    omega
  have oldNextBound : i + 1 < original.rows.size := by
    have replayBound := (getElem?_eq_some_iff.mp nextAt).1
    omega
  let oldCurrent := original.rows[i]'oldCurrentBound
  let oldNext := original.rows[i + 1]'oldNextBound
  have oldCurrentAt : original.rows[i]? = some oldCurrent := by
    simp [oldCurrent, oldCurrentBound]
  have oldNextAt : original.rows[i + 1]? = some oldNext := by
    simp [oldNext, oldNextBound]
  have oldNoStop := original.runs_until_stop i oldCurrent oldNext
    oldCurrentAt oldNextAt
  obtain ⟨sameIndex, _, sameNextPC, _, _⟩ :=
    agreement.rows i oldCurrent current oldCurrentAt currentAt
  have sameSlot := agreement.slot_eq oldCurrent current sameIndex
  exact oldNoStop ((stableStall_iff_of_slot_nextPC oldCurrent current
    sameSlot sameNextPC).mpr stable)

/-- The replay has at least one row because it has the original row count. -/
theorem rebuild_nonempty
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    0 < replay.rows.size := by
  simpa [agreement.length] using original.nonempty

/-- Every instance in the relaxed-answer language is in Jolt's language. -/
theorem untrustedAnswerLanguage_implies_inLanguage
    {joltInstance : JoltInstance SourceInstruction}
    (member : UntrustedAnswerLanguage joltInstance) :
    joltInstance.InLanguage := by
  obtain ⟨privateInputs, original, outputs, proverAccepts, spoilAsserts⟩ := member
  obtain ⟨replay, agreement⟩ := rebuild_valid_run original
  let honest : HonestTrace joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun) :=
    { toValidRun := replay
      accepted := original.accepted
      valid_inputs := original.valid_inputs
      advice_from_honest_tracer := rebuild_honest_advice original replay agreement
      stops := rebuild_stops original replay agreement
      runs_until_stop := rebuild_runs_until_stop original replay agreement
      nonempty := rebuild_nonempty original replay agreement }
  exact ⟨rebuiltInputs privateInputs original.toUntrustedAnswerRun, honest,
    rebuild_matches_outputs original replay agreement outputs,
    rebuild_prover_config original replay agreement proverAccepts,
    rebuild_spoil_asserts original replay agreement spoilAsserts⟩

end JoltConstraints.Soundness
