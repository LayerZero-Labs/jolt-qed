import JoltConstraints.Soundness.Layer5.TapeTrace
import JoltConstraints.Soundness.Layer5.AdviceExpansion

/-! The generated bytecode has only four advice-load expansions. AdviceLB,
AdviceLH and AdviceLW run `VirtualAdviceLoad`, `VirtualMULI`, `VirtualSRAI`;
the multiply discards high answer bits before the arithmetic shift. AdviceLD
reads all eight bytes. Both destination branches, including the x0 rewrite,
have no store, branch, comparison, assert, host call or VirtualAdvice between
the load and masking rows. There is no unsigned advice-load instruction or
inline containing a VirtualAdviceLoad in `SourceInstruction.expand`.

Replay changes `adviceTape.bytes`; state agreement ignores exactly that field.
Host writes append after the rebuilt tape, and every read stays in its prefix. -/

set_option autoImplicit false

namespace JoltConstraints.Soundness

open Sail PreSail LeanRV64D.Functions JoltISA

def lowAnswerBytes (answer : BitVec 64) (width : Nat) : List (BitVec 8) :=
  (List.range width).map fun offset => BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * offset))

def lowAnswer (answer : BitVec 64) (width : Nat) : BitVec 64 :=
  BitVec.ofNat 64 (answer.toNat % 2 ^ (8 * width))

def answerBytesAt {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) : List (BitVec 8) :=
  match run.bytecode[run.rows[step].rowIndex].instruction with
  | .VirtualAdviceLoad _ width => lowAnswerBytes (run.answers step) width.toNat
  | _ => []

/-- The low 1, 2, 4 or 8 bytes of every answer, in read order. -/
def rebuiltTape {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) : Array (BitVec 8) :=
  ((List.finRange run.rows.size).flatMap (answerBytesAt run)).toArray

def rebuiltInputs {joltInstance : JoltInstance SourceInstruction}
    (privateInputs : JoltPrivateInputs)
    (run : UntrustedAnswerRun joltInstance privateInputs) : JoltPrivateInputs :=
  { untrusted_advice := privateInputs.untrusted_advice
    advice_tape := rebuiltTape run }

def rebuiltTapeOffset {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) : Nat :=
  (((List.finRange run.rows.size).filter (fun prior => prior.val < step.val)).flatMap
    (answerBytesAt run)).length

/-- A read uses its own answer bytes and cannot reach host advice appended
after the rebuilt prefix. -/
theorem rebuiltTape_read_exact
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) (dst : Dst) (width : BitVec 64)
    (load : run.bytecode[run.rows[step].rowIndex].instruction =
      .VirtualAdviceLoad dst width) (hostSuffix : Array (BitVec 8)) :
    rebuiltTapeOffset run step + width.toNat ≤ (rebuiltTape run).size ∧
    readAdviceTape
      { bytes := rebuiltTape run ++ hostSuffix
        readPosition := rebuiltTapeOffset run step } width =
      some (lowAnswer (run.answers step) width.toNat,
        { bytes := rebuiltTape run ++ hostSuffix
          readPosition := rebuiltTapeOffset run step + width.toNat }) := by
  sorry

/-- The signed narrow expansions give the same final state from a full answer
and its low bytes. The eight-byte expansion is exact without masking. -/
theorem advicelb_low_answer (rd : regidx) (answers : Nat → BitVec 64)
    (pre : SailJoltState) :
    execProgramWithTapeAnswers (advicelbProgramAuto rd) answers pre =
    execProgramWithTapeAnswers (advicelbProgramAuto rd)
      (fun n => if n = 0 then lowAnswer (answers 0) 1 else answers n) pre := by
  sorry

theorem advicelh_low_answer (rd : regidx) (answers : Nat → BitVec 64)
    (pre : SailJoltState) :
    execProgramWithTapeAnswers (advicelhProgramAuto rd) answers pre =
    execProgramWithTapeAnswers (advicelhProgramAuto rd)
      (fun n => if n = 0 then lowAnswer (answers 0) 2 else answers n) pre := by
  sorry

theorem advicelw_low_answer (rd : regidx) (answers : Nat → BitVec 64)
    (pre : SailJoltState) :
    execProgramWithTapeAnswers (advicelwProgramAuto rd) answers pre =
    execProgramWithTapeAnswers (advicelwProgramAuto rd)
      (fun n => if n = 0 then lowAnswer (answers 0) 4 else answers n) pre := by
  sorry

theorem adviceld_low_answer (rd : regidx) (answers : Nat → BitVec 64)
    (pre : SailJoltState) :
    execProgramWithTapeAnswers (adviceldProgramAuto rd) answers pre =
    execProgramWithTapeAnswers (adviceldProgramAuto rd)
      (fun n => if n = 0 then lowAnswer (answers 0) 8 else answers n) pre := by
  sorry

def SameExceptTapeBytes (original replay : SailJoltState) : Prop :=
  { original with adviceTape :=
    { original.adviceTape with bytes := replay.adviceTape.bytes } } = replay

noncomputable def replaceDst (dst : Dst) (state : SailJoltState)
    (value : BitVec 64) : SailJoltState :=
  match dst with
  | .xreg rd => NativeDispatch.afterDst state rd value
  | .vreg vr =>
      { state with vregs := fun r => if r = vr then value else state.vregs r }

def SameExceptTapeBytesAndDst (dst : Dst)
    (original replay : SailJoltState) : Prop :=
  ∃ value : BitVec 64,
    SameExceptTapeBytes (replaceDst dst original value) replay

/-- The destination can differ only after the advice load or its multiply;
the arithmetic shift restores full state agreement. -/
def NarrowAdvicePending (bytecode : Array JoltInstructionRow)
    (rowIndex : Nat) (preState : Bool) (dst : Dst) : Prop :=
  ∃ (start : Fin bytecode.size) (width : BitVec 64),
    bytecode[start].instruction = .VirtualAdviceLoad dst width ∧
    width.toNat < 8 ∧
    (if preState then
      rowIndex = start.val + 1 ∨ rowIndex = start.val + 2
    else
      rowIndex = start.val ∨ rowIndex = start.val + 1)

def ReplayStateAgreement (bytecode : Array JoltInstructionRow)
    (rowIndex : Nat) (preState : Bool)
    (original replay : SailJoltState) : Prop :=
  (∀ dst, NarrowAdvicePending bytecode rowIndex preState dst →
    SameExceptTapeBytesAndDst dst original replay) ∧
  ((¬ ∃ dst, NarrowAdvicePending bytecode rowIndex preState dst) →
    SameExceptTapeBytes original replay)

/-- Row indices, recorded runtime advice and nextPC are identical. Registers,
RAM and device agree at every row except the pending narrow-load destination. -/
structure RebuildAgreement
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerRun joltInstance privateInputs)
    (replay : ValidRun joltInstance (rebuiltInputs privateInputs original)) : Prop where
  bytecode : replay.bytecode = original.bytecode
  length : replay.rows.size = original.rows.size
  initial : SameExceptTapeBytes original.initialState replay.initialState
  rows : ∀ (i : Nat) (old : TraceRow original.bytecode)
      (new : TraceRow replay.bytecode),
    original.rows[i]? = some old → replay.rows[i]? = some new →
      old.rowIndex.val = new.rowIndex.val ∧
      old.someTracerAdvice? = new.someTracerAdvice? ∧
      old.postState.sail.regs.get? Register.nextPC =
        new.postState.sail.regs.get? Register.nextPC ∧
      ReplayStateAgreement original.bytecode old.rowIndex.val true
        old.preState new.preState ∧
      ReplayStateAgreement original.bytecode old.rowIndex.val false
        old.postState new.postState

theorem rebuild_valid_run
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs) :
    ∃ replay : ValidRun joltInstance
        (rebuiltInputs privateInputs original.toUntrustedAnswerRun),
      RebuildAgreement original.toUntrustedAnswerRun replay := by
  sorry

/-- Final device agreement transfers the public output and panic claim. -/
theorem rebuild_matches_outputs
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay)
    (outputs : original.matches_outputs joltInstance) :
    replay.matches_outputs joltInstance := by
  sorry

/-- Equal row count, final jump and RAM-address observations give equal checked
prover dimensions. -/
theorem rebuild_prover_config
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay)
    (accepts : (original.prover_config joltInstance).isSome) :
    (replay.prover_config joltInstance).isSome := by
  sorry

/-- Every spoil assert has the same source operands in both runs. -/
theorem rebuild_spoil_asserts
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay)
    (passes : original.SpoilAssertsPass) :
    replay.SpoilAssertsPass := by
  sorry

/-- Honest internal advice uses the state at the start of its source expansion;
the rebuilt run has that state, apart from tape bytes. -/
theorem rebuild_honest_advice
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    ∀ n : Fin replay.rows.size,
      replay.rows[n].someTracerAdvice? =
        honestTracerAdviceAtStepN joltInstance.program replay.rows n := by
  sorry

/-- PR #2109's stable-stall predicate depends on bytecode, row index and nextPC,
all preserved by replay. Pinned to a16z/jolt PR #2109 head d2995380. -/
theorem rebuild_stops
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    ∀ last ∈ replay.rows.back?, last.StableStall := by
  sorry

theorem rebuild_runs_until_stop
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    ∀ (i : Nat) (current next : TraceRow replay.bytecode),
      replay.rows[i]? = some current → replay.rows[i + 1]? = some next →
      ¬ current.StableStall := by
  sorry

theorem rebuild_nonempty
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    0 < replay.rows.size := by
  sorry

/-- Every instance in the relaxed-answer language is in Jolt's language. -/
theorem untrustedAnswerLanguage_implies_inLanguage
    {joltInstance : JoltInstance SourceInstruction}
    (member : UntrustedAnswerLanguage joltInstance) :
    joltInstance.InLanguage := by
  obtain ⟨privateInputs, original, outputs, proverAccepts, spoilAsserts⟩ := member
  obtain ⟨replay, agreement⟩ := rebuild_valid_run original
  let honest : HonestTrace joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun) :=
    { toValidRun := replay
      accepted := original.accepted
      valid_inputs := original.valid_inputs
      advice_from_honest_tracer := rebuild_honest_advice original replay agreement
      stops := rebuild_stops original replay agreement
      runs_until_stop := rebuild_runs_until_stop original replay agreement
      nonempty := rebuild_nonempty original replay agreement }
  exact ⟨rebuiltInputs privateInputs original.toUntrustedAnswerRun, honest,
    rebuild_matches_outputs original replay agreement outputs,
    rebuild_prover_config original replay agreement proverAccepts,
    rebuild_spoil_asserts original replay agreement spoilAsserts⟩

end JoltConstraints.Soundness
