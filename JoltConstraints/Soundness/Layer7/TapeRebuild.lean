import JoltConstraints.Soundness.Layer5.TapeTrace
import JoltConstraints.Soundness.Layer5.AdviceExpansion
import JoltConstraints.Soundness.Layer5.RuntimeAdvice
import JoltConstraints.advice_inputs

/-! The generated bytecode has only four advice-load expansions. AdviceLB,
AdviceLH and AdviceLW run `VirtualAdviceLoad`, `VirtualMULI`, `VirtualSRAI`;
the multiply discards high answer bits before the arithmetic shift. AdviceLD
reads all eight bytes. Both destination branches, including the x0 rewrite,
have no store, branch, comparison, assert, host call or VirtualAdvice between
the load and masking rows. There is no unsigned advice-load instruction or
inline containing a VirtualAdviceLoad in `SourceInstruction.expand`.

Replay changes `adviceTape.bytes`; state agreement ignores exactly that field.
Host writes append after the rebuilt tape, and every read stays in its prefix. -/

set_option autoImplicit false

namespace JoltConstraints.Soundness

open Sail PreSail LeanRV64D.Functions JoltISA

/-- `width` little-endian bytes from an answer. For answer 300 and width 1,
this is `[0x2C]`: the high byte of 300 is dropped. -/
def lowAnswerBytes (answer : BitVec 64) (width : Nat) : List (BitVec 8) :=
  (List.range width).map fun offset => BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * offset))

/-- The word formed by zero-extending `lowAnswerBytes`; 300 at width 1 becomes 44. -/
def lowAnswer (answer : BitVec 64) (width : Nat) : BitVec 64 :=
  BitVec.ofNat 64 (answer.toNat % 2 ^ (8 * width))

/-- The bytes contributed by one executed row, empty unless it is a tape read.
A one-byte advice-load row answered with 300 contributes `[0x2C]`. -/
def answerBytesAt {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) : List (BitVec 8) :=
  match run.bytecode[run.rows[step].rowIndex].instruction with
  | .VirtualAdviceLoad _ width => lowAnswerBytes (run.answers step) width.toNat
  | _ => []

/-- The low 1, 2, 4 or 8 bytes of every answer, in read order. -/
def rebuiltTape {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs) : Array (BitVec 8) :=
  ((List.finRange run.rows.size).flatMap (answerBytesAt run)).toArray

/-- Keep the prover's non-tape private input and replace only its tape. -/
def rebuiltInputs {joltInstance : JoltInstance SourceInstruction}
    (privateInputs : JoltPrivateInputs)
    (run : UntrustedAnswerRun joltInstance privateInputs) : JoltPrivateInputs :=
  { privateInputs with advice_tape := rebuiltTape run }

/-- Number of rebuilt tape bytes before a row. If the first read answered 300
at width 1, its offset is zero and the next read starts at offset one. -/
def rebuiltTapeOffset {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) : Nat :=
  (((List.finRange run.rows.size).take step.val).flatMap
    (answerBytesAt run)).length

/-- The relaxed run's tape cursor counts the byte widths of preceding loads.
Host advice writes append bytes and leave the cursor unchanged. -/
private theorem UntrustedAnswerRun.preCursor_eq_rebuiltTapeOffset
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) :
    run.rows[step].preState.adviceTape.readPosition =
      rebuiltTapeOffset run step := by
  sorry

private theorem rebuiltTape_split
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) :
    (rebuiltTape run).toList =
      ((List.finRange run.rows.size).take step.val).flatMap (answerBytesAt run) ++
      answerBytesAt run step ++
      ((List.finRange run.rows.size).drop (step.val + 1)).flatMap (answerBytesAt run) := by
  have split := List.take_append_drop step.val (List.finRange run.rows.size)
  rw [List.drop_eq_getElem_cons (by simpa using step.isLt)] at split
  have atStep : (List.finRange run.rows.size)[step.val] = step := by simp
  rw [atStep] at split
  change ((List.finRange run.rows.size).flatMap (answerBytesAt run)).toArray.toList = _
  conv_lhs => rw [← split]
  simp only [List.flatMap_append, List.flatMap_cons, List.append_assoc]

private theorem lowAnswerByte_as_shift (answer : BitVec 64) (i : Nat) :
    BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * i)) =
      (answer >>> (8 * i)).setWidth 8 := by
  apply BitVec.eq_of_toNat_eq
  simp [BitVec.toNat_setWidth, BitVec.toNat_ushiftRight,
    Nat.shiftRight_eq_div_pow]

/-- Folding at most eight little-endian answer bytes reconstructs precisely
those low bytes of the original 64-bit answer. -/
private theorem lowAnswerBytes_range_value (answer : BitVec 64) (width : Nat)
    (valid : width ≤ 8) :
    (List.range width).foldl (fun value i =>
      value ||| ((BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * i))).zeroExtend 64 <<<
        (8 * i))) (0#64) = lowAnswer answer width := by
  have core : ∀ n : Nat, n ≤ 8 →
      (List.range n).foldl (fun value i =>
        value ||| ((BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * i))).zeroExtend 64 <<<
          (8 * i))) (0#64) = (answer.setWidth (8 * n)).zeroExtend 64 := by
    intro n hn
    induction n with
    | zero =>
      apply BitVec.eq_of_toNat_eq
      norm_num [BitVec.toNat_setWidth, Nat.mod_one]
    | succ n ih =>
      rw [List.range_succ, List.foldl_append]
      simp only [List.foldl_cons, List.foldl_nil]
      rw [ih (by omega), lowAnswerByte_as_shift]
      ext i hi
      simp only [BitVec.getElem_or, BitVec.zeroExtend,
        BitVec.getElem_shiftLeft, BitVec.getElem_setWidth,
        BitVec.getLsbD_setWidth, BitVec.getLsbD_ushiftRight]
      by_cases before : i < 8 * n
      · have within : i < 8 * (n + 1) := by omega
        simp [before, within]
      · by_cases within : i < 8 * (n + 1)
        · have byte : i - 8 * n < 8 := by omega
          have idx : 8 * n + (i - 8 * n) = i := by omega
          simp [before, within, byte, idx]
        · have byte : ¬ i - 8 * n < 8 := by omega
          simp [before, within, byte]
  rw [core width valid]
  apply BitVec.eq_of_toNat_eq
  simp [lowAnswer, BitVec.toNat_setWidth]

private theorem lowAnswerBytes_fold_value (answer : BitVec 64) (width : Nat)
    (valid : width = 1 ∨ width = 2 ∨ width = 4 ∨ width = 8) :
    (List.finRange width).foldl (fun value offset =>
      value ||| ((BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * offset.val))).zeroExtend 64 <<<
        (8 * offset.val))) (0#64) = lowAnswer answer width := by
  have mapped : (List.finRange width).foldl (fun value offset =>
      value ||| ((BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * offset.val))).zeroExtend 64 <<<
        (8 * offset.val))) (0#64) =
      (List.range width).foldl (fun value i =>
        value ||| ((BitVec.ofNat 8 (answer.toNat / 2 ^ (8 * i))).zeroExtend 64 <<<
          (8 * i))) (0#64) := by
    rw [← List.map_coe_finRange_eq_range]
    simp only [List.foldl_map]
  rw [mapped]
  exact lowAnswerBytes_range_value answer width (by rcases valid with h | h | h | h <;> omega)

/-- A read uses its own answer bytes and cannot reach host advice appended
after the rebuilt prefix. -/
theorem rebuiltTape_read_exact
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (run : UntrustedAnswerRun joltInstance privateInputs)
    (step : Fin run.rows.size) (dst : Dst) (width : BitVec 64)
    (load : run.bytecode[run.rows[step].rowIndex].instruction =
      .VirtualAdviceLoad dst width) (hostSuffix : Array (BitVec 8)) :
    rebuiltTapeOffset run step + width.toNat ≤ (rebuiltTape run).size ∧
    readAdviceTape
      { bytes := rebuiltTape run ++ hostSuffix
        readPosition := rebuiltTapeOffset run step } width =
      some (lowAnswer (run.answers step) width.toNat,
        { bytes := rebuiltTape run ++ hostSuffix
          readPosition := rebuiltTapeOffset run step + width.toNat }) := by
  have answerEq : answerBytesAt run step =
      lowAnswerBytes (run.answers step) width.toNat := by
    have loadNat : run.bytecode[run.rows[step.val].rowIndex.val].instruction =
        .VirtualAdviceLoad dst width := by
      simpa only [Fin.getElem_fin] using load
    simp [answerBytesAt, loadNat]
  have splitLength := congrArg List.length (rebuiltTape_split run step)
  have bound : rebuiltTapeOffset run step + width.toNat ≤ (rebuiltTape run).size := by
    simp only [rebuiltTapeOffset, answerEq, lowAnswerBytes, List.length_map,
      List.length_range, List.length_append, Array.length_toList] at splitLength ⊢
    omega
  have widthValid : width.toNat = 1 ∨ width.toNat = 2 ∨
      width.toNat = 4 ∨ width.toNat = 8 := by
    have executes := run.executes step
    have absent : run.bytecode[run.rows[step].rowIndex].instruction.adviceValue? =
        none := by rw [load]; rfl
    rw [withRuntimeAdvice_eq_of_noAdvice _ _ absent] at executes
    rw [load] at executes
    by_contra invalid
    simp only [execWithTapeAnswer, if_neg invalid] at executes
    contradiction
  have byteAt (offset : Fin width.toNat) :
      (rebuiltTape run ++ hostSuffix)[rebuiltTapeOffset run step + offset.val]'(by
        have sizeLe : (rebuiltTape run).size ≤ (rebuiltTape run ++ hostSuffix).size := by simp
        omega) =
      BitVec.ofNat 8 ((run.answers step).toNat / 2 ^ (8 * offset.val)) := by
    have within : rebuiltTapeOffset run step + offset.val <
        (rebuiltTape run).size := by omega
    rw [Array.getElem_append_left within]
    change (rebuiltTape run).toList[rebuiltTapeOffset run step + offset.val] = _
    have getByte : (rebuiltTape run).toList[rebuiltTapeOffset run step + offset.val]? =
        some (BitVec.ofNat 8 ((run.answers step).toNat / 2 ^ (8 * offset.val))) := by
      rw [rebuiltTape_split run step]
      simp only [rebuiltTapeOffset, answerEq]
      rw [List.append_assoc]
      rw [List.getElem?_append_right (by omega)]
      rw [List.getElem?_append_left (by simp [lowAnswerBytes])]
      simp [lowAnswerBytes]
    rw [List.getElem?_eq_getElem within] at getByte
    exact Option.some.inj getByte
  refine ⟨bound, ?_⟩
  have boundAppend : rebuiltTapeOffset run step + width.toNat ≤
      (rebuiltTape run ++ hostSuffix).size := by
    have sizeLe : (rebuiltTape run).size ≤ (rebuiltTape run ++ hostSuffix).size := by simp
    omega
  unfold readAdviceTape
  simp only [widthValid, ↓reduceIte, boundAppend, dif_pos]
  congr 1
  · have byteFn : (fun value (offset : Fin width.toNat) =>
        value ||| (((rebuiltTape run ++ hostSuffix)[rebuiltTapeOffset run step + offset.val]'(by
          omega)).zeroExtend 64 <<< (8 * offset.val))) =
        (fun value (offset : Fin width.toNat) =>
          value ||| ((BitVec.ofNat 8 ((run.answers step).toNat /
            2 ^ (8 * offset.val))).zeroExtend 64 <<< (8 * offset.val))) := by
      funext value offset
      rw [byteAt offset]
    rw [byteFn]
    congr 1
    exact lowAnswerBytes_fold_value (run.answers step) width.toNat widthValid

/-- The signed narrow expansions give the same final state from a full answer
and its low bytes. The eight-byte expansion is exact without masking. -/
theorem advicelb_low_answer (rd : regidx) (answers : Nat → BitVec 64)
    (pre : SailJoltState) :
    execProgramWithTapeAnswers (advicelbProgramAuto rd) answers pre =
    execProgramWithTapeAnswers (advicelbProgramAuto rd)
      (fun n => if n = 0 then lowAnswer (answers 0) 1 else answers n) pre := by
  rw [advicelb_exec, advicelb_exec]
  simp only [↓reduceIte]
  have loweq : (lowAnswer (answers 0) 1).setWidth 8 = (answers 0).setWidth 8 := by
    apply BitVec.eq_of_toNat_eq
    simp [lowAnswer, BitVec.toNat_setWidth]
  simp only [loweq]

theorem advicelh_low_answer (rd : regidx) (answers : Nat → BitVec 64)
    (pre : SailJoltState) :
    execProgramWithTapeAnswers (advicelhProgramAuto rd) answers pre =
    execProgramWithTapeAnswers (advicelhProgramAuto rd)
      (fun n => if n = 0 then lowAnswer (answers 0) 2 else answers n) pre := by
  rw [advicelh_exec, advicelh_exec]
  simp only [↓reduceIte]
  have loweq : (lowAnswer (answers 0) 2).setWidth 16 = (answers 0).setWidth 16 := by
    apply BitVec.eq_of_toNat_eq
    simp [lowAnswer, BitVec.toNat_setWidth]
  simp only [loweq]

theorem advicelw_low_answer (rd : regidx) (answers : Nat → BitVec 64)
    (pre : SailJoltState) :
    execProgramWithTapeAnswers (advicelwProgramAuto rd) answers pre =
    execProgramWithTapeAnswers (advicelwProgramAuto rd)
      (fun n => if n = 0 then lowAnswer (answers 0) 4 else answers n) pre := by
  rw [advicelw_exec, advicelw_exec]
  simp only [↓reduceIte]
  have loweq : (lowAnswer (answers 0) 4).setWidth 32 = (answers 0).setWidth 32 := by
    apply BitVec.eq_of_toNat_eq
    simp [lowAnswer, BitVec.toNat_setWidth]
  simp only [loweq]

theorem adviceld_low_answer (rd : regidx) (answers : Nat → BitVec 64)
    (pre : SailJoltState) :
    execProgramWithTapeAnswers (adviceldProgramAuto rd) answers pre =
    execProgramWithTapeAnswers (adviceldProgramAuto rd)
      (fun n => if n = 0 then lowAnswer (answers 0) 8 else answers n) pre := by
  have loweq : lowAnswer (answers 0) 8 = answers 0 := by
    apply BitVec.eq_of_toNat_eq
    simp [lowAnswer, Nat.mod_eq_of_lt (BitVec.isLt _)]
  have functions : (fun n => if n = 0 then lowAnswer (answers 0) 8 else answers n) =
      answers := by
    funext n
    by_cases zero : n = 0 <;> simp [zero, loweq]
  rw [functions]

/-- Shifting a 64-bit value left by the complement of its low byte width
forgets precisely the high bytes. The width must be below eight. -/
private theorem lowAnswer_shift_width (answer : BitVec 64) (width : Nat)
    (valid : width < 8) :
    answer <<< (64 - 8 * width) =
      lowAnswer answer width <<< (64 - 8 * width) := by
  have loweq : lowAnswer answer width =
      (answer.setWidth (8 * width)).zeroExtend 64 := by
    apply BitVec.eq_of_toNat_eq
    simp [lowAnswer, BitVec.toNat_setWidth]
  rw [loweq]
  ext i hi
  simp only [BitVec.getElem_shiftLeft, BitVec.zeroExtend]
  by_cases before : i < 64 - 8 * width
  · simp [before]
  · have low : i - (64 - 8 * width) < 8 * width := by omega
    simp [BitVec.getElem_setWidth, before, low]
    exact (BitVec.getLsbD_eq_getElem (x := answer)
      (i := i - (64 - 8 * width)) (by omega)).symm

/-- Masking has already completed after the multiply row. The later arithmetic
shift only sign-extends the now-equal value. -/
theorem lowAnswer_muli_1 (answer : BitVec 64) :
    jolt_virtual_muli_value answer (slliMultiplier 56) =
      jolt_virtual_muli_value (lowAnswer answer 1) (slliMultiplier 56) := by
  simp only [jolt_virtual_muli_value, mulWide_low, slliMultiplier]
  change answer * (BitVec.twoPow 64 56) =
    lowAnswer answer 1 * (BitVec.twoPow 64 56)
  simp only [BitVec.mul_twoPow_eq_shiftLeft]
  exact lowAnswer_shift_width answer 1 (by omega)

theorem lowAnswer_muli_2 (answer : BitVec 64) :
    jolt_virtual_muli_value answer (slliMultiplier 48) =
      jolt_virtual_muli_value (lowAnswer answer 2) (slliMultiplier 48) := by
  simp only [jolt_virtual_muli_value, mulWide_low, slliMultiplier]
  change answer * (BitVec.twoPow 64 48) =
    lowAnswer answer 2 * (BitVec.twoPow 64 48)
  simp only [BitVec.mul_twoPow_eq_shiftLeft]
  exact lowAnswer_shift_width answer 2 (by omega)

theorem lowAnswer_muli_4 (answer : BitVec 64) :
    jolt_virtual_muli_value answer (slliMultiplier 32) =
      jolt_virtual_muli_value (lowAnswer answer 4) (slliMultiplier 32) := by
  simp only [jolt_virtual_muli_value, mulWide_low, slliMultiplier]
  change answer * (BitVec.twoPow 64 32) =
    lowAnswer answer 4 * (BitVec.twoPow 64 32)
  simp only [BitVec.mul_twoPow_eq_shiftLeft]
  exact lowAnswer_shift_width answer 4 (by omega)

/-- The states agree on cursor, registers, RAM, device and host mode; only the
tape byte array may differ (for example original `[0x2C,0x01]` versus replay
`[0x2C]` after a one-byte read answered with 300). -/
def SameExceptTapeBytes (original replay : SailJoltState) : Prop :=
  { original with adviceTape :=
    { original.adviceTape with bytes := replay.adviceTape.bytes } } = replay

/-- Write one architectural or virtual destination in a state. This lets the
replay relation account for the transient register value 300 versus 44 after
a one-byte load, while leaving all other fields fixed. -/
noncomputable def replaceDst (dst : Dst) (state : SailJoltState)
    (value : BitVec 64) : SailJoltState :=
  match dst with
  | .xreg rd => NativeDispatch.afterDst state rd value
  | .vreg vr =>
      { state with vregs := fun r => if r = vr then value else state.vregs r }

/-- Agreement modulo the tape bytes and one destination register. For the
one-byte answer 300, the unmasked original destination may be 300 while the
fixed-tape replay destination is 44. -/
def SameExceptTapeBytesAndDst (dst : Dst)
    (original replay : SailJoltState) : Prop :=
  ∃ value : BitVec 64,
    SameExceptTapeBytes (replaceDst dst original value) replay

/-- The destination can differ only after the narrow advice load, which is
also the pre-state of the immediately following multiply. The multiply itself
discards all high answer bits, so its post-state already agrees exactly. -/
def NarrowAdvicePending (bytecode : Array JoltInstructionRow)
    (rowIndex : Nat) (preState : Bool) (dst : Dst) : Prop :=
  ∃ (start : Fin bytecode.size) (width : BitVec 64),
    bytecode[start].instruction = .VirtualAdviceLoad dst width ∧
    width.toNat < 8 ∧
    (if preState then
      rowIndex = start.val + 1 ∧
        ∃ src multiplier,
          (bytecode[rowIndex]?.map (·.instruction)) =
            some (.VirtualMULI dst src multiplier)
    else
      rowIndex = start.val)

def ReplayStateAgreement (bytecode : Array JoltInstructionRow)
    (rowIndex : Nat) (preState : Bool)
    (original replay : SailJoltState) : Prop :=
  (∀ dst, NarrowAdvicePending bytecode rowIndex preState dst →
    SameExceptTapeBytesAndDst dst original replay) ∧
  ((¬ ∃ dst, NarrowAdvicePending bytecode rowIndex preState dst) →
    SameExceptTapeBytes original replay)

private theorem SameExceptTapeBytes.device_eq
    {original replay : SailJoltState}
    (same : SameExceptTapeBytes original replay) :
    original.jolt_device = replay.jolt_device := by
  change { original with adviceTape :=
    { original.adviceTape with bytes := replay.adviceTape.bytes } } = replay at same
  have h := congrArg SailJoltState.jolt_device same
  exact h

private theorem SameExceptTapeBytes.sourceValue_eq
    {original replay : SailJoltState}
    (same : SameExceptTapeBytes original replay) (src : Src) :
    sourceValue src original = sourceValue src replay := by
  change { original with adviceTape :=
    { original.adviceTape with bytes := replay.adviceTape.bytes } } = replay at same
  have h := congrArg (sourceValue src) same
  exact h

/-- A successful non-read instruction replays from states that differ only in
tape bytes. It can append host advice after an existing replay-tape prefix. -/
private theorem execInstr_replay_nonload
    (instruction : Instr) (oldPre replayPre oldPost : SailJoltState)
    (same : SameExceptTapeBytes oldPre replayPre)
    (notLoad : ∀ dst width, instruction ≠ .VirtualAdviceLoad dst width)
    (oldExec : execInstr instruction oldPre = .ok (.Retire_Success ()) oldPost)
    (tapePrefix hostSuffix : Array (BitVec 8))
    (replayBytes : replayPre.adviceTape.bytes = tapePrefix ++ hostSuffix) :
    ∃ (replayPost : SailJoltState) (nextHostSuffix : Array (BitVec 8)),
      execInstr instruction replayPre = .ok (.Retire_Success ()) replayPost ∧
      SameExceptTapeBytes oldPost replayPost ∧
      replayPost.adviceTape.bytes = tapePrefix ++ nextHostSuffix := by
  sorry

private theorem replaceDst_device_eq (dst : Dst) (state : SailJoltState)
    (value : BitVec 64) :
    (replaceDst dst state value).jolt_device = state.jolt_device := by
  cases dst with
  | vreg vr => rfl
  | xreg rd =>
      simp only [replaceDst, NativeDispatch.afterDst]
      split <;> rfl

private theorem ReplayStateAgreement.device_eq
    {bytecode : Array JoltInstructionRow} {rowIndex : Nat}
    {preState : Bool} {original replay : SailJoltState}
    (same : ReplayStateAgreement bytecode rowIndex preState original replay) :
    original.jolt_device = replay.jolt_device := by
  by_cases pending : ∃ dst, NarrowAdvicePending bytecode rowIndex preState dst
  · obtain ⟨dst, occurs⟩ := pending
    obtain ⟨value, sameDst⟩ := same.1 dst occurs
    calc
      original.jolt_device = (replaceDst dst original value).jolt_device :=
        (replaceDst_device_eq dst original value).symm
      _ = replay.jolt_device := sameDst.device_eq
  · exact (same.2 pending).device_eq

private theorem ReplayStateAgreement.pre_same_of_ne_muli
    {bytecode : Array JoltInstructionRow} {rowIndex : Nat}
    {original replay : SailJoltState}
    (same : ReplayStateAgreement bytecode rowIndex true original replay)
    (instruction : Instr)
    (slot : (bytecode[rowIndex]?.map (·.instruction)) = some instruction)
    (notMuli : ∀ dst src multiplier,
      instruction ≠ .VirtualMULI dst src multiplier) :
    SameExceptTapeBytes original replay := by
  apply same.2
  rintro ⟨dst, start, width, _, _, pending⟩
  obtain ⟨_, src, multiplier, isMuli⟩ := pending
  rw [slot] at isMuli
  have : instruction = .VirtualMULI dst src multiplier := Option.some.inj isMuli
  exact notMuli dst src multiplier this

/-- Row indices, recorded runtime advice and nextPC are identical. Registers,
RAM and device agree at every row except the pending narrow-load destination. -/
structure RebuildAgreement
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerRun joltInstance privateInputs)
    (replay : ValidRun joltInstance (rebuiltInputs privateInputs original)) : Prop where
  bytecode : replay.bytecode = original.bytecode
  length : replay.rows.size = original.rows.size
  initial : SameExceptTapeBytes original.initialState replay.initialState
  rows : ∀ (i : Nat) (old : TraceRow original.bytecode)
      (new : TraceRow replay.bytecode),
    original.rows[i]? = some old → replay.rows[i]? = some new →
      old.rowIndex.val = new.rowIndex.val ∧
      old.someTracerAdvice? = new.someTracerAdvice? ∧
      old.postState.sail.regs.get? Register.nextPC =
        new.postState.sail.regs.get? Register.nextPC ∧
      ReplayStateAgreement original.bytecode old.rowIndex.val true
        old.preState new.preState ∧
      ReplayStateAgreement original.bytecode old.rowIndex.val false
        old.postState new.postState
  sourceStartPre : ∀ (i : Nat) (old : TraceRow original.bytecode)
      (new : TraceRow replay.bytecode),
    original.rows[i]? = some old → replay.rows[i]? = some new →
    original.bytecode[old.rowIndex].starts_source →
    SameExceptTapeBytes old.preState new.preState

private theorem stableStall_iff_of_slot_nextPC
    {oldBytecode newBytecode : Array JoltInstructionRow}
    (old : TraceRow oldBytecode) (new : TraceRow newBytecode)
    (slot : oldBytecode[old.rowIndex] = newBytecode[new.rowIndex])
    (nextPC : old.postState.sail.regs.get? Register.nextPC =
      new.postState.sail.regs.get? Register.nextPC) :
    old.StableStall ↔ new.StableStall := by
  simp only [TraceRow.StableStall, slot, nextPC]

private theorem RebuildAgreement.slot_eq
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay)
    (old : TraceRow original.bytecode) (new : TraceRow replay.bytecode)
    (sameIndex : old.rowIndex.val = new.rowIndex.val) :
    original.bytecode[old.rowIndex] = replay.bytecode[new.rowIndex] := by
  have slots := congrArg
    (fun bc : Array JoltInstructionRow => bc[old.rowIndex.val]?)
    agreement.bytecode.symm
  change original.bytecode[old.rowIndex.val]? =
    replay.bytecode[old.rowIndex.val]? at slots
  have oldSlot : original.bytecode[old.rowIndex.val]? =
      some original.bytecode[old.rowIndex] := by simp
  have newSlot : replay.bytecode[old.rowIndex.val]? =
      some replay.bytecode[new.rowIndex] := by
    rw [sameIndex]
    simp
  rw [oldSlot, newSlot] at slots
  exact Option.some.inj slots

/-- The rowwise replay certificate. It is the induction target: each new row
executes against the fixed tape, follows its predecessor, and agrees with the
untrusted row except for tape bytes and the narrow load's transient destination.
The final field records exact agreement at the start of each source expansion,
which the honest internal-advice computation reads. -/
private structure RebuiltRows
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerRun joltInstance privateInputs)
    (initial : SailJoltState) where
  rows : Array (TraceRow original.bytecode)
  length : rows.size = original.rows.size
  executes : ∀ row ∈ rows,
    execInstr (original.bytecode[row.rowIndex].instruction.withRuntimeAdvice
      row.runtimeAdvice) row.preState = .ok (.Retire_Success ()) row.postState
  starts : ∀ first ∈ rows[0]?,
    original.bytecode[first.rowIndex].address = joltInstance.program.entry_address ∧
    original.bytecode[first.rowIndex].starts_source ∧
    first.preState = advance_pc joltInstance.program.entry_address
      (source_is_compressed original.bytecode first.rowIndex) initial
  linked : ∀ (i : Nat) (current next : TraceRow original.bytecode),
    rows[i]? = some current → rows[i + 1]? = some next →
    if original.bytecode[current.rowIndex].virtual_sequence_remaining.getD 0 ≠ 0 then
      next.rowIndex.val = current.rowIndex.val + 1 ∧
      next.preState = current.postState
    else
      ∃ address, current.postState.sail.regs.get? Register.nextPC = some address ∧
        original.bytecode[next.rowIndex].address = address ∧
        original.bytecode[next.rowIndex].starts_source ∧
        next.preState = advance_pc address
          (source_is_compressed original.bytecode next.rowIndex) current.postState
  agrees : ∀ (i : Nat) (old new : TraceRow original.bytecode),
    original.rows[i]? = some old → rows[i]? = some new →
      old.rowIndex.val = new.rowIndex.val ∧
      old.someTracerAdvice? = new.someTracerAdvice? ∧
      old.postState.sail.regs.get? Register.nextPC =
        new.postState.sail.regs.get? Register.nextPC ∧
      ReplayStateAgreement original.bytecode old.rowIndex.val true
        old.preState new.preState ∧
      ReplayStateAgreement original.bytecode old.rowIndex.val false
        old.postState new.postState
  sourceStartPre : ∀ (i : Nat) (old new : TraceRow original.bytecode),
    original.rows[i]? = some old → rows[i]? = some new →
    original.bytecode[old.rowIndex].starts_source →
    SameExceptTapeBytes old.preState new.preState

/-- Construct the fixed-tape rows by induction on the untrusted rows. The
read case uses `rebuiltTape_read_exact`; the load and multiply cases use the
four expansion lemmas above. Host writes extend only the suffix. -/
private noncomputable def rebuild_rows
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerRun joltInstance privateInputs) :
    RebuiltRows original
      { original.initialState with adviceTape :=
        { bytes := rebuiltTape original, readPosition := 0 } } := by
  sorry

/-- Replay an accepted relaxed trace over the fixed low-byte tape, preserving
row indices, advice observations and architectural state modulo tape bytes. -/
theorem rebuild_valid_run
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs) :
    ∃ replay : ValidRun joltInstance
        (rebuiltInputs privateInputs original.toUntrustedAnswerRun),
      RebuildAgreement original.toUntrustedAnswerRun replay := by
  let initial : SailJoltState :=
    { original.initialState with adviceTape :=
      { bytes := rebuiltTape original.toUntrustedAnswerRun, readPosition := 0 } }
  have initialized : joltInstance.initial_state
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun) = some initial := by
    rw [rebuiltInputs, JoltInstance.initial_state_with_advice_tape,
      original.initialized]
    rfl
  have zeroCursor : original.initialState.adviceTape.readPosition = 0 := by
    exact joltInstance.initial_state_adviceTape_readPosition_zero
      privateInputs original.initialState original.initialized
  have sameInitial : SameExceptTapeBytes original.initialState initial := by
    simp [SameExceptTapeBytes, initial, zeroCursor]
  let replayRows := rebuild_rows original.toUntrustedAnswerRun
  let replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun) :=
    { toTrace :=
        { bytecode := original.bytecode
          rows := replayRows.rows
          initialState := initial }
      expands := original.expands
      executes := replayRows.executes
      initialized := initialized
      starts := replayRows.starts
      linked := replayRows.linked }
  refine ⟨replay, ?_⟩
  exact
    { bytecode := rfl
      length := replayRows.length
      initial := sameInitial
      rows := replayRows.agrees
      sourceStartPre := replayRows.sourceStartPre }

/-- Final device agreement transfers the public output and panic claim. -/
theorem rebuild_matches_outputs
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay)
    (outputs : original.matches_outputs joltInstance) :
    replay.matches_outputs joltInstance := by
  have nonempty : 0 < replay.rows.size := by
    simpa [agreement.length] using original.nonempty
  let index := replay.rows.size - 1
  have oldBound : index < original.rows.size := by
    have length := agreement.length
    dsimp [index]
    omega
  have newBound : index < replay.rows.size := by
    dsimp [index]
    omega
  let old := original.rows[index]'oldBound
  let new := replay.rows[index]'newBound
  have oldAt : original.rows[index]? = some old := by simp [old, oldBound]
  have newAt : replay.rows[index]? = some new := by simp [new, newBound]
  have deviceEq : old.postState.jolt_device = new.postState.jolt_device :=
    ((agreement.rows index old new oldAt newAt).2.2.2.2).device_eq
  have oldBack : original.rows.back? = some old := by
    rw [Array.back?_eq_getElem?]
    simpa [index, agreement.length] using oldAt
  have newBack : replay.rows.back? = some new := by
    rw [Array.back?_eq_getElem?]
    simpa [index] using newAt
  unfold Trace.matches_outputs at outputs ⊢
  simp only [oldBack, newBack, Option.map_some, Option.getD_some] at outputs ⊢
  simpa only [deviceEq] using outputs

/-- The row slot and the base-register value agree, so RAM accesses use the
same address in the original run and the replay. -/
private theorem RebuildAgreement.ram_address_eq
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay)
    (i : Nat) (old : TraceRow original.bytecode)
    (new : TraceRow replay.bytecode)
    (oldAt : original.rows[i]? = some old)
    (newAt : replay.rows[i]? = some new) :
    old.ram_address = new.ram_address := by
  obtain ⟨sameIndex, _, _, samePre, _⟩ := agreement.rows i old new oldAt newAt
  have sameSlot := agreement.slot_eq old new sameIndex
  unfold TraceRow.ram_address
  rw [sameSlot]
  split <;> try rfl
  · rename_i instr faultClass dst base imm heq
    have oldInstr : original.bytecode[old.rowIndex].instruction =
        .LD faultClass dst base imm := by
      rw [sameSlot]
      exact heq
    have slotInstruction :
        (original.bytecode[old.rowIndex.val]?.map (·.instruction)) =
          some (.LD faultClass dst base imm) := by
      simpa only [Array.getElem?_eq_getElem old.rowIndex.isLt,
        Option.map_some, Fin.getElem_fin, Option.some.injEq] using oldInstr
    have sameState := samePre.pre_same_of_ne_muli
      (.LD faultClass dst base imm) slotInstruction (by intros; simp)
    rw [heq]
    simp [sameState.sourceValue_eq base]
  · rename_i instr base value imm heq
    have oldInstr : original.bytecode[old.rowIndex].instruction =
        .SD base value imm := by
      rw [sameSlot]
      exact heq
    have slotInstruction :
        (original.bytecode[old.rowIndex.val]?.map (·.instruction)) =
          some (.SD base value imm) := by
      simpa only [Array.getElem?_eq_getElem old.rowIndex.isLt,
        Option.map_some, Fin.getElem_fin, Option.some.injEq] using oldInstr
    have sameState := samePre.pre_same_of_ne_muli
      (.SD base value imm) slotInstruction (by intros; simp)
    rw [heq]
    simp [sameState.sourceValue_eq base]

/-- Replay preserves row count, the final jump flag and observed RAM bounds. -/
theorem RebuildAgreement.execution_dimensions_eq
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay) :
    original.execution_dimensions = replay.execution_dimensions := by
  unfold Trace.execution_dimensions
  congr 1
  · exact agreement.length.symm
  · by_cases nonempty : 0 < replay.rows.size
    · let index := replay.rows.size - 1
      have oldBound : index < original.rows.size := by
        have length := agreement.length
        dsimp [index]
        omega
      have newBound : index < replay.rows.size := by
        dsimp [index]
        omega
      let old := original.rows[index]'oldBound
      let new := replay.rows[index]'newBound
      have oldAt : original.rows[index]? = some old := by simp [old, oldBound]
      have newAt : replay.rows[index]? = some new := by simp [new, newBound]
      have oldBack : original.rows.back? = some old := by
        rw [Array.back?_eq_getElem?]
        simpa [index, agreement.length] using oldAt
      have newBack : replay.rows.back? = some new := by
        rw [Array.back?_eq_getElem?]
        simpa [index] using newAt
      obtain ⟨sameIndex, _, _, _, _⟩ := agreement.rows index old new oldAt newAt
      have sameSlot := agreement.slot_eq old new sameIndex
      simp only [oldBack, newBack, Option.any_some]
      exact congrArg (fun slot : JoltInstructionRow => slot.instruction.is_jump) sameSlot
    · have zero : replay.rows.size = 0 := by omega
      have oldZero : original.rows.size = 0 := by rw [← agreement.length]; exact zero
      simp [Array.back?_eq_getElem?, zero, oldZero]
  · have addressListEq : original.rows.toList.map (·.ram_address) =
        replay.rows.toList.map (·.ram_address) := by
      apply List.ext_getElem
      · simpa [agreement.length]
      · intro i oldIn newIn
        have oldBound : i < original.rows.size := by simpa using oldIn
        have newBound : i < replay.rows.size := by simpa using newIn
        let old := original.rows[i]'oldBound
        let new := replay.rows[i]'newBound
        have oldAt : original.rows[i]? = some old := by simp [old, oldBound]
        have newAt : replay.rows[i]? = some new := by simp [new, newBound]
        simpa [old, new] using agreement.ram_address_eq i old new oldAt newAt
    have filtered := congrArg (fun xs : List (Option Nat) => xs.filterMap id)
      addressListEq
    simpa [List.filterMap_map] using congrArg
      (List.foldl ExecutionDimensions.observe none) filtered

/-- Equal row count, final jump and RAM-address observations give equal checked
prover dimensions. -/
theorem rebuild_prover_config
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay)
    (accepts : (original.prover_config joltInstance).isSome) :
    (replay.prover_config joltInstance).isSome := by
  have dimensions := agreement.execution_dimensions_eq
  have layout := agreement.initial.device_eq
  unfold Trace.prover_config at accepts ⊢
  simp only [← dimensions, ← layout]
  exact accepts

/-- A spoil-assert row is outside the one-register transient interval. -/
private theorem RebuildAgreement.assert_pre_same
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    {original : UntrustedAnswerRun joltInstance privateInputs}
    {replay : ValidRun joltInstance (rebuiltInputs privateInputs original)}
    (agreement : RebuildAgreement original replay)
    (i : Nat) (old : TraceRow original.bytecode)
    (new : TraceRow replay.bytecode)
    (oldAt : original.rows[i]? = some old)
    (newAt : replay.rows[i]? = some new)
    (lhs rhs : Src) (imm : BitVec 128)
    (isAssert : replay.bytecode[new.rowIndex].instruction =
      .VirtualAssertEQ lhs rhs imm) :
    SameExceptTapeBytes old.preState new.preState := by
  obtain ⟨sameIndex, _, _, samePre, _⟩ := agreement.rows i old new oldAt newAt
  have sameSlot := agreement.slot_eq old new sameIndex
  have oldAssert : original.bytecode[old.rowIndex].instruction =
      .VirtualAssertEQ lhs rhs imm := by
    rw [sameSlot]
    exact isAssert
  apply samePre.2
  rintro ⟨dst, start, width, _, _, pending⟩
  obtain ⟨_, src, multiplier, mul⟩ := pending
  have rowInstruction :
      (original.bytecode[old.rowIndex.val]?.map (·.instruction)) =
        some (original.bytecode[old.rowIndex].instruction) := by simp
  rw [rowInstruction, oldAssert] at mul
  cases mul

/-- Every spoil assert has the same source operands in both runs. -/
theorem rebuild_spoil_asserts
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay)
    (passes : original.SpoilAssertsPass) :
    replay.SpoilAssertsPass := by
  intro row rowMem lhs rhs imm isAssert nonzero
  obtain ⟨i, newAt⟩ := Array.mem_iff_getElem?.mp rowMem
  have oldBound : i < original.rows.size := by
    have replayBound := (getElem?_eq_some_iff.mp newAt).1
    have length := agreement.length
    omega
  let old := original.rows[i]'oldBound
  have oldAt : original.rows[i]? = some old := by simp [old, oldBound]
  have oldMem : old ∈ original.rows :=
    Array.mem_iff_getElem?.mpr ⟨i, oldAt⟩
  obtain ⟨sameIndex, _, _, _, _⟩ := agreement.rows i old row oldAt newAt
  have sameSlot := agreement.slot_eq old row sameIndex
  have oldAssert : original.bytecode[old.rowIndex].instruction =
      .VirtualAssertEQ lhs rhs imm := by
    rw [sameSlot]
    exact isAssert
  have samePre := agreement.assert_pre_same i old row oldAt newAt
    lhs rhs imm isAssert
  calc
    sourceValue lhs row.preState = sourceValue lhs old.preState :=
      (samePre.sourceValue_eq lhs).symm
    _ = sourceValue rhs old.preState := passes old oldMem lhs rhs imm oldAssert nonzero
    _ = sourceValue rhs row.preState := samePre.sourceValue_eq rhs

/-- Honest internal advice uses the state at the start of its source expansion;
the rebuilt run has that state, apart from tape bytes. -/
theorem rebuild_honest_advice
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    ∀ n : Fin replay.rows.size,
      replay.rows[n].someTracerAdvice? =
        honestTracerAdviceAtStepN joltInstance.program replay.rows n := by
  sorry

/-- PR #2109's stable-stall predicate depends on bytecode, row index and nextPC,
all preserved by replay. Pinned to a16z/jolt PR #2109 head d2995380. -/
theorem rebuild_stops
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    ∀ last ∈ replay.rows.back?, last.StableStall := by
  intro last lastMem
  have nonempty : 0 < replay.rows.size := by
    simpa [agreement.length] using original.nonempty
  let index := replay.rows.size - 1
  have oldBound : index < original.rows.size := by
    have length := agreement.length
    dsimp [index]
    omega
  let old := original.rows[index]'oldBound
  have oldAt : original.rows[index]? = some old := by
    simp [old, oldBound]
  have newAt : replay.rows[index]? = some last := by
    simpa [index, Array.back?_eq_getElem?] using lastMem
  have oldLast : old ∈ original.rows.back? := by
    simpa [Array.back?_eq_getElem?, index, agreement.length] using oldAt
  have oldStable := original.stops old oldLast
  obtain ⟨sameIndex, _, sameNextPC, _, _⟩ := agreement.rows index old last oldAt newAt
  have sameSlot := agreement.slot_eq old last sameIndex
  exact (stableStall_iff_of_slot_nextPC old last sameSlot sameNextPC).mp oldStable

/-- The replay has no stable stall before its final row, as in the original. -/
theorem rebuild_runs_until_stop
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    ∀ (i : Nat) (current next : TraceRow replay.bytecode),
      replay.rows[i]? = some current → replay.rows[i + 1]? = some next →
      ¬ current.StableStall := by
  intro i current next currentAt nextAt stable
  have length := agreement.length
  have oldCurrentBound : i < original.rows.size := by
    have replayBound := (getElem?_eq_some_iff.mp currentAt).1
    omega
  have oldNextBound : i + 1 < original.rows.size := by
    have replayBound := (getElem?_eq_some_iff.mp nextAt).1
    omega
  let oldCurrent := original.rows[i]'oldCurrentBound
  let oldNext := original.rows[i + 1]'oldNextBound
  have oldCurrentAt : original.rows[i]? = some oldCurrent := by
    simp [oldCurrent, oldCurrentBound]
  have oldNextAt : original.rows[i + 1]? = some oldNext := by
    simp [oldNext, oldNextBound]
  have oldNoStop := original.runs_until_stop i oldCurrent oldNext
    oldCurrentAt oldNextAt
  obtain ⟨sameIndex, _, sameNextPC, _, _⟩ :=
    agreement.rows i oldCurrent current oldCurrentAt currentAt
  have sameSlot := agreement.slot_eq oldCurrent current sameIndex
  exact oldNoStop ((stableStall_iff_of_slot_nextPC oldCurrent current
    sameSlot sameNextPC).mpr stable)

/-- The replay has at least one row because it has the original row count. -/
theorem rebuild_nonempty
    {joltInstance : JoltInstance SourceInstruction}
    {privateInputs : JoltPrivateInputs}
    (original : UntrustedAnswerTrace joltInstance privateInputs)
    (replay : ValidRun joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun))
    (agreement : RebuildAgreement original.toUntrustedAnswerRun replay) :
    0 < replay.rows.size := by
  simpa [agreement.length] using original.nonempty

/-- Every instance in the relaxed-answer language is in Jolt's language. -/
theorem untrustedAnswerLanguage_implies_inLanguage
    {joltInstance : JoltInstance SourceInstruction}
    (member : UntrustedAnswerLanguage joltInstance) :
    joltInstance.InLanguage := by
  obtain ⟨privateInputs, original, outputs, proverAccepts, spoilAsserts⟩ := member
  obtain ⟨replay, agreement⟩ := rebuild_valid_run original
  let honest : HonestTrace joltInstance
      (rebuiltInputs privateInputs original.toUntrustedAnswerRun) :=
    { toValidRun := replay
      accepted := original.accepted
      valid_inputs := original.valid_inputs
      advice_from_honest_tracer := rebuild_honest_advice original replay agreement
      stops := rebuild_stops original replay agreement
      runs_until_stop := rebuild_runs_until_stop original replay agreement
      nonempty := rebuild_nonempty original replay agreement }
  exact ⟨rebuiltInputs privateInputs original.toUntrustedAnswerRun, honest,
    rebuild_matches_outputs original replay agreement outputs,
    rebuild_prover_config original replay agreement proverAccepts,
    rebuild_spoil_asserts original replay agreement spoilAsserts⟩

end JoltConstraints.Soundness
