        (internal_error "extensions/Zicbom/zicbom_insts.sail" 121 "unimplemented")
      | .CBOP_INVAL_INVAL => (process_clean_inval rs1 CBO_INVAL)
      | .CBOP_INVAL_FLUSH => (process_clean_inval rs1 CBO_FLUSH))

