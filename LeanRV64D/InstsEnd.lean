/-- Type quantifiers: width : Nat, k_ex256249_ : Bool, k_ex256248_ : Bool, List.elem width
  [1, 2, 4, 8, 16] -/
def execute_AMO (op : amoop) (aq : Bool) (rl : Bool) (rs2 : regidx) (rs1 : regidx) (width : Nat) (rd : regidx) : SailM ExecutionResult := SailME.run do
  let width := width
  sail_assert (width ≤b (xlen_bytes *i 2)) "extensions/A/zaamo_insts.sail:73.32-73.33"
  let access := (Atomic (op, Data, Data))
  let vaddr ← (( do
    match (← (ext_data_get_addr rs1 (zeros (n := 64)) access width)) with
    | .Ext_DataAddr_Error e => SailME.throw ((Ext_DataAddr_Check_Failure e) : ExecutionResult)
    | .Ext_DataAddr_OK vaddr => (pure vaddr) ) : SailME ExecutionResult virtaddr )
  if ((not (is_aligned_vaddr vaddr width)) : Bool)
  then (pure (Memory_Exception (vaddr, (E_SAMO_Addr_Align ()))))
  else
    (do
      let addr ← (( do
        match (← (translateAddr vaddr access)) with
        | .Err (e, _) => SailME.throw ((Memory_Exception (vaddr, e)) : ExecutionResult)
        | .Ok (addr, _) => (pure addr) ) : SailME ExecutionResult physaddr )
      let rs2_val ← (( do
        if ((width ≤b xlen_bytes) : Bool)
        then (pure (trunc (m := (width *i 8)) (← (rX_bits rs2))))
        else (pure (trunc (m := (width *i 8)) (← (rX_pair_bits rs2)))) ) : SailME ExecutionResult
        (BitVec (width * 8)) )
      let loaded ← (( do
        match (← (mem_write_ea addr width (aq && rl) rl true)) with
        | .Err e => SailME.throw ((Memory_Exception (vaddr, e)) : ExecutionResult)
        | .Ok _ =>
          (do
            match (← (mem_read access addr width aq (aq && rl) true)) with
            | .Err e => SailME.throw ((Memory_Exception (vaddr, e)) : ExecutionResult)
            | .Ok loaded => (pure loaded)) ) : SailME ExecutionResult (BitVec (width * 8)) )
      let result : (BitVec (width * 8)) :=
        match op with
        | .AMOSWAP => rs2_val
        | .AMOADD => (rs2_val + loaded)
        | .AMOXOR => (rs2_val ^^^ loaded)
        | .AMOAND => (rs2_val &&& loaded)
        | .AMOOR => (rs2_val ||| loaded)
        | .AMOMIN =>
          (if ((zopz0zI_s rs2_val loaded) : Bool)
          then rs2_val
          else loaded)
        | .AMOMAX =>
          (if ((zopz0zK_s rs2_val loaded) : Bool)
          then rs2_val
          else loaded)
        | .AMOMINU =>
          (if ((zopz0zI_u rs2_val loaded) : Bool)
          then rs2_val
          else loaded)
        | .AMOMAXU =>
          (if ((zopz0zK_u rs2_val loaded) : Bool)
          then rs2_val
          else loaded)
        | .AMOCAS => rs2_val
      if ((←((pure (op == AMOCAS)) <&&> (do
           (pure (loaded != (← do
                 if ((width ≤b xlen_bytes) : Bool)
                 then (pure (trunc (m := (width *i 8)) (← (rX_bits rd))))
                 else (pure (trunc (m := (width *i 8)) (← (rX_pair_bits rd)))))))))) : Bool)
      then
        (do
          if ((width ≤b xlen_bytes) : Bool)
          then (wX_bits rd (sign_extend (m := 64) loaded))
          else (wX_pair_bits rd (sign_extend (m := (64 *i 2)) loaded))
          (pure RETIRE_SUCCESS))
      else
        (do
          match (← (mem_write_value addr width (sign_extend (m := (8 *i width)) result) access
              (aq && rl) rl true)) with
          | .Ok true =>
            (do
              if ((width ≤b xlen_bytes) : Bool)
              then (wX_bits rd (sign_extend (m := 64) loaded))
              else (wX_pair_bits rd (sign_extend (m := (64 *i 2)) loaded))
              (pure RETIRE_SUCCESS))
          | .Ok false =>
            (internal_error "extensions/A/zaamo_insts.sail" 133 "AMO got false from mem_write_value")
          | .Err e => (pure (Memory_Exception (vaddr, e)))))

