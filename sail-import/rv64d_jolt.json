// Sail RISC-V configuration for the Jolt zkVM hart.
//
// Derived from upstream config/config.json.in (sail-import/rv64d_v256_e64.json).
// The hart is RV64IMAC with Zca and Zicsr, M-mode only, with no PMP entries,
// no virtual memory and no floating point; see docs/riscv-alignment.md for the
// reasons behind each choice. Memory regions (physical memory attributes),
// the only readable, writable or executable ones:
//   I/O    [0x4000_0000, 0x8000_0000)  Jolt's advice, input, output, panic and
//                                      termination words: read/write, not
//                                      executable, AMOArithmetic, not reservable;
//   RAM    [0x8000_0000, 2^64)         read/write/execute, AMOArithmetic,
//                                      RsrvEventual.
// The CLINT (platform.clint) is outside both regions, so every access to it
// faults, as every access to it panics in Jolt.
// LR/SC: an SC succeeds only at the LR's exact address and when no wider than
// the LR (platform.reservation).
{
  "base": {
    "xlen": 64,
    "E": false,
    "writable_misa": false,
    "writable_fiom": false,
    "writable_hpm_counters": {
      "len": 32,
      "value": "0x0"
    },
    "scounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    "xtval_nonzero": {
      "illegal_instruction": true,
      "software_breakpoint": true,
      "hardware_breakpoint": true,
      "load_address_misaligned": true,
      "load_access_fault": true,
      "load_page_fault": true,
      "samo_address_misaligned": true,
      "samo_access_fault": true,
      "samo_page_fault": true,
      "fetch_address_misaligned": true,
      "fetch_access_fault": true,
      "fetch_page_fault": true,
      "software_check": true,
      "reserved_exceptions": false
    },
    "reserved_behavior": {
      "amocas_odd_register": "AMOCAS_Illegal",
      "fcsr_rm": "Fcsr_RM_Illegal",
      "pmpcfg_write_only": "PMP_ClearPermissions",
      "xenvcfg_cbie": "Xenvcfg_ClearPermissions",
      "xtvec_mode": "Xtvec_Ignore",
      "rv32zdinx_odd_register": "Zdinx_Illegal"
    },
    "mstatus": {
      "fs_legal_states": "ExtContext_Off"
    }
  },
  "memory": {
    "pmp": {
      "grain": 0,
      "count": 0,
      "usable_count": 0,
      "tor_supported": true,
      "na4_supported": true,
      "napot_supported": true
    },
    "misaligned": {
      "supported": false,
      "allowed_within_exp": 0,
      "byte_by_byte": false,
      "order_decreasing": false
    },
    "translation": {
      "dirty_update": false
    },
    "dtb_address": {
      "len": 64,
      "value": "0x0"
    },
    "regions": [
      {
        "base": {
          "len": 64,
          "value": "0x40000000"
        },
        "size": {
          "len": 64,
          "value": "0x40000000"
        },
        "attributes": {
          "cacheable": false,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_fault": "AlignmentFault",
          "atomic_support": "AMOArithmetic",
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      {
        "base": {
          "len": 64,
          "value": "0x80000000"
        },
        "size": {
          "len": 64,
          "value": "0xFFFFFFFF80000000"
        },
        "attributes": {
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_fault": "NoFault",
          "atomic_support": "AMOArithmetic",
          "reservability": "RsrvEventual",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": true
      }
    ]
  },
  "platform": {
