diff --git a/model/sys/sys_reservation.sail b/model/sys/sys_reservation.sail
index cba2540..86973bb 100644
--- a/model/sys/sys_reservation.sail
+++ b/model/sys/sys_reservation.sail
@@ -8,16 +8,62 @@
 
 // Reservation handling for LR/SC.
 //
-// The reservation state is maintained external to the model since the
-// reservation behavior is platform-specific anyway and maintaining
-// this state outside the model simplifies the concurrency analysis.
+// The reservation is held in model registers, so that backends without an
+// external platform (such as the Lean backend) have a concrete reservation
+// policy instead of uninterpreted functions.  The policy is chosen by the
+// platform options in platform_config.sail:
 //
-// These are externs are defined here in the system module since
-// we currently perform reservation cancellation on privilege level
-// transition.  Ideally, the platform should get more visibility into
-// where cancellation can be performed.
+// - An LR records one reservation: the physical address it read and its
+//   width in bytes.
+// - The reservation set is the naturally aligned 2^plat_reservation_set_size_exp
+//   bytes containing that address, unless plat_reservation_require_exact_addr_match
+//   is set, in which case an SC must use exactly the LR's address.
+// - If plat_reservation_require_width_within is set, an SC must also be no
+//   wider than the LR, so that the bytes it writes lie inside the bytes the LR
+//   read.
+// - Every SC that does not raise an exception cancels the reservation (see
+//   the STORECON execute clause), as does reset.  xRET cancels it only if
+//   plat_reservation_invalidate_on_xret is set.
+//
+// - Cancelling clears all three registers back to their reset values.
+//
+// All of these are choices the Zalrsc specification permits for a single hart.
+
+register reservation_valid : bool = false
+register reservation_addr : physaddrbits = zeros()
+register reservation_width : int = 0
+
+val load_reservation : forall 'n, 0 < 'n < max_mem_access . (/* addr */ physaddrbits, /* width */ int('n)) -> unit
+function load_reservation(addr, width) = {
+  reservation_valid = true;
+  reservation_addr = addr;
+  reservation_width = width
+}
+
+val reservation_set_mask : unit -> physaddrbits
+function reservation_set_mask() =
+  ~(zero_extend(ones(plat_reservation_set_size_exp)))
+
+val match_reservation : forall 'n, 0 < 'n < max_mem_access . (/* addr */ physaddrbits, /* width */ int('n)) -> bool
+function match_reservation(addr, width) = {
+  let addr_match : bool =
+    if plat_reservation_require_exact_addr_match
+    then addr == reservation_addr
+    else (addr & reservation_set_mask()) == (reservation_addr & reservation_set_mask());
+  let width_match : bool =
+    not(plat_reservation_require_width_within) | width <= reservation_width;
+  reservation_valid & addr_match & width_match
+}
+
+val cancel_reservation : unit -> unit
+function cancel_reservation() = {
+  reservation_valid = false;
+  // The address and width are read only together with reservation_valid, so
+  // clearing them changes no behaviour; it gives "no reservation" a single
+  // representation, the reset value of the three registers.
+  reservation_addr = zeros();
+  reservation_width = 0
+}
 
-val load_reservation = impure {interpreter: "Platform.load_reservation", cpp: "load_reservation", c: "load_reservation", lem: "load_reservation"} : forall 'n, 0 < 'n < max_mem_access . (/* addr */ physaddrbits, /* width */ int('n)) -> unit
